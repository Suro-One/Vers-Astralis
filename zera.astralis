# =====================================================================
# SMOOTH ANTI-ALIASED ROUNDED RECT RENDERING
# supersample at N x, draw crisp, smoothscale down -> soft/AA edges, "as clear as
# clear-text" per request. Cache keyed on the exact draw params.
# =====================================================================
_AA_CACHE: Dict[tuple, pygame.Surface] = {}
_AA_SCALE = 4

def draw_round_rect(surface, color, rect, radius=8, width=0, aa_scale=_AA_SCALE):
    rect = pygame.Rect(rect)
    if rect.width <= 0 or rect.height <= 0:
        return
    key = (rect.width, rect.height, radius, width, tuple(color) if len(color) in (3, 4) else color)
    temp = _AA_CACHE.get(key)
    if temp is None:
        w, h = max(1, rect.width * aa_scale), max(1, rect.height * aa_scale)
        temp = pygame.Surface((w, h), pygame.SRCALPHA)
        pygame.draw.rect(temp, color, temp.get_rect(),
                          border_radius=int(radius * aa_scale),
                          width=int(width * aa_scale))
        temp = pygame.transform.smoothscale(temp, (rect.width, rect.height))
        if len(_AA_CACHE) > 500:
            _AA_CACHE.pop(next(iter(_AA_CACHE)))  # LRU-light: evict oldest single entry instead of nuking the whole cache
        _AA_CACHE[key] = temp
    surface.blit(temp, rect.topleft)


def draw_round_rect_glow(surface, color, rect, radius=8, glow_alpha=40):
    """Subtle soft outer glow for focused/hovered elements -- smooths perceived edges further."""
    r = pygame.Rect(rect).inflate(6, 6)
    glow = pygame.Surface((r.width * _AA_SCALE, r.height * _AA_SCALE), pygame.SRCALPHA)
    c = (color[0], color[1], color[2], glow_alpha)
    pygame.draw.rect(glow, c, glow.get_rect(), border_radius=int((radius + 3) * _AA_SCALE))
    glow = pygame.transform.smoothscale(glow, (r.width, r.height))
    surface.blit(glow, r.topleft)


def draw_vertical_gradient(surface, rect, top, bottom, radius=0):
    rect = pygame.Rect(rect)
    if rect.width <= 0 or rect.height <= 0:
        return
    layer = pygame.Surface(rect.size, pygame.SRCALPHA)
    ta, ba = (top[3] if len(top) > 3 else 255), (bottom[3] if len(bottom) > 3 else 255)
    for y in range(rect.height):
        q = y / max(1, rect.height - 1)
        rgb = tuple(int(top[i] * (1 - q) + bottom[i] * q) for i in range(3))
        pygame.draw.line(layer, (*rgb, int(ta * (1 - q) + ba * q)), (0, y), (rect.width, y))
    if radius:
        mask = pygame.Surface(rect.size, pygame.SRCALPHA)
        pygame.draw.rect(mask, (255, 255, 255), mask.get_rect(), border_radius=radius)
        layer.blit(mask, (0, 0), special_flags=pygame.BLEND_RGBA_MULT)
    surface.blit(layer, rect.topleft)


# =====================================================================
# FROSTED GLASS + AURORA (item 19)
# Opaque iPhone-style frosted panels with a subtle, contained, slowly
# color-shifting aurora glow: rendered procedurally at low resolution every few
# frames and smooth-scaled (soft + anti-aliased), so it costs almost nothing.
# =====================================================================
_AURORA_CACHE = {"t": -1.0, "surf": None, "size": (0, 0)}

def _aurora_surface(size, t):
    key_t = int(t * 2)   # refresh ~2x/sec -> smooth color drift, negligible cost
    if (_AURORA_CACHE["surf"] is not None and _AURORA_CACHE["t"] == key_t
            and _AURORA_CACHE["size"] == size):
        return _AURORA_CACHE["surf"]
    lw, lh = 96, 60
    lo = pygame.Surface((lw, lh), pygame.SRCALPHA)
    blobs = [
        (0.5 + 0.4 * math.sin(t * 0.13), 0.30, (0, 229, 212), 22),
        (0.5 + 0.4 * math.sin(t * 0.09 + 2.1), 0.65, (170, 120, 240), 18),
        (0.5 + 0.4 * math.sin(t * 0.11 + 4.2), 0.45, (86, 170, 255), 14),
    ]
    for fx, fy, col, alpha in blobs:
        cx, cy = int(fx * lw), int(fy * lh)
        for r, a in ((34, alpha), (22, alpha + 6), (12, alpha + 12)):
            pygame.draw.circle(lo, (*col, a), (cx, cy), r)
    surf = pygame.transform.smoothscale(lo, size)
    _AURORA_CACHE.update(t=key_t, surf=surf, size=size)
    return surf


def draw_glass_panel(surface, rect, radius=12, border_col=None, aurora=True):
    """Layered translucent glass with spectral tint, sheen, glow and crisp rim."""
    rect = pygame.Rect(rect)
    draw_round_rect_glow(surface, COLORS["purple"], rect, radius, glow_alpha=12)
    draw_round_rect(surface, COLORS["panel"], rect, radius)
    if aurora and rect.width > 8 and rect.height > 8:
        prev = surface.get_clip()
        surface.set_clip(rect.inflate(-2, -2))
        surface.blit(_aurora_surface((rect.width, rect.height), time.time()), rect.topleft)
        surface.set_clip(prev)
    draw_vertical_gradient(surface, pygame.Rect(rect.x + 1, rect.y + 1, rect.width - 2,
                                                 min(34, rect.height - 2)),
                           (255, 255, 255, 24), (118, 140, 255, 0), max(1, radius - 1))
    draw_round_rect(surface, border_col or COLORS["border"], rect, radius, width=1)
    if rect.width > 28:
        # Replace single-pixel aaline with a smooth anti-aliased thin rectangle
        top_line_rect = pygame.Rect(rect.x + radius, rect.y + 1, rect.width - 2 * radius, 2)
        draw_round_rect(surface, (235, 238, 255, 20), top_line_rect, radius=1)


class OrbField:
    """DVD-style bouncing balls background (smooth edges, limited size).
    Replaces the previous large pixelated orbs with small PNG balls that bounce
    around the screen without leaving it. Physics are simple elastic reflections.
    """
    class _Ball:
        def __init__(self, img, x, y, vx, vy, size):
            self.img = img
            self.x = x
            self.y = y
            self.vx = vx
            self.vy = vy
            self.size = size

        def step(self, w, h, dt):
            self.x += self.vx * dt
            self.y += self.vy * dt
            r = self.size / 2
            bounced = False
            if self.x - r < 0:
                self.x = r
                self.vx = abs(self.vx)
                bounced = True
            if self.x + r > w:
                self.x = w - r
                self.vx = -abs(self.vx)
                bounced = True
            if self.y - r < 0:
                self.y = r
                self.vy = abs(self.vy)
                bounced = True
            if self.y + r > h:
                self.y = h - r
                self.vy = -abs(self.vy)
                bounced = True
            return bounced

        def draw(self, surf):
            if self.img is not None:
                scaled = pygame.transform.smoothscale(self.img, (self.size, self.size))
                surf.blit(scaled, (int(self.x - self.size / 2), int(self.y - self.size / 2)))
            else:
                s = pygame.Surface((self.size, self.size), pygame.SRCALPHA)
                pygame.draw.circle(s, (120, 200, 255, 220), (self.size // 2, self.size // 2), self.size // 2)
                surf.blit(s, (int(self.x - self.size / 2), int(self.y - self.size / 2)))

    def __init__(self, n_balls=6, min_speed=140, max_speed=260):
        base_dir = os.path.dirname(os.path.abspath(__file__))
        asset_dir = os.path.join(base_dir, "ui")
        ball_paths = sorted(glob.glob(os.path.join(asset_dir, "ball_*.png")))
        self.ball_images = []
        for path in ball_paths:
            try:
                img = pygame.image.load(path).convert_alpha()
                self.ball_images.append(img)
            except Exception:
                pass
        self.balls: List["OrbField._Ball"] = []
        import random
        for i in range(n_balls):
            img = self.ball_images[i % len(self.ball_images)] if self.ball_images else None
            size = int(48 + (i % 3) * 12)
            x = 200 + i * 120
            y = 180 + (i % 4) * 70
            angle = random.uniform(0, math.pi * 2)
            speed = random.uniform(min_speed, max_speed)
            vx = math.cos(angle) * speed
            vy = math.sin(angle) * speed
            self.balls.append(self._Ball(img, x, y, vx, vy, size))

    def _draw_background(self, surface, w, h):
        # Gentle vertical gradient background only; no massive blobs.
        draw_vertical_gradient(surface, (0, 0, w, h), (5, 7, 29), (24, 9, 42))

    def draw(self, surface, size, t, dt=1/60.0):
        w, h = size
        self._draw_background(surface, w, h)
        for b in self.balls:
            b.step(w, h, dt)
            b.draw(surface)


class WindowChrome:
    """Frameless Windows controls with native drag/resize and safe no-op fallback."""
    TITLE_H = 42

    def __init__(self):
        self.maximized = False
        self.buttons = {}
        self._hwnd = None
        self.refresh_handle()

    def refresh_handle(self):
        try:
            self._hwnd = pygame.display.get_wm_info().get("window")
            if sys.platform == "win32" and self._hwnd:
                import ctypes
                user32 = ctypes.windll.user32
                ex = user32.GetWindowLongW(self._hwnd, -20)
                user32.SetWindowLongW(self._hwnd, -20, ex | 0x00080000)
                user32.SetLayeredWindowAttributes(self._hwnd, 0, 242, 0x2)
        except Exception:
            self._hwnd = None

    def _show(self, command):
        if sys.platform == "win32" and self._hwnd:
            try:
                import ctypes
                ctypes.windll.user32.ShowWindow(self._hwnd, command)
            except Exception:
                pass

    def _native_caption(self, hit):
        if sys.platform != "win32" or not self._hwnd:
            return False
        try:
            import ctypes
            ctypes.windll.user32.ReleaseCapture()
            ctypes.windll.user32.SendMessageW(self._hwnd, 0x00A1, hit, 0)
            return True
        except Exception:
            return False

    def update_rects(self, width):
        size, gap, right = 28, 7, width - 12
        self.buttons = {
            "close": pygame.Rect(right - size, 7, size, size),
            "max": pygame.Rect(right - 2 * size - gap, 7, size, size),
            "min": pygame.Rect(right - 3 * size - 2 * gap, 7, size, size),
        }

    def handle_event(self, event, size):
        self.update_rects(size[0])
        if event.type != pygame.MOUSEBUTTONDOWN or event.button != 1:
            return False
        x, y = event.pos
        if self.buttons["close"].collidepoint(event.pos):
            pygame.event.post(pygame.event.Event(pygame.QUIT)); return True
        if self.buttons["min"].collidepoint(event.pos):
            self._show(6); return True
        if self.buttons["max"].collidepoint(event.pos):
            self.maximized = not self.maximized
            self._show(3 if self.maximized else 9); return True
        edge = 6
        left, right = x < edge, x >= size[0] - edge
        top, bottom = y < edge, y >= size[1] - edge
        hit = (13 if left and top else 14 if right and top else 16 if left and bottom else
               17 if right and bottom else 10 if left else 11 if right else 12 if top else 15 if bottom else 0)
        if hit:
            return self._native_caption(hit)
        return self._native_caption(2) if y < self.TITLE_H else False

    def draw(self, surface, font, font_small, stats):
        self.update_rects(surface.get_width())
        bar = pygame.Rect(7, 5, surface.get_width() - 14, self.TITLE_H - 5)
        draw_glass_panel(surface, bar, 14, aurora=False)
        pygame.draw.circle(surface, COLORS["cyan"], (27, 23), 8, 2)
        pygame.draw.circle(surface, COLORS["pink"], (27, 23), 3)
        surface.blit(font.render("AURA  ::  ASTRALIS", True, COLORS["text"]), (43, 12))
        # Support multiline stats to avoid UI text overlap (stack lines vertically)
        max_right = self.buttons["min"].x - 18
        if isinstance(stats, str) and "\n" in stats:
            lines = stats.split("\n")
        else:
            lines = [str(stats)]
        rendered = [font_small.render(line, True, COLORS["good"]) for line in lines]
        max_w = max((r.get_width() for r in rendered), default=0)
        x = max(280, max_right - max_w)
        y = 10
        for r in rendered:
            surface.blit(r, (x, y))
            y += r.get_height() + 2
        mouse = pygame.mouse.get_pos()
        for name, rect in self.buttons.items():
            hov = rect.collidepoint(mouse)
            col = COLORS["danger"] if name == "close" else COLORS["accent"]
            if hov:
                draw_round_rect_glow(surface, col, rect, 9, 45)
            draw_round_rect(surface, (55, 42, 91, 190) if hov else (18, 22, 55, 160), rect, 9)
            draw_round_rect(surface, col if hov else COLORS["border"], rect, 9, width=1)
            cx, cy = rect.center
            if name == "min":
                pygame.draw.aaline(surface, COLORS["text"], (cx - 5, cy + 3), (cx + 5, cy + 3))
            elif name == "max":
                pygame.draw.rect(surface, COLORS["text"], (cx - 5, cy - 5, 10, 10), 1)
            else:
                pygame.draw.aaline(surface, COLORS["text"], (cx - 4, cy - 4), (cx + 4, cy + 4))
                pygame.draw.aaline(surface, COLORS["text"], (cx + 4, cy - 4), (cx - 4, cy + 4))


# =====================================================================
# LINE CHARTS (item 20)
# =====================================================================
def _smooth_series(values, alpha=0.25):
    out, s = [], None
    for v in values:
        s = v if s is None else alpha * v + (1 - alpha) * s
        out.append(s)
    return out


def draw_line_chart(surface, rect, series, color, min_v=None, max_v=None,
                    dotted=False, width=1):
    """Grid, area fill, and crisp anti-aliased data line."""
    rect = pygame.Rect(rect)
    if len(series) < 2 or rect.width < 4 or rect.height < 4:
        return
    lo = min(series) if min_v is None else min_v
    hi = max(series) if max_v is None else max_v
    span = max(1e-9, hi - lo)
    n = len(series)
    for i in range(1, 4):
        gy = rect.y + int(i * rect.height / 4)
        pygame.draw.aaline(surface, (70, 78, 118), (rect.x, gy), (rect.right, gy))
    pts = []
    for i, v in enumerate(series):
        x = rect.x + int(i * (rect.width - 1) / max(1, n - 1))
        y = rect.bottom - 1 - int((v - lo) / span * (rect.height - 2))
        pts.append((x, y))
    if not dotted:
        area = pygame.Surface(rect.size, pygame.SRCALPHA)
        local = [(x - rect.x, y - rect.y) for x, y in pts]
        pygame.draw.polygon(area, (*color[:3], 32), local + [(rect.width, rect.height), (0, rect.height)])
        surface.blit(area, rect.topleft)
    for i in range(len(pts) - 1):
        if dotted and i % 2 == 1:
            continue
        pygame.draw.aaline(surface, color, pts[i], pts[i + 1])
        if not dotted and width > 1:
            pygame.draw.line(surface, (*color[:3], 160), pts[i], pts[i + 1], width)
    if not dotted:
        pygame.draw.circle(surface, color, pts[-1], 2)
        pygame.draw.circle(surface, COLORS["text"], pts[-1], 1)


def project_series(series, n_future=20, fit_window=30):
    """Linear extrapolation of the smoothed tail -> predicted future values."""
    if len(series) < 4:
        return []
    tail = series[-min(fit_window, len(series)):]
    n = len(tail)
    xs = list(range(n))
    mx, my = sum(xs) / n, sum(tail) / n
    denom = sum((x - mx) ** 2 for x in xs) or 1e-9
    slope = sum((xs[i] - mx) * (tail[i] - my) for i in range(n)) / denom
    last = tail[-1]
    return [max(0.0, last + slope * (i + 1)) for i in range(n_future)]


# =====================================================================
# TEXT SANITIZATION / EMOJI SUPPORT
# We keep printable text + emoji ranges + whitespace. Pygame's SysFont often can't
# *render* emoji glyphs depending on OS font fallback, but we must not strip them:
# stripping would silently corrupt what the user typed. We keep them in the string;
# draw-time falls back to a placeholder glyph box only if the font truly can't shape it,
# which pygame handles internally (tofu box) -- better than data loss.
# =====================================================================
def _is_emoji_or_symbol(ch: str) -> bool:
    cp = ord(ch)
    ranges = [
        (0x1F300, 0x1FAFF), (0x2600, 0x27BF), (0x1F1E6, 0x1F1FF),
        (0x2190, 0x21FF), (0x2B00, 0x2BFF), (0xFE0F, 0xFE0F), (0x200D, 0x200D),
    ]
    return any(lo <= cp <= hi for lo, hi in ranges)


def _sanitize(txt: str) -> str:
    out = []
    for c in (txt or ""):
        if c in "\t\n\r" or ord(c) >= 32 or _is_emoji_or_symbol(c):
            out.append(c)
    return "".join(out)


# =====================================================================
# EMOJI-AWARE TEXT RENDERING
# SysFonts (Segoe UI, Cascadia, etc.) cannot render emoji glyphs, producing a tofu
# block. This helper splits each string into runs of regular vs emoji characters and
# renders each run with the appropriate font.
# =====================================================================
def _render_emoji_text(surf, pos, text, font, color, emoji_font=None):
    """Render text with emoji fallback. Splits into homogenous runs so each
    segment is rendered with the font that can actually shape it."""
    if not text:
        return 0
    if emoji_font is None:
        rendered = font.render(text, True, color)
        surf.blit(rendered, pos)
        return rendered.get_width()
    x, y = pos
    runs: List[Tuple[bool, str]] = []
    if not text:
        return 0
    cur_emoji = _is_emoji_or_symbol(text[0])
    cur_start = 0
    for i, ch in enumerate(text):
        is_emo = _is_emoji_or_symbol(ch)
        if is_emo != cur_emoji:
            runs.append((cur_emoji, text[cur_start:i]))
            cur_emoji = is_emo
            cur_start = i
    runs.append((cur_emoji, text[cur_start:]))
    total_w = 0
    for is_emo, seg in runs:
        try:
            fnt = emoji_font if is_emo else font
            rendered = fnt.render(seg, True, color)
            surf.blit(rendered, (x + total_w, y))
            total_w += rendered.get_width()
        except:
            print("Zero width text output detected, skipping...")
    return total_w


# =====================================================================
# TOKENIZER
# =====================================================================
class TiktokenCodec:
    def __init__(self, encoding_name: str = "cl100k_base"):
        self.encoding_name = encoding_name
        self._enc = None
        self.mode = "byte"
        self.vocab_size = 256
        if HAS_TIKTOKEN:
            try:
                self._enc = tiktoken.get_encoding(encoding_name)
                self.vocab_size = self._enc.n_vocab
                self.mode = "tiktoken"
            except Exception as e:
                print(f"[TOKENIZER] failed to load '{encoding_name}': {e}. Byte fallback.")

    def __getstate__(self):
        return {"encoding_name": self.encoding_name}

    def __setstate__(self, state):
        self.__init__(state["encoding_name"])

    def encode(self, text: str):
        if self.mode == "tiktoken":
            return self._enc.encode(text, allowed_special="all")
        return list(text.encode("utf-8", errors="ignore"))

    def decode(self, ids) -> str:
        # FIX: o200k_base (and similar) have numeric gaps in the vocab range that are
        # valid logit indices (vocab_size = n_vocab) but are not assigned tokens.
        # tiktoken.decode() raises "Invalid token for decoding" on them. Skip silently
        # so generation never crashes on a sampled gap ID.
        if self.mode != "tiktoken" or self._enc is None:
            return bytes([t % 256 for t in ids]).decode("utf-8", errors="replace")
        try:
            return self._enc.decode(ids)
        except Exception:
            out = []
            for i in ids:
                try:
                    out.append(self._enc.decode([int(i)]))
                except Exception:
                    continue  # drop invalid / unassigned token IDs
            return "".join(out)


# --------------------------------------------------------------------
# Character-level codec (dynamic, extensible)
# --------------------------------------------------------------------
class CharCodec:
    """Simple character-level tokenizer that maps each Unicode char to an id.
    The codec is extensible: calling `extend_with_text(text)` will add any new
    characters encountered (useful when retraining on new corpora).
    """
    def __init__(self, name: str = "char"):
        self.encoding_name = name
        self.mode = "char"
        # start with a small core set (ASCII printable + newline + tab)
        base_chars = [chr(i) for i in range(32, 127)] + ["\n", "\t"]
        # ensure uniqueness and deterministic ordering
        seen = []
        for c in base_chars:
            if c not in seen:
                seen.append(c)
        self.id_to_char = list(seen)
        self.char_to_id = {c: i for i, c in enumerate(self.id_to_char)}

    def __getstate__(self):
        return {"id_to_char": self.id_to_char, "encoding_name": self.encoding_name}

    def __setstate__(self, state):
        self.encoding_name = state.get("encoding_name", "char")
        self.id_to_char = state.get("id_to_char", [])
        self.char_to_id = {c: i for i, c in enumerate(self.id_to_char)}

    @property
    def vocab_size(self) -> int:
        return len(self.id_to_char)

    def encode(self, text: str):
        out = []
        for ch in text:
            if ch not in self.char_to_id:
                # unknown chars are added lazily (caller should call extend_with_text
                # prior to training to expand the model); here we map unknown -> replacement
                out.append(self.char_to_id.get("?", 0))
            else:
                out.append(self.char_to_id[ch])
        return out

    def decode(self, ids) -> str:
        return "".join(self.id_to_char[i] if 0 <= i < len(self.id_to_char) else "?" for i in ids)

    def extend_with_text(self, text: str) -> int:
        """Add any characters in `text` that are not already known.
        Returns number of new characters added."""
        added = 0
        for ch in text:
            if ch not in self.char_to_id:
                self.char_to_id[ch] = len(self.id_to_char)
                self.id_to_char.append(ch)
                added += 1
        return added


# =====================================================================
# GGUF UNIGRAM TOKENIZER (SentencePiece-style, built from GGUF metadata)
# Root-cause fix for "garbled text after GGUF conversion": the old path
# bilinearly interpolated the source embedding table onto the tiktoken
# vocab, so token IDs produced by the model decoded through the WRONG
# vocabulary. This codec uses the GGUF's own vocab (unigram scores ->
# Viterbi segmentation; byte tokens -> raw bytes), so IDs round-trip
# exactly like the source model's tokenizer.
# =====================================================================
_SPIECE_UNDERLINE = "\u2581"


class GGUFUnigramCodec:
    TYPE_NORMAL, TYPE_UNKNOWN, TYPE_CONTROL = 1, 2, 3
    TYPE_USER, TYPE_UNUSED, TYPE_BYTE = 4, 5, 6

    def __init__(self, tokens, scores, types, arch: str = ""):
        self.tokens = [str(t) for t in tokens]
        self.scores = [float(s) for s in scores]
        self.types = [int(t) for t in types]
        self.arch = arch or ""
        self.encoding_name = f"gguf:{self.arch}" if self.arch else "gguf:unigram"
        self.mode = "gguf"
        self.vocab_size = len(self.tokens)
        self.bos_id = self._find_special("<bos>")
        self.unk_id = self._find_special("<unk>")
        self.eos_ids = [i for i in (self._find_special("<eos>"),
                                    self._find_special("<end_of_turn>")) if i is not None]
        # Merge table for llama.cpp-style score-ranked BPE. GGUF 'scores' for
        # bpe/"llama" vocabs are NOT unigram log-probs -- they are merge ranks
        # (0,-1,-2,...; higher = earlier merge; single chars sit at huge
        # negative ranks so they only survive when nothing merges across them).
        self._norm: Dict[str, Tuple[float, int]] = {}
        for i, (tok, ty) in enumerate(zip(self.tokens, self.types)):
            if ty == self.TYPE_NORMAL and tok:
                self._norm[tok] = (self.scores[i], i)
        # literal specials recognised inside raw text (chat templates)
        self._specials = sorted(
            ((t, i) for i, (t, ty) in enumerate(zip(self.tokens, self.types))
             if ty in (self.TYPE_CONTROL, self.TYPE_USER) and t.startswith("<") and len(t) > 2),
            key=lambda x: -len(x[0]))
        self._special_map = dict(self._specials)
        self._special_re = (re.compile("(" + "|".join(re.escape(t) for t, _ in self._specials) + ")")
                            if self._specials else None)
        self._byte_ids: Dict[int, int] = {}
        for i, (tok, ty) in enumerate(zip(self.tokens, self.types)):
            if ty == self.TYPE_BYTE:
                b = self._byte_from_token(tok)
                if b is not None:
                    self._byte_ids[b] = i

    def _find_special(self, text: str) -> Optional[int]:
        for i, t in enumerate(self.tokens):
            if t == text:
                return i
        return None

    @staticmethod
    def _byte_from_token(tok: str) -> Optional[int]:
        # llama.cpp byte tokens look like "<0x0A>"
        if len(tok) == 6 and tok.startswith("<0x") and tok.endswith(">"):
            try:
                return int(tok[3:5], 16)
            except ValueError:
                return None
        return None

    # ---- encode: split out literal specials, then score-ranked BPE ----
    def encode(self, text: str):
        if not text:
            return []
        parts = (self._special_re.split(text) if self._special_re is not None else [text])
        ids: List[int] = []
        first_plain = True
        for part in parts:
            if not part:
                continue
            if part in self._special_map:
                ids.append(self._special_map[part])
                first_plain = False
                continue
            seg = part.replace(" ", _SPIECE_UNDERLINE).replace("\t", _SPIECE_UNDERLINE)
            if first_plain and seg and not seg.startswith(_SPIECE_UNDERLINE):
                seg = _SPIECE_UNDERLINE + seg   # sentencepiece dummy prefix
            first_plain = False
            ids.extend(self._bpe(seg))
        return ids

    def _bpe(self, s: str):
        """Greedy best-pair merging over a linked list with a lazy max-heap:
        O(n log n) for n initial chars (Viterbi over 262k entries was both
        wrong for rank-scores and far too slow on corpus-scale text)."""
        n = len(s)
        if n == 0:
            return []
        import heapq
        toks = list(s)
        nxt = list(range(1, n)) + [-1]
        prv = [-1] + list(range(n - 1))
        alive = [True] * n
        norm = self._norm
        heap: List[Tuple[float, int, int]] = []

        def push(i, j):
            if i == -1 or j == -1:
                return
            e = norm.get(toks[i] + toks[j])
            if e is not None:
                heapq.heappush(heap, (-e[0], i, j))   # max-heap on score

        for i in range(n - 1):
            push(i, i + 1)
        while heap:
            neg_sc, i, j = heapq.heappop(heap)
            if not alive[i] or not alive[j] or nxt[i] != j:
                continue   # stale heap entry
            toks[i] = toks[i] + toks[j]
            alive[j] = False
            nj = nxt[j]
            nxt[i] = nj
            if nj != -1:
                prv[nj] = i
            push(prv[i], i)
            push(i, nxt[i])
        unk_fallback = self.unk_id if self.unk_id is not None else 0
        ids: List[int] = []
        for i in range(n):
            if not alive[i]:
                continue
            tok = toks[i]
            e = norm.get(tok)
            if e is not None:
                ids.append(e[1])
                continue
            # unknown symbol: byte fallback (gemma has <0xNN> byte tokens), else <unk>
            emitted = False
            for b in tok.encode("utf-8"):
                bid = self._byte_ids.get(b)
                if bid is not None:
                    ids.append(bid)
                    emitted = True
            if not emitted:
                ids.append(unk_fallback)
        return ids

    def decode(self, ids) -> str:
        buf = bytearray()
        for i in ids:
            i = int(i)
            if i < 0 or i >= self.vocab_size:
                continue
            ty = self.types[i]
            if ty in (self.TYPE_CONTROL, self.TYPE_USER, self.TYPE_UNUSED, self.TYPE_UNKNOWN):
                continue
            if ty == self.TYPE_BYTE:
                b = self._byte_from_token(self.tokens[i])
                if b is not None:
                    buf.append(b)
                continue
            buf += self.tokens[i].replace(_SPIECE_UNDERLINE, " ").encode("utf-8", errors="ignore")
        return buf.decode("utf-8", errors="replace")

    # ---- checkpoint portability ----
    def to_blob(self) -> dict:
        return {"tokens": self.tokens, "scores": self.scores,
                "types": self.types, "arch": self.arch}

    @classmethod
    def from_blob(cls, blob: dict) -> "GGUFUnigramCodec":
        return cls(blob["tokens"], blob["scores"], blob["types"], arch=blob.get("arch", ""))


def read_gguf_metadata(path: str, log=print) -> Tuple[Dict[str, Any], Optional[GGUFUnigramCodec]]:
    """Read architecture dims + tokenizer from a GGUF file. This is what makes
    'how large does the model need to be' a non-question: the conversion reads
    the answer straight out of the file."""
    import gguf as _gguf
    reader = _gguf.GGUFReader(path, mode="r")

    def val(name, default=None):
        f = reader.fields.get(name)
        if f is None:
            return default
        try:
            return f.contents()
        except Exception:
            return default

    arch = str(val("general.architecture", "") or "")
    meta: Dict[str, Any] = {"arch": arch, "name": str(val("general.name", "") or "")}
    meta["d_model"] = int(val(f"{arch}.embedding_length", 0) or 0)
    meta["n_layers"] = int(val(f"{arch}.block_count", 0) or 0)
    meta["n_heads"] = int(val(f"{arch}.attention.head_count", 0) or 0)
    meta["ff"] = int(val(f"{arch}.feed_forward_length", 0) or 0)
    meta["ctx"] = int(val(f"{arch}.context_length", 0) or 0)
    meta["rope_base"] = float(val(f"{arch}.rope.freq_base", 10000.0) or 10000.0)
    meta["sliding_window"] = int(val(f"{arch}.attention.sliding_window", 0) or 0)
    meta["head_dim"] = int(val(f"{arch}.attention.key_length", 0) or 0)
    meta["n_kv_heads"] = int(val(f"{arch}.attention.head_count_kv", 0) or 0)

    codec = None
    # Try multiple known GGUF tokenizer field patterns to support many toolchains
    tok_field_candidates = [
        "tokenizer.ggml.tokens",
        "tokenizer.spm.tokens",
        "tokenizer.tokens",
        "tokenizer.vocab.tokens",
        "tokenizer.mmap.tokens",
        "tokenizer.ggml.vocab",
    ]
    for cand in tok_field_candidates:
        tok_f = reader.fields.get(cand)
        if tok_f is None:
            continue
        try:
            tokens = list(tok_f.contents())
            # try several possible companion fields for scores/types
            sc_f = reader.fields.get(cand.replace("tokens", "scores")) or reader.fields.get("tokenizer.ggml.scores")
            ty_f = reader.fields.get(cand.replace("tokens", "token_type")) or reader.fields.get("tokenizer.ggml.token_type")
            scores = list(sc_f.contents()) if sc_f is not None else [0.0] * len(tokens)
            types = list(ty_f.contents()) if ty_f is not None else [1] * len(tokens)
            codec = GGUFUnigramCodec(tokens, scores, types, arch=arch)
            log(f"[GGUF] tokenizer: {len(tokens):,} tokens (unigram, arch={arch or '?'}, field={cand})")
            break
        except Exception as e:
            log(f"[GGUF] tokenizer read failed for {cand} ({e}); trying next")
    # Generic fallback: scan fields for anything that looks like a token list
    if codec is None:
        for name, field in reader.fields.items():
            if "token" in name and name.endswith(".tokens"):
                try:
                    tokens = list(field.contents())
                    scores = []
                    types = []
                    # try to find associated scores/token_type
                    sc = reader.fields.get(name.replace(".tokens", ".scores"))
                    ty = reader.fields.get(name.replace(".tokens", ".token_type"))
                    scores = list(sc.contents()) if sc is not None else [0.0] * len(tokens)
                    types = list(ty.contents()) if ty is not None else [1] * len(tokens)
                    codec = GGUFUnigramCodec(tokens, scores, types, arch=arch)
                    log(f"[GGUF] tokenizer: {len(tokens):,} tokens (unigram, inferred field={name})")
                    break
                except Exception:
                    continue
    return meta, codec


# =====================================================================
# LOGGER
# =====================================================================
class ConsoleLogger:
    def __init__(self, max_lines=1000):
        self.lines: List[str] = []
        self.max_lines = max_lines
        self.lock = threading.Lock()

    def log(self, text):
        msg = f"{time.strftime('[%H:%M:%S]')} {text}"
        with self.lock:
            self.lines.append(msg)
            if len(self.lines) > self.max_lines:
                self.lines.pop(0)
        print(msg)

    def get_lines(self):
        with self.lock:
            return list(self.lines)

GLOBAL_LOGGER = ConsoleLogger()


# =====================================================================
# RESOURCE MONITOR
# Bugfix (per request): old monitor's "delta" was frame-to-frame (previous poll vs
# current poll), which is nearly always ~0 and never reflects "how much this app is
# using since a real reference point." Correct semantics: capture ONE baseline at the
# moment the process is idle right after boot ("zero state"), then always report
# current-usage-minus-that-fixed-baseline. Values only start rendering once a model
# load or training run has begun, per request; polled every 0.5s.
# =====================================================================
class ResourceMonitor(threading.Thread):
    """Accurate memory telemetry (fix C9).
    The old monitor read only torch.cuda.memory_allocated(), which counts PyTorch
    tensor bytes and NOTHING else -- it misses the CUDA context (~0.3-0.8GB),
    cuBLAS/cuDNN workspaces, bitsandbytes buffers and allocator fragmentation,
    so VRAM was consistently understated.
    Now:
      * process_vram_mb(): true per-process VRAM via NVML when available,
        else device-level used memory (mem_get_info) as fallback.
      * capture_zero_state(): snapshot taken BEFORE any model exists; all deltas
        are against this fixed baseline.
      * torch allocated / reserved kept as secondary detail readings.
      * ring-buffer history feeding the UI charts (~5 min at 0.5 s cadence).
    """
    HISTORY_LEN = 600

    def __init__(self, interval=0.5):
        super().__init__(daemon=True)
        self.interval = interval
        self.is_cuda = torch.cuda.is_available()
        self._nvml = None
        self._nvml_handle = None
        if self.is_cuda and HAS_NVML:
            try:
                pynvml.nvmlInit()
                self._nvml_handle = pynvml.nvmlDeviceGetHandleByIndex(torch.cuda.current_device())
                self._nvml = pynvml
            except Exception:
                self._nvml = None
        self.total_vram_mb = 0.0
        if self.is_cuda:
            try:
                _free_b, total_b = torch.cuda.mem_get_info()
                self.total_vram_mb = total_b / (1024 ** 2)
            except Exception:
                pass
        self.baseline_vram_mb = 0.0
        self.baseline_ram_mb = 0.0
        self.cur_vram_mb = 0.0            # true process (or device) VRAM
        self.cur_ram_mb = 0.0
        self.cur_alloc_mb = 0.0           # torch tensor bytes (the old, understated reading)
        self.cur_vram_reserved_mb = 0.0
        self.baseline_captured = False
        self.reporting_enabled = False   # per request: don't show until load/train starts
        self.vram_history: List[float] = []
        self.ram_history: List[float] = []
        self.hist_lock = threading.Lock()
        self._stop = False

    def process_vram_mb(self) -> float:
        if not self.is_cuda:
            return 0.0
        if self._nvml is not None:
            try:
                pid = os.getpid()
                for p in self._nvml.nvmlDeviceGetComputeRunningProcesses(self._nvml_handle):
                    if p.pid == pid and p.usedGpuMemory:
                        return p.usedGpuMemory / (1024 ** 2)
            except Exception:
                pass
        try:
            free_b, total_b = torch.cuda.mem_get_info()
            return (total_b - free_b) / (1024 ** 2)
        except Exception:
            return torch.cuda.memory_allocated() / (1024 ** 2)

    def capture_zero_state(self):
        """Call exactly once, right after the app has finished booting and is idle,
        BEFORE any model is loaded -- the true pre-model baseline."""
        if self.is_cuda:
            try:
                torch.cuda.synchronize()
                torch.cuda.empty_cache()
            except Exception:
                pass
        self.baseline_vram_mb = self.process_vram_mb()
        if HAS_PSUTIL:
            try:
                self.baseline_ram_mb = psutil.Process(os.getpid()).memory_info().rss / (1024 ** 2)
            except Exception:
                self.baseline_ram_mb = 0.0
        self.cur_vram_mb, self.cur_ram_mb = self.baseline_vram_mb, self.baseline_ram_mb
        self.baseline_captured = True
        GLOBAL_LOGGER.log(
            f"[MEM] Zero-state captured (pre-model baseline). "
            f"VRAM_base={self.baseline_vram_mb:.1f}MB RAM_base={self.baseline_ram_mb:.1f}MB "
            f"(GPU total {self.total_vram_mb:.0f}MB)")

    def begin_reporting(self):
        self.reporting_enabled = True

    def run(self):
        while not self._stop:
            try:
                if self.is_cuda:
                    self.cur_vram_mb = self.process_vram_mb()
                    self.cur_alloc_mb = torch.cuda.memory_allocated() / (1024 ** 2)
                    self.cur_vram_reserved_mb = torch.cuda.memory_reserved() / (1024 ** 2)
                if HAS_PSUTIL:
                    self.cur_ram_mb = psutil.Process(os.getpid()).memory_info().rss / (1024 ** 2)
                with self.hist_lock:
                    self.vram_history.append(self.cur_vram_mb)
                    self.ram_history.append(self.cur_ram_mb)
                    if len(self.vram_history) > self.HISTORY_LEN:
                        self.vram_history.pop(0)
                    if len(self.ram_history) > self.HISTORY_LEN:
                        self.ram_history.pop(0)
            except Exception:
                pass
            time.sleep(self.interval)

    def history_snapshot(self) -> Tuple[List[float], List[float]]:
        with self.hist_lock:
            return list(self.vram_history), list(self.ram_history)

    def deltas(self):
        return (max(0.0, self.cur_vram_mb - self.baseline_vram_mb),
                max(0.0, self.cur_ram_mb - self.baseline_ram_mb))

    def stats_string(self):
        if not self.baseline_captured or not self.reporting_enabled:
            return "VRAM: -- | RAM: -- (idle)"
        dv, dr = self.deltas()
        if self.is_cuda:
            v = (f"VRAM {self.cur_vram_mb/1024:.2f}/{self.total_vram_mb/1024:.0f}GB "
                 f"(D+{dv:.0f}MB | alloc {self.cur_alloc_mb:.0f} resv {self.cur_vram_reserved_mb:.0f}MB)")
        else:
            v = "VRAM: N/A"
        r = f"RAM {self.cur_ram_mb/1024:.2f}GB (D+{dr:.0f}MB)" if HAS_PSUTIL else "RAM: N/A"
        return f"{v}   |   {r}"


# =====================================================================
# HUMAN-READABLE ETA (seconds -> s/min/h/days/months/years, picking the most
# relevant unit or two, per request)
# =====================================================================
def format_eta_human(seconds: Optional[float]) -> str:
    if seconds is None or seconds != seconds or seconds < 0:
        return "--"
    s = seconds
    YEAR, MONTH, WEEK, DAY, HOUR, MIN = 31557600.0, 2629800.0, 604800.0, 86400.0, 3600.0, 60.0
    if s >= YEAR:
        y = s / YEAR
        return f"{y:.1f} year{'s' if y >= 1.05 else ''}"
    if s >= MONTH:
        m = s / MONTH
        return f"{m:.1f} month{'s' if m >= 1.05 else ''}"
    if s >= WEEK:
        w = s / WEEK
        return f"{w:.1f} week{'s' if w >= 1.05 else ''}"
    if s >= DAY:
        d = s / DAY
        rem_h = (s - int(d) * DAY) / HOUR
        return f"{int(d)}d {int(rem_h)}h"
    if s >= HOUR:
        h = int(s // HOUR)
        m = int((s - h * HOUR) // MIN)
        return f"{h}h {m:02d}m"
    if s >= MIN:
        m = int(s // MIN)
        sec = int(s - m * MIN)
        return f"{m}m {sec:02d}s"
    return f"{s:.1f}s"


class ETATracker:
    """Item 12: accurate, SMOOTH, pause-aware ETA.
    - rate: EMA of true per-step durations (pause time is excluded, fixing the
      old post-pause ETA inflation);
    - display: additionally low-pass filtered so the shown ETA glides down
      steadily instead of jumping between estimates."""
    def __init__(self, alpha=0.10, display_alpha=0.15):
        self.alpha = alpha
        self.display_alpha = display_alpha
        self.ema_step = None
        self.last_step_time = None
        self.last_step_dur = None
        self._display_eta = None
        self._paused_since = None

    def start(self):
        self.ema_step = None
        self.last_step_time = time.time()
        self.last_step_dur = None
        self._display_eta = None
        self._paused_since = None

    def pause(self):
        if self._paused_since is None:
            self._paused_since = time.time()

    def resume(self):
        if self._paused_since is not None:
            if self.last_step_time is not None:
                self.last_step_time += time.time() - self._paused_since
            self._paused_since = None

    def update(self, steps_done: int, total_steps: int) -> Tuple[Optional[float], Optional[float]]:
        """Returns (smoothed_eta_seconds, seconds_per_batch_estimate)."""
        now = time.time()
        if self.last_step_time is None:
            self.last_step_time = now
            return None, None
        dur = now - self.last_step_time
        self.last_step_time = now
        self.last_step_dur = dur
        if dur > 0:
            self.ema_step = dur if self.ema_step is None else (
                self.alpha * dur + (1 - self.alpha) * self.ema_step)
        if self.ema_step is None or steps_done <= 0:
            return None, None
        remaining = max(0, total_steps - steps_done)
        raw_eta = self.ema_step * remaining
        if self._display_eta is None:
            self._display_eta = raw_eta
        else:
            # natural decrease is ~one step duration per step; gently blend
            # toward the fresh estimate so changes are gradual, never jumpy.
            self._display_eta = max(0.0, (1 - self.display_alpha) * (self._display_eta - dur)
                                    + self.display_alpha * raw_eta)
        return self._display_eta, self.ema_step


# =====================================================================
# SETTINGS MANAGER — JSON, live bidirectional sync
# Bugfix (per request): running two app instances against the same settings.json
# raced -- both could read-modify-write and stomp each other, and mtime-only checks
# missed same-second writes. Fix: content-hash comparison (not just mtime) so we only
# treat it as "changed" when bytes actually differ, a soft file lock via a sentinel
# file to reduce (not just detect) the race window, and we merge rather than
# clobber -- only overwrite keys that actually differ.
# =====================================================================
class SettingsManager:
    def __init__(self, path=CONFIG_PATH):
        self.path = path
        self.last_mtime = 0.0
        self.last_hash = ""
        self.lock_path = path + ".lock"

    def _hash_of(self, data: dict) -> str:
        try:
            return hashlib.sha1(json.dumps(data, sort_keys=True).encode("utf-8")).hexdigest()
        except Exception:
            return ""

    def _acquire_lock(self, timeout=0.5) -> bool:
        t0 = time.time()
        while time.time() - t0 < timeout:
            try:
                fd = os.open(self.lock_path, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
                os.close(fd)
                return True
            except FileExistsError:
                try:
                    if time.time() - os.path.getmtime(self.lock_path) > 2.0:
                        os.remove(self.lock_path)  # stale lock from a crashed instance
                        continue
                except Exception:
                    pass
                time.sleep(0.02)
        return False

    def _release_lock(self):
        try:
            os.remove(self.lock_path)
        except Exception:
            pass

    def save(self, cfg_dict: dict):
        # Item 15: smart change detection -- if the content is identical to what
        # is already on disk, skip the write entirely (no disk I/O churn, no
        # corruption risk from redundant rewrites).
        if self._hash_of(cfg_dict) == self.last_hash and os.path.exists(self.path):
            return
        # FIX: Windows frequently raises WinError 5 (Access is denied) on os.replace
        # when the destination is briefly locked by AV, Explorer, OneDrive, a previous
        # crashed handle, or the read-only attribute. Retry with backoff, then fall
        # back to a direct overwrite so settings are never lost and the UI never dies.
        got_lock = self._acquire_lock()
        try:
            tmp = self.path + ".tmp"
            payload = json.dumps(cfg_dict, indent=2)
            last_err = None
            for attempt in range(6):
                try:
                    with open(tmp, "w", encoding="utf-8") as f:
                        f.write(payload)
                    try:
                        os.replace(tmp, self.path)
                    except OSError:
                        # dest locked or read-only — try clearing read-only then replace again
                        try:
                            if os.path.exists(self.path):
                                os.chmod(self.path, 0o666)
                            os.replace(tmp, self.path)
                        except OSError:
                            # final fallback: direct write (non-atomic but works)
                            with open(self.path, "w", encoding="utf-8") as f:
                                f.write(payload)
                            try:
                                os.remove(tmp)
                            except Exception:
                                pass
                    self.last_mtime = os.path.getmtime(self.path)
                    self.last_hash = self._hash_of(cfg_dict)
                    return
                except Exception as e:
                    last_err = e
                    time.sleep(0.04 * (attempt + 1))
            GLOBAL_LOGGER.log(f"[SETTINGS] save failed after retries: {last_err}")
        finally:
            if got_lock:
                self._release_lock()

    def load(self) -> Optional[dict]:
        if not os.path.exists(self.path):
            return None
        try:
            self.last_mtime = os.path.getmtime(self.path)
            with open(self.path, "r", encoding="utf-8") as f:
                data = json.load(f)
            self.last_hash = self._hash_of(data)
            return data
        except Exception:
            return None   # transient partial-write from the other instance; try again next poll

    def check_for_external_update(self) -> bool:
        if not os.path.exists(self.path):
            return False
        try:
            mtime = os.path.getmtime(self.path)
        except Exception:
            return False
        if mtime <= self.last_mtime + 1e-6:
            return False
        # mtime moved -- confirm actual content changed before triggering a full re-ingest
        try:
            with open(self.path, "r", encoding="utf-8") as f:
                data = json.load(f)
        except Exception:
            return False
        new_hash = self._hash_of(data)
        self.last_mtime = mtime
        if new_hash == self.last_hash:
            return False
        self.last_hash = new_hash
        return True


# =====================================================================
# DATASET CACHE (unchanged behavior from v10)
# =====================================================================
CACHE_SIZE_THRESHOLD = 100 * 1024 * 1024

def _dataset_cache_key(path: str, encoding: str) -> str:
    raw = f"{os.path.abspath(path)}|{os.path.getmtime(path)}|{encoding}"
    return hashlib.md5(raw.encode("utf-8")).hexdigest()

def load_tokens_with_cache(path: str, codec: TiktokenCodec, cache_dir: str, log=print) -> torch.Tensor:
    size = os.path.getsize(path)
    os.makedirs(cache_dir, exist_ok=True)
    # GGUF unigram encode is pure-Python Viterbi: always cache it, not just >100MB.
    use_cache = size > CACHE_SIZE_THRESHOLD or getattr(codec, "mode", "") == "gguf"
    cache_path = os.path.join(cache_dir, _dataset_cache_key(path, codec.encoding_name) + ".pt")
    if use_cache and os.path.exists(cache_path):
        log(f"[cache] hit -> loading cached tokens: {cache_path}")
        try:
            return torch.load(cache_path, weights_only=True)
        except Exception as e:
            log(f"[cache] cache load failed ({e}); retokenizing")
    log(f"[cache] tokenizing {path} ({size/1e6:.1f} MB) with {codec.encoding_name} ...")
    with open(path, "r", encoding="utf-8", errors="replace") as f:
        text = f.read()
    ids = codec.encode(text)
    tokens = torch.tensor(ids, dtype=torch.long)
    if use_cache:
        try:
            torch.save(tokens, cache_path)
            log(f"[cache] stored -> {cache_path}")
        except Exception as e:
            log(f"[cache] failed to store cache: {e}")
    return tokens


# =====================================================================
# ERDOS-STRAUS DATASET SYNTHESIZER (unchanged)
# =====================================================================
class ErdosStrausGenerator:
    @staticmethod
    def generate_dataset(max_n=800, output_path="aura_fallback_data.txt"):
        GLOBAL_LOGGER.log(f"Generating Erdos-Straus diophantine data n=2..{max_n} ...")
        count = 0
        with open(output_path, "w", encoding="utf-8") as f:
            f.write("=== AURA FORMAL MATHEMATICAL SUITE ===\n")
            for n in range(2, max_n + 1):
                found = False
                lower_x = math.ceil(n / 4)
                for x in range(lower_x, n + 1):
                    if found:
                        break
                    rem = 4 * x - n
                    if rem <= 0:
                        continue
                    lower_y = max(x, math.ceil(x * n / rem))
                    upper_y = math.floor(2 * x * n / rem)
                    for y in range(lower_y, upper_y + 1):
                        num = rem * y - x * n
                        den = n * x * y
                        if num > 0 and den % num == 0:
                            z = den // num
                            f.write(f"Proof 4/{n} = 1/{x} + 1/{y} + 1/{z}\n")
                            count += 1
                            found = True
                            break
        GLOBAL_LOGGER.log(f"Synthesized {count} proofs -> {output_path}")
        return output_path

    @staticmethod
    def verify_proof_line(line: str) -> bool:
        """Ground-truth checker: is `4/n = 1/x + 1/y + 1/z` actually true? Used by
        aurora_astralis to only cache verbatim spans that are factually correct,
        never on 'the model seemed confident' -- confidence is not verification."""
        m = re.match(r"Proof 4/(\d+) = 1/(\d+) \+ 1/(\d+) \+ 1/(\d+)", line.strip())
        if not m:
            return False
        n, x, y, z = (int(g) for g in m.groups())
        if n <= 0 or x <= 0 or y <= 0 or z <= 0:
            return False
        from fractions import Fraction
        return Fraction(4, n) == Fraction(1, x) + Fraction(1, y) + Fraction(1, z)


# =====================================================================
# ELASTIC WEIGHT CONSOLIDATION (unchanged)
# =====================================================================
class EWCState:
    """Elastic Weight Consolidation with ~ZERO steady-state VRAM (fix C10).
    The previous version permanently cached the full Fisher + anchor dicts on
    the GPU (~2x model bytes), so a model that maximally fit the card could not
    be retrained with EWC on. Now Fisher/anchor stay in PINNED CPU memory and
    penalty() streams them to the device ONE parameter at a time; the transient
    footprint is the largest single tensor, freed immediately after use."""
    def __init__(self):
        self.fisher: Optional[Dict[str, torch.Tensor]] = None
        self.anchor: Optional[Dict[str, torch.Tensor]] = None

    def pin(self):
        """Pin the CPU tensors for fast async host->device copies."""
        if self.fisher is None or self.anchor is None or not torch.cuda.is_available():
            return
        try:
            self.fisher = {n: (t if t.is_pinned() else t.pin_memory()) for n, t in self.fisher.items()}
            self.anchor = {n: (t if t.is_pinned() else t.pin_memory()) for n, t in self.anchor.items()}
        except Exception:
            pass

    def invalidate_device_cache(self):
        pass  # kept for API compatibility; no persistent device cache exists anymore

    def penalty(self, model: nn.Module, lam: float, device) -> torch.Tensor:
        if self.fisher is None or self.anchor is None or lam <= 0:
            return torch.tensor(0.0, device=device)
        total = None
        for n, p in model.named_parameters():
            f_cpu = self.fisher.get(n)
            a_cpu = self.anchor.get(n)
            if f_cpu is None or a_cpu is None:
                continue
            f = f_cpu.to(device, non_blocking=True)
            a = a_cpu.to(device, non_blocking=True)
            term = (f * (p.float() - a).pow(2)).sum()
            total = term if total is None else total + term
            del f, a
        if total is None:
            return torch.tensor(0.0, device=device)
        return lam * total


# =====================================================================
# AURORA ASTRALIS — verbatim span cache (see module docstring item 2)
# -------------------------------------------------------------------------------------
# HONEST DESCRIPTION OF WHAT THIS IS:
#   A bounded key -> verbatim-text store. Keys are a hash of a *trigger context*
#   (the text immediately preceding a span). Values are exact strings that were
#   independently VERIFIED correct (for Erdos-Straus proofs: checked via
#   `verify_proof_line`; for other text: only stored when it exactly matches
#   ground-truth training data, never from generation output).
#   At generation time, if meta_generate is on and the live context's tail exactly
#   matches a stored key, Aura appends the cached string directly and advances past
#   it in one step -- skipping N token-generation steps for N tokens of cached text.
#   This is real, deterministic, and reproducible. It is NOT: the model "predicting"
#   anything, an emergent capability, or evidence of latent-space intuition. A cache
#   miss (the common case for novel prompts) falls through to normal generation with
#   zero overhead beyond one dict lookup.
# Portable / mergeable: keys are hashes of plain text, not of any model's internal
# activations, so a cache trained by one model configuration loads and helps under
# a different d_model/n_heads/vocab. "Merge" = union of records; on key collision,
# the entry with more verified hits wins (explicit rule, not implicit "wisdom").
# =====================================================================
@dataclass
class AstralisRecord:
    trigger_hash: str
    trigger_preview: str      # first ~40 chars of the trigger text, for human debugging
    payload: str              # the verbatim cached continuation
    kind: str                 # "erdos_straus" | "verbatim_fact" | "context_span"
    hits: int = 0             # times this record has been successfully used at gen time
    verified: bool = True     # was this checked against ground truth before storing


class AuroraAstralis:
    MAX_BYTES_DEFAULT = 24 * 1024   # ~24KB per request; configurable

    def __init__(self, max_bytes: int = MAX_BYTES_DEFAULT):
        self.max_bytes = max_bytes
        self.records: Dict[str, AstralisRecord] = {}
        self._lock = threading.Lock()

    @staticmethod
    def _hash_trigger(trigger_text: str) -> str:
        norm = trigger_text.strip()[-256:]   # bound the hashed window
        return hashlib.blake2b(norm.encode("utf-8", errors="ignore"), digest_size=12).hexdigest()

    def estimate_bytes(self) -> int:
        total = 0
        for r in self.records.values():
            total += len(r.payload.encode("utf-8")) + len(r.trigger_preview.encode("utf-8")) + 48
        return total

    def commit(self, trigger_text: str, payload: str, kind: str, verified: bool = True) -> bool:
        """Explicitly called by the trainer (never by generation output) to store a
        verified verbatim span. Returns False if it was rejected (unverified, or
        cache is full and this entry doesn't outrank the weakest existing one)."""
        if not verified:
            return False   # never cache anything that wasn't independently checked
        key = self._hash_trigger(trigger_text)
        with self._lock:
            rec = AstralisRecord(
                trigger_hash=key, trigger_preview=trigger_text.strip()[-40:],
                payload=payload, kind=kind, hits=0, verified=True)
            self.records[key] = rec
            if self.estimate_bytes() > self.max_bytes:
                self._evict_weakest()
            return True

    def _evict_weakest(self):
        # explicit, documented eviction rule: fewest hits first, ties broken by
        # shortest payload retained (keeps cache dense) -- not an "emergent" choice.
        while self.estimate_bytes() > self.max_bytes and self.records:
            weakest = min(self.records.values(), key=lambda r: (r.hits, -len(r.payload)))
            del self.records[weakest.trigger_hash]

    def lookup(self, context_text: str) -> Optional[AstralisRecord]:
        """Try exact hash of the full tail first, then progressively shorter
        suffixes so a verified span is more likely to match when the prompt
        ends with previously-seen ground-truth text. Still pure dictionary
        lookup -- no model intuition."""
        text = (context_text or "").strip()
        if not text:
            return None
        # try windows of 256, 128, 64, 32 chars from the end
        for win in (256, 128, 64, 32):
            key = self._hash_trigger(text[-win:] if len(text) > win else text)
            rec = self.records.get(key)
            if rec is not None:
                rec.hits += 1
                return rec
        return None

    def merge_additive(self, other: "AuroraAstralis"):
        """Union merge. On collision: keep whichever record has more verified hits.
        Documented, deterministic rule -- this is what 'additive merge' means here."""
        with self._lock:
            for k, rec in other.records.items():
                if k not in self.records or rec.hits > self.records[k].hits:
                    self.records[k] = rec
            if self.estimate_bytes() > self.max_bytes:
                self._evict_weakest()

    def save(self, path: str):
        try:
            blob = {
                "version": "astralis-v1",
                "max_bytes": self.max_bytes,
                "records": [asdict(r) for r in self.records.values()],
            }
            torch.save(blob, path)
            GLOBAL_LOGGER.log(f"[astralis] saved {len(self.records)} records "
                              f"(~{self.estimate_bytes()/1024:.1f}KB) -> {path}")
        except Exception as e:
            GLOBAL_LOGGER.log(f"[astralis] save failed: {e}")

    @classmethod
    def load(cls, path: str) -> "AuroraAstralis":
        inst = cls()
        if not os.path.exists(path):
            return inst
        try:
            blob = torch.load(path, weights_only=False)
            inst.max_bytes = blob.get("max_bytes", cls.MAX_BYTES_DEFAULT)
            for rd in blob.get("records", []):
                rec = AstralisRecord(**rd)
                inst.records[rec.trigger_hash] = rec
            GLOBAL_LOGGER.log(f"[astralis] loaded {len(inst.records)} records from {path}")
        except Exception as e:
            GLOBAL_LOGGER.log(f"[astralis] load failed: {e}")
        return inst


# =====================================================================
# META_SCRATCHPAD — real CPU+GPU concurrency dispatcher (experimental, tagged)
# -------------------------------------------------------------------------------------
# EXPERIMENTAL / SUBJECT TO CHANGE: this dispatcher offloads work that does NOT touch
# CUDA tensors (astralis cache encode + disk save, Erdos-Straus verification, text
# hashing) to a background CPU thread pool, so it can run *while* the GPU is mid
# forward/backward for the next step. This is genuine parallelism (no shared CUDA
# context contention) -- it is not a claim that CPU and GPU jointly compute a single
# forward pass together, which is not how these devices execute a single training step.
# =====================================================================
class MetaScratchpad:
    MODES = ("cpu_gpu", "cpu_only", "gpu_only")

    def __init__(self, mode: str = "cpu_gpu", max_workers: int = 2):
        self.mode = mode if mode in self.MODES else "cpu_gpu"
        self._pool: Optional[ThreadPoolExecutor] = None
        self._ensure_pool(max_workers)

    def _ensure_pool(self, max_workers):
        if self.mode == "cpu_only" or self.mode == "cpu_gpu":
            if self._pool is None:
                self._pool = ThreadPoolExecutor(max_workers=max_workers, thread_name_prefix="scratchpad")
        else:
            self._pool = None  # gpu_only: no background CPU offload at all

    def set_mode(self, mode: str):
        self.mode = mode if mode in self.MODES else "cpu_gpu"
        if self.mode == "gpu_only" and self._pool is not None:
            self._pool.shutdown(wait=False)
            self._pool = None
        elif self.mode != "gpu_only" and self._pool is None:
            self._pool = ThreadPoolExecutor(max_workers=2, thread_name_prefix="scratchpad")

    def submit(self, fn, *args, **kwargs):
        """Fire-and-continue background work. If mode is gpu_only, runs inline
        instead (explicit fallback, never silently dropped)."""
        if self._pool is not None:
            try:
                return self._pool.submit(fn, *args, **kwargs)
            except Exception as e:
                GLOBAL_LOGGER.log(f"[meta_scratchpad] submit failed ({e}); running inline")
        try:
            fn(*args, **kwargs)
        except Exception as e:
            GLOBAL_LOGGER.log(f"[meta_scratchpad] inline task failed: {e}")
        return None

    def shutdown(self, wait=True):
        if self._pool is not None:
            self._pool.shutdown(wait=wait)
            self._pool = None


# =====================================================================
# ATTENTION — fused qkv, SDPA, KV cache. Slowdown bugfix: cache is now trimmed to
# max_seq on *every* step unconditionally (previously only checked size AFTER
# concatenation but the comparison used int() on a possibly-stale max_seq copied at
# construction, and multi-turn context accumulation bypassed it entirely -- see
# AuraLM.generate_stateful_turn below for the actual multi-turn fix).
# =====================================================================
class MultiHeadCausalAttention(nn.Module):
    """Fused-QKV causal attention with RoPE (rotary positional encoding).
    RoPE replaces the old learned absolute wpe table (fix C15 / item 6):
    positions are encoded as rotations of q/k, are RELATIVE under the dot
    product, never saturate at block_size, and permit ANY context length.
    Odd head_dims rotate the largest even prefix; the remainder passes through.
    Masking audit: prefill uses SDPA is_causal=True (strict causal); stepping
    attends over the full (trimmed) cache with is_causal=False, which is correct
    because the single query is by construction the newest position."""
    def __init__(self, d_model: int, n_heads: int, dropout: float = 0.1,
                 max_seq: int = 2048, bias: bool = False, use_rope: bool = True,
                 rope_base: float = 10000.0, head_dim: int = 0,
                 n_kv_heads: int = 0, qk_norm: bool = False):
        super().__init__()
        if not head_dim and d_model % n_heads != 0:
            n_heads = max(1, d_model // max(1, d_model // n_heads))
            while d_model % n_heads != 0 and n_heads > 1:
                n_heads -= 1
        self.n_heads = n_heads
        self.head_dim = head_dim or (d_model // n_heads)
        self.n_kv_heads = n_kv_heads or n_heads
        self.d_model = d_model
        self.inner = self.n_heads * self.head_dim        # q / attn-output width
        self.kv_inner = self.n_kv_heads * self.head_dim  # k and v width each (GQA)
        self.max_seq = max_seq
        self.c_attn = nn.Linear(d_model, self.inner + 2 * self.kv_inner, bias=bias)
        self.c_proj = nn.Linear(self.inner, d_model, bias=bias)
        # Gemma-style per-head RMSNorm on q/k BEFORE RoPE (weight stored as 1+w)
        self.use_qk_norm = qk_norm
        if qk_norm:
            self.q_norm = nn.Parameter(torch.ones(self.head_dim))
            self.k_norm = nn.Parameter(torch.ones(self.head_dim))
        self.dropout = dropout
        self.resid_drop = nn.Dropout(dropout)
        nn.init.zeros_(self.c_proj.weight)
        # ---- RoPE tables (rot_dim=0 fully disables rotation for legacy
        # learned-position checkpoints; _apply_rope becomes a no-op) ----
        self.use_rope = use_rope
        self.rope_base = float(rope_base) if rope_base and rope_base > 0 else 10000.0
        self.rot_dim = (self.head_dim - (self.head_dim % 2)) if use_rope else 0
        inv_freq = (1.0 / (self.rope_base ** (torch.arange(0, self.rot_dim, 2).float() / max(1, self.rot_dim)))
                    if self.rot_dim > 0 else torch.zeros(0))
        self.register_buffer("rope_inv_freq", inv_freq, persistent=False)

    def _rope_cos_sin(self, positions: torch.Tensor, dtype):
        freqs = positions.float().unsqueeze(-1) * self.rope_inv_freq.float()  # (T, rot_dim/2)
        return freqs.cos().to(dtype), freqs.sin().to(dtype)

    def _apply_rope(self, t: torch.Tensor, cos: torch.Tensor, sin: torch.Tensor) -> torch.Tensor:
        """t: (B, H, T, head_dim); cos/sin: (T, rot_dim/2)."""
        rd = self.rot_dim
        if rd == 0:
            return t
        t_rot, t_pass = t[..., :rd], t[..., rd:]
        t1, t2 = t_rot[..., 0::2], t_rot[..., 1::2]
        cos = cos.view(1, 1, cos.size(0), -1)
        sin = sin.view(1, 1, sin.size(0), -1)
        r1 = t1 * cos - t2 * sin
        r2 = t1 * sin + t2 * cos
        out = torch.stack((r1, r2), dim=-1).flatten(-2)
        if t_pass.size(-1):
            out = torch.cat([out, t_pass], dim=-1)
        return out

    def _apply_qk_norm(self, q, k):
        if not self.use_qk_norm:
            return q, k
        q = F.rms_norm(q, (self.head_dim,), weight=self.q_norm, eps=1e-6)
        k = F.rms_norm(k, (self.head_dim,), weight=self.k_norm, eps=1e-6)
        return q, k

    def _expand_kv(self, t: torch.Tensor) -> torch.Tensor:
        """GQA: broadcast shared kv heads across the q-head groups."""
        if self.n_kv_heads == self.n_heads:
            return t
        return t.repeat_interleave(self.n_heads // self.n_kv_heads, dim=1)

    def rotate_kv_for_cache(self, k_full: torch.Tensor) -> torch.Tensor:
        """Rotate prefill keys at their absolute positions before caching so the
        stepping path (which rotates new q/k at their own positions) stays
        geometrically consistent with the cached history."""
        T = k_full.size(2)
        pos = torch.arange(T, device=k_full.device)
        cos, sin = self._rope_cos_sin(pos, k_full.dtype)
        return self._apply_rope(k_full, cos, sin)

    def forward(self, x: torch.Tensor, pos_offset: int = 0) -> torch.Tensor:
        B, T, C = x.shape
        q, k, v = self.c_attn(x).split([self.inner, self.kv_inner, self.kv_inner], dim=2)
        q = q.view(B, T, self.n_heads, self.head_dim).transpose(1, 2)
        k = k.view(B, T, self.n_kv_heads, self.head_dim).transpose(1, 2)
        v = v.view(B, T, self.n_kv_heads, self.head_dim).transpose(1, 2)
        q, k = self._apply_qk_norm(q, k)
        pos = torch.arange(pos_offset, pos_offset + T, device=x.device)
        cos, sin = self._rope_cos_sin(pos, q.dtype)
        q = self._apply_rope(q, cos, sin)
        k = self._apply_rope(k, cos, sin)
        k = self._expand_kv(k)
        v = self._expand_kv(v)
        y = F.scaled_dot_product_attention(
            q, k, v, dropout_p=self.dropout if self.training else 0.0, is_causal=True)
        y = y.transpose(1, 2).contiguous().view(B, T, self.inner)
        return self.resid_drop(self.c_proj(y))

    def step(self, x_bd: torch.Tensor, k_cache: torch.Tensor, v_cache: torch.Tensor,
             pos_idx: int = 0):
        B, C = x_bd.shape
        q, k, v = self.c_attn(x_bd).split([self.inner, self.kv_inner, self.kv_inner], dim=1)
        q = q.view(B, self.n_heads, 1, self.head_dim)
        k = k.view(B, self.n_kv_heads, 1, self.head_dim)
        v = v.view(B, self.n_kv_heads, 1, self.head_dim)
        q, k = self._apply_qk_norm(q, k)
        pos = torch.tensor([pos_idx], device=x_bd.device)
        cos, sin = self._rope_cos_sin(pos, q.dtype)
        q = self._apply_rope(q, cos, sin)
        k = self._apply_rope(k, cos, sin)
        k_cache = torch.cat([k_cache, k], dim=2)
        v_cache = torch.cat([v_cache, v], dim=2)
        if k_cache.size(2) > self.max_seq:          # unconditional trim, every step
            k_cache = k_cache[:, :, -self.max_seq:].contiguous()
            v_cache = v_cache[:, :, -self.max_seq:].contiguous()
        y = F.scaled_dot_product_attention(
            q, self._expand_kv(k_cache), self._expand_kv(v_cache), is_causal=False)
        y = y.transpose(1, 2).contiguous().view(B, self.inner)
        return self.resid_drop(self.c_proj(y)), k_cache, v_cache

    def init_kv(self, batch_size, device, dtype):
        z = lambda: torch.zeros(batch_size, self.n_kv_heads, 0, self.head_dim, device=device, dtype=dtype)
        return z(), z()


# =====================================================================
# HYENA BLOCK (unchanged from v10 -- the bug was in the generation driver, not here)
# =====================================================================
def _causal_conv_full(conv: nn.Conv1d, x_bld: torch.Tensor) -> torch.Tensor:
    if x_bld.numel() == 0:
        return x_bld
    k = conv.kernel_size[0]
    x_bdl = x_bld.transpose(1, 2)
    x_pad = F.pad(x_bdl, (k - 1, 0))
    return conv(x_pad).transpose(1, 2)

def _causal_conv_step(conv: nn.Conv1d, x_bd: torch.Tensor, state: torch.Tensor):
    # Defensive: if state was extracted from a short prefill (T < kernel-1) it may be
    # shorter than required. Left-pad with zeros so conv1d never sees input < kernel.
    k = conv.kernel_size[0]
    need = k - 1
    if state.size(2) < need:
        pad = torch.zeros(state.size(0), state.size(1), need - state.size(2),
                          device=state.device, dtype=state.dtype)
        state = torch.cat([pad, state], dim=2)
    elif state.size(2) > need:
        state = state[:, :, -need:]
    x_win = torch.cat([state, x_bd.unsqueeze(2)], dim=2)
    out = F.conv1d(x_win, conv.weight, conv.bias, stride=1, padding=0, groups=conv.groups)
    return out.squeeze(2), x_win[:, :, 1:]


class GatedMLP(nn.Module):
    """GLU feed-forward matching llama/gemma exactly:
    down(gelu_tanh(gate(x)) * up(x)). Used for GGUF transplants so the source
    MLP matrices copy 1:1 -- the old up-only FFN silently dropped the gate
    projection's multiplicative path, which is half of the source MLP."""
    def __init__(self, d_model: int, dff: int):
        super().__init__()
        self.gate_proj = nn.Linear(d_model, dff)
        self.up_proj = nn.Linear(d_model, dff)
        self.down_proj = nn.Linear(dff, d_model)

    def forward(self, x):
        return self.down_proj(F.gelu(self.gate_proj(x), approximate="tanh") * self.up_proj(x))


class HyenaBlock(nn.Module):
    def __init__(self, d_model: int, kernel_size: int = 4, dim_feedforward: int = None,
                 dropout: float = 0.1, n_heads: int = 4, use_attn: bool = True,
                 max_seq: int = 2048, use_rope: bool = True, rope_base: float = 10000.0,
                 gated_mlp: bool = False, attn_head_dim: int = 0,
                 n_kv_heads: int = 0, qk_norm: bool = False):
        super().__init__()
        if d_model < n_heads:
            n_heads = 1
        if d_model % n_heads != 0:
            n_heads = 1
        dim_feedforward = dim_feedforward or d_model * 4
        self.d_model = d_model
        self.kernel_size = kernel_size
        self.n_heads = n_heads
        self.use_attn = use_attn
        self.norm1 = nn.LayerNorm(d_model)
        self.conv = nn.Conv1d(d_model, d_model, kernel_size=kernel_size, groups=n_heads, bias=True)
        self.attn = (MultiHeadCausalAttention(d_model, n_heads, dropout, max_seq,
                                              use_rope=use_rope, rope_base=rope_base,
                                              head_dim=attn_head_dim,
                                              n_kv_heads=n_kv_heads, qk_norm=qk_norm)
                     if use_attn else None)
        self.gate = nn.Linear(d_model, d_model)
        nn.init.xavier_normal_(self.gate.weight, gain=0.1)
        self.norm2 = nn.LayerNorm(d_model)
        self.gated_mlp = gated_mlp
        self.ffn = (GatedMLP(d_model, dim_feedforward) if gated_mlp else nn.Sequential(
            nn.Linear(d_model, dim_feedforward), nn.GELU(), nn.Linear(dim_feedforward, d_model)))
        self.drop = nn.Dropout(dropout)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        h = self.norm1(x)
        combined = _causal_conv_full(self.conv, h)
        if self.use_attn and self.attn is not None:
            combined = combined + self.attn(h)
        gate = torch.sigmoid(self.gate(combined))
        x = x + self.drop(combined * gate)
        x = x + self.drop(self.ffn(self.norm2(x)))
        return x

    def step(self, x, conv_state, kv_cache, pos_idx: int = 0):
        h = self.norm1(x)
        combined, new_conv_state = _causal_conv_step(self.conv, h, conv_state)
        new_kv = None
        if self.use_attn and self.attn is not None:
            if kv_cache is None:
                k_c, v_c = self.attn.init_kv(x.size(0), x.device, x.dtype)
            else:
                k_c, v_c = kv_cache
            attn_out, k_c, v_c = self.attn.step(h, k_c, v_c, pos_idx)
            combined = combined + attn_out
            new_kv = (k_c, v_c)
        gate = torch.sigmoid(self.gate(combined))
        x = x + combined * gate
        x = x + self.ffn(self.norm2(x))
        return x, new_conv_state, new_kv

    def init_state(self, batch_size, device, dtype):
        return torch.zeros(batch_size, self.d_model, self.kernel_size - 1, device=device, dtype=dtype)


# =====================================================================
# GPT BLOCK — pure transformer (from gpt.py merge)
# Standard pre-LN: attn → mlp with residuals. Supports RoPE via
# config, KV-cache for stateful generation.
# =====================================================================
class GPTCausalSelfAttention(nn.Module):
    """Multi-head causal self-attention, matching gpt.py.
    Supports GQA, RoPE, QK-norm, and configurable head dim
    (compatible with Gemma/Llama/Mistral GGUF conversion)."""
    def __init__(self, d_model: int, n_heads: int, dropout: float = 0.1,
                 block_size: int = 512, bias: bool = False, use_rope: bool = False,
                 rope_base: float = 10000.0, n_kv_heads: int = 0,
                 head_dim: int = 0, qk_norm: bool = False):
        super().__init__()
        assert d_model % n_heads == 0
        self.n_head = n_heads
        self.n_embd = d_model
        self.head_dim = head_dim or (d_model // n_heads)
        self.n_kv_heads = n_kv_heads or n_heads
        self.inner = self.n_head * self.head_dim          # q / attn-output width
        self.kv_inner = self.n_kv_heads * self.head_dim   # k and v width each (GQA)
        self.dropout = dropout
        self.block_size = block_size
        self.c_attn = nn.Linear(d_model, self.inner + 2 * self.kv_inner, bias=bias)
        self.c_proj = nn.Linear(self.inner, d_model, bias=bias)
        self.resid_dropout = nn.Dropout(dropout)
        self.register_buffer(
            "mask",
            torch.tril(torch.ones(block_size, block_size))
                  .view(1, 1, block_size, block_size)
        )
        # RoPE support (optional)
        self.use_rope = use_rope
        self.rope_base = float(rope_base) if rope_base and rope_base > 0 else 10000.0
        self.rot_dim = (self.head_dim - (self.head_dim % 2)) if use_rope else 0
        inv_freq = (1.0 / (self.rope_base ** (torch.arange(0, self.rot_dim, 2).float() / max(1, self.rot_dim)))
                    if self.rot_dim > 0 else torch.zeros(0))
        self.register_buffer("rope_inv_freq", inv_freq, persistent=False)
        # QK-norm (Gemma per-head RMSNorm on q/k before RoPE)
        self.use_qk_norm = qk_norm
        if qk_norm:
            self.q_norm = nn.Parameter(torch.ones(self.head_dim))
            self.k_norm = nn.Parameter(torch.ones(self.head_dim))

    def _rope_cos_sin(self, positions: torch.Tensor, dtype):
        if self.rot_dim == 0:
            return None, None
        freqs = positions.float().unsqueeze(-1) * self.rope_inv_freq.float()
        return freqs.cos().to(dtype), freqs.sin().to(dtype)

    def _apply_rope(self, t: torch.Tensor, cos: torch.Tensor, sin: torch.Tensor) -> torch.Tensor:
        rd = self.rot_dim
        if rd == 0:
            return t
        t_rot, t_pass = t[..., :rd], t[..., rd:]
        t1, t2 = t_rot[..., 0::2], t_rot[..., 1::2]
        cos = cos.view(1, 1, cos.size(0), -1)
        sin = sin.view(1, 1, sin.size(0), -1)
        r1 = t1 * cos - t2 * sin
        r2 = t1 * sin + t2 * cos
        out = torch.stack((r1, r2), dim=-1).flatten(-2)
        if t_pass.size(-1):
            out = torch.cat([out, t_pass], dim=-1)
        return out

    def _apply_qk_norm(self, q, k):
        if not self.use_qk_norm:
            return q, k
        q = F.rms_norm(q, (self.head_dim,), weight=self.q_norm, eps=1e-6)
        k = F.rms_norm(k, (self.head_dim,), weight=self.k_norm, eps=1e-6)
        return q, k

    def _expand_kv(self, t: torch.Tensor) -> torch.Tensor:
        """GQA: broadcast shared kv heads across q-head groups."""
        if self.n_kv_heads == self.n_head:
            return t
        return t.repeat_interleave(self.n_head // self.n_kv_heads, dim=1)

    def forward(self, x, past_kv=None, use_cache=False):
        B, T, C = x.size()
        q, k, v = self.c_attn(x).split([self.inner, self.kv_inner, self.kv_inner], dim=2)
        nh, hs, nkv = self.n_head, self.head_dim, self.n_kv_heads
        q = q.view(B, T, nh, hs).transpose(1, 2)
        k = k.view(B, T, nkv, hs).transpose(1, 2)
        v = v.view(B, T, nkv, hs).transpose(1, 2)

        # QK-norm (before RoPE)
        q, k = self._apply_qk_norm(q, k)

        # RoPE
        if self.use_rope:
            pos = torch.arange(T, device=x.device)
            cos, sin = self._rope_cos_sin(pos, q.dtype)
            if cos is not None:
                q = self._apply_rope(q, cos, sin)
                k = self._apply_rope(k, cos, sin)

        # KV cache
        if past_kv is not None:
            k_cache, v_cache = past_kv
            k = torch.cat([k_cache, k], dim=2)
            v = torch.cat([v_cache, v], dim=2)
            if k.size(2) > self.block_size:
                k = k[:, :, -self.block_size:].contiguous()
                v = v[:, :, -self.block_size:].contiguous()

        # GQA broadcast for SDPA
        k_exp = self._expand_kv(k)
        v_exp = self._expand_kv(v)

        if hasattr(F, "scaled_dot_product_attention"):
            y = F.scaled_dot_product_attention(
                q, k_exp, v_exp,
                attn_mask=None,
                dropout_p=self.dropout if self.training else 0.0,
                is_causal=(past_kv is None),
            )
        else:
            scale = 1.0 / math.sqrt(hs)
            att = (q @ k_exp.transpose(-2, -1)) * scale
            if past_kv is None:
                att = att.masked_fill(self.mask[:, :, :T, :T] == 0, float("-inf"))
            att = F.softmax(att, dim=-1)
            y = att @ v_exp

        y = y.transpose(1, 2).contiguous().view(B, T, self.inner)

        if use_cache:
            return self.resid_dropout(self.c_proj(y)), (k.detach(), v.detach())
        return self.resid_dropout(self.c_proj(y))

    def init_kv(self, batch_size, device, dtype):
        z = lambda: torch.zeros(batch_size, self.n_kv_heads, 0, self.head_dim, device=device, dtype=dtype)
        return z(), z()


class GPTMLP(nn.Module):
    def __init__(self, d_model: int, dropout: float = 0.1, bias: bool = False):
        super().__init__()
        self.c_fc = nn.Linear(d_model, 4 * d_model, bias=bias)
        self.gelu = nn.GELU()
        self.c_proj = nn.Linear(4 * d_model, d_model, bias=bias)
        self.dropout = nn.Dropout(dropout)

    def forward(self, x):
        return self.dropout(self.c_proj(self.gelu(self.c_fc(x))))


class GPTBlock(nn.Module):
    """Pre-LN GPT transformer block. Compatible with AuraCore's stateful
    generation interface (forward_with_states / step / init_state).
    Supports GQA, RoPE, QK-norm, and gated MLP (Gemma/Llama compat)."""
    def __init__(self, d_model: int, n_heads: int, dropout: float = 0.1,
                 block_size: int = 512, bias: bool = False, use_rope: bool = False,
                 rope_base: float = 10000.0, gated_mlp: bool = False,
                 dim_feedforward: int = None, head_dim: int = 0,
                 n_kv_heads: int = 0, qk_norm: bool = False):
        super().__init__()
        self.d_model = d_model
        self.block_size = block_size
        self.n_heads = n_heads
        self.use_attn = True  # GPT always uses attention (keeps Hyena compat)
        self.ln_1 = nn.LayerNorm(d_model, bias=bias)
        self.attn = GPTCausalSelfAttention(d_model, n_heads, dropout,
                                            block_size, bias, use_rope, rope_base,
                                            n_kv_heads=n_kv_heads,
                                            head_dim=head_dim, qk_norm=qk_norm)
        self.ln_2 = nn.LayerNorm(d_model, bias=bias)
        dff = dim_feedforward or (d_model * 4)
        self.mlp = (GatedMLP(d_model, dff) if gated_mlp else GPTMLP(d_model, dropout, bias))

    def forward(self, x):
        """Standard forward pass (prefill / training)."""
        x = x + self.attn(self.ln_1(x))
        x = x + self.mlp(self.ln_2(x))
        return x

    def forward_with_cache(self, x):
        """Forward pass that returns KV cache state (for stateful gen)."""
        h = self.ln_1(x)
        attn_out = self.attn(h, use_cache=True)
        # attn with use_cache=True returns (output, kv_tuple) when past_kv is None
        if isinstance(attn_out, tuple):
            attn_out, kv = attn_out
        else:
            kv = None
        x = x + attn_out
        x = x + self.mlp(self.ln_2(x))
        return x, (None, kv)  # (conv_state, kv_cache), conv_state=None for GPT

    def step(self, x, conv_state, kv_cache, pos_idx=0):
        """Single-token forward with KV cache. Matches HyenaBlock.step signature."""
        x_2d = x.unsqueeze(1) if x.dim() == 2 else x
        h = self.ln_1(x_2d)
        attn_out, new_kv = self.attn(h, past_kv=kv_cache, use_cache=True)
        x_2d = x_2d + attn_out
        x_2d = x_2d + self.mlp(self.ln_2(x_2d))
        out = x_2d.squeeze(1) if x.dim() == 2 else x_2d
        return out, None, new_kv  # conv_state=None for GPT

    def init_state(self, batch_size, device, dtype):
        """Return (None, kv_cache) — matches Hyena interface with no conv state."""
        return None, self.attn.init_kv(batch_size, device, dtype)


LayerStates = List


class AuraCore(nn.Module):
    def __init__(self, d_model, n_layers, kernel_size=4, dim_feedforward=None,
                 dropout=0.1, n_heads=4, use_attn=True, max_seq=2048,
                 grad_checkpoint=False, use_rope=True, rope_bases=None,
                 gated_mlp=False, attn_head_dim=0, n_kv_heads=0, qk_norm=False,
                 model_mode="gpt"):
        super().__init__()
        self.use_attn = use_attn
        self.grad_checkpoint = grad_checkpoint
        self.model_mode = model_mode
        if rope_bases is None:
            rope_bases = [10000.0] * n_layers
        elif not isinstance(rope_bases, (list, tuple)):
            rope_bases = [float(rope_bases)] * n_layers
        if model_mode == "gpt":
            # Pure GPT transformer blocks (pre-LN, now with RoPE/GQA/qk_norm/gated MLP)
            self.layers = nn.ModuleList([
                GPTBlock(d_model, n_heads, dropout, max_seq,
                         use_rope=use_rope,
                         rope_base=rope_bases[i % len(rope_bases)] if rope_bases else 10000.0,
                         gated_mlp=gated_mlp, dim_feedforward=dim_feedforward,
                         head_dim=attn_head_dim, n_kv_heads=n_kv_heads, qk_norm=qk_norm)
                for i in range(n_layers)
            ])
        else:
            # Hyena blocks with convolution + optional attention
            self.layers = nn.ModuleList([
                HyenaBlock(d_model, kernel_size, dim_feedforward, dropout, n_heads, use_attn,
                           max_seq, use_rope, rope_base=rope_bases[i % len(rope_bases)],
                           gated_mlp=gated_mlp, attn_head_dim=attn_head_dim,
                           n_kv_heads=n_kv_heads, qk_norm=qk_norm)
                for i in range(n_layers)
            ])

    def forward(self, x):
        # Gradient checkpointing (opt-in via config): recompute each block's
        # activations during backward instead of storing them -> activation
        # memory drops from O(n_layers) to ~O(1) blocks at ~30% extra step time.
        # Only active while training with grad enabled; inference is untouched.
        # NOTE: GPT blocks use SDPA with embedded dropout, which conflicts
        # with checkpoint wrapping (checkpoint counts saved tensors differently
        # between forward and recomputation). Skip checkpoint for GPT mode.
        use_ckpt = (self.grad_checkpoint and self.training
                    and torch.is_grad_enabled() and self.model_mode != "gpt")
        for layer in self.layers:
            if use_ckpt and x.requires_grad:
                x = torch_checkpoint.checkpoint(layer, x, use_reentrant=False)
            else:
                x = layer(x)
        return x

    def forward_with_states(self, x) -> Tuple[torch.Tensor, LayerStates]:
        states: LayerStates = []
        if self.model_mode == "gpt":
            # GPT blocks: capture KV cache during prefill via forward_with_cache
            for layer in self.layers:
                x, state = layer.forward_with_cache(x)
                states.append(state)
            return x, states
        # Hyena blocks: capture conv states + KV cache
        for layer in self.layers:
            h = layer.norm1(x)
            k = layer.kernel_size
            if k > 1:
                need = k - 1
                taken = h[:, -need:, :] if h.size(1) >= need else h
                hist = taken.transpose(1, 2).contiguous()
                if hist.size(2) < need:
                    pad = h.new_zeros(h.size(0), h.size(2), need - hist.size(2))
                    hist = torch.cat([pad, hist], dim=2)
            else:
                hist = h.new_zeros(h.size(0), h.size(2), 0)
            kv = None
            if layer.use_attn and layer.attn is not None:
                B, T, D = x.shape
                a = layer.attn
                qkv = a.c_attn(h)
                q_full, k_full, v_full = qkv.split([a.inner, a.kv_inner, a.kv_inner], dim=2)
                k_full = k_full.view(B, T, a.n_kv_heads, a.head_dim).transpose(1, 2).contiguous()
                v_full = v_full.view(B, T, a.n_kv_heads, a.head_dim).transpose(1, 2).contiguous()
                if a.use_qk_norm:
                    q_tmp = q_full.view(B, T, a.n_heads, a.head_dim).transpose(1, 2)
                    _, k_full = a._apply_qk_norm(q_tmp, k_full)
                k_full = a.rotate_kv_for_cache(k_full)
                if k_full.size(2) > a.max_seq:
                    k_full = k_full[:, :, -a.max_seq:].contiguous()
                    v_full = v_full[:, :, -a.max_seq:].contiguous()
                kv = (k_full, v_full)
            states.append((hist, kv))
            x = layer(x)
        return x, states

    def step(self, x, states: LayerStates, pos_idx: int = 0):
        new_states: LayerStates = []
        for layer, (conv_s, kv) in zip(self.layers, states):
            x, new_conv, new_kv = layer.step(x, conv_s, kv, pos_idx)
            new_states.append((new_conv, new_kv))
        return x, new_states

    def init_states(self, batch_size, device, dtype) -> LayerStates:
        out = []
        if self.model_mode == "gpt":
            # GPTBlock.init_state returns the complete (None, kv_cache) tuple
            for layer in self.layers:
                out.append(layer.init_state(batch_size, device, dtype))
        else:
            for layer in self.layers:
                conv_s = layer.init_state(batch_size, device, dtype)
                kv = layer.attn.init_kv(batch_size, device, dtype) if (layer.use_attn and layer.attn) else None
                out.append((conv_s, kv))
        return out


# =====================================================================
# AURA LM
# =====================================================================
class AuraLM(nn.Module):
    def __init__(self, vocab_size, d_model=384, n_layers=6, kernel_size=4,
                 n_heads=6, dropout=0.1, block_size=256, use_attn=True,
                 grad_checkpoint=False, pos_encoding="rope",
                 rope_base: float = 10000.0, rope_global_every: int = 0,
                 rope_global_base: float = 1000000.0,
                 gated_mlp: bool = False, attn_head_dim: int = 0,
                 n_kv_heads: int = 0, qk_norm: bool = False,
                 ff_dim: int = 0, untie_head: bool = False,
                 model_mode: str = "gpt"):
        super().__init__()
        self.block_size = block_size
        self.vocab_size = vocab_size
        self.d_model = d_model
        self.use_attn = use_attn
        self.pos_encoding = pos_encoding
        self.model_mode = model_mode
        # RoPE: allowed in any mode (GPT + RoPE for modern archs like Gemma/Llama)
        use_rope = (pos_encoding == "rope")
        self.wte = nn.Embedding(vocab_size, d_model)
        # wpe only when using learned positions (not RoPE)
        self.wpe = nn.Embedding(block_size, d_model) if not use_rope else None
        self.drop = nn.Dropout(dropout)
        # Per-layer RoPE bases (gemma/llama variation)
        if rope_global_every and rope_global_every > 0:
            rope_bases = [(rope_global_base if (i + 1) % rope_global_every == 0 else rope_base)
                          for i in range(n_layers)]
        else:
            rope_bases = [rope_base] * n_layers
        self.core = AuraCore(d_model, n_layers, kernel_size, ff_dim or d_model * 4, dropout,
                              n_heads, use_attn, block_size, grad_checkpoint, use_rope or False,
                              rope_bases=rope_bases, gated_mlp=gated_mlp,
                              attn_head_dim=attn_head_dim, n_kv_heads=n_kv_heads,
                              qk_norm=qk_norm, model_mode=model_mode)
        self.ln_f = nn.LayerNorm(d_model)
        self.lm_head = nn.Linear(d_model, vocab_size, bias=False)
        # Always weight tie for GPT mode (standard GPT practice)
        if untie_head and model_mode != "gpt":
            self.untie_head = True
        else:
            self.untie_head = False
            self.wte.weight = self.lm_head.weight
        self.apply(self._init_weights)
        # Re-apply structured inits for Hyena mode
        if model_mode != "gpt":
            for layer in self.core.layers:
                if getattr(layer, "attn", None) is not None:
                    nn.init.zeros_(layer.attn.c_proj.weight)
                nn.init.xavier_normal_(layer.gate.weight, gain=0.1)

    def _init_weights(self, m):
        if isinstance(m, nn.Linear):
            nn.init.normal_(m.weight, 0.0, 0.02)
            if m.bias is not None:
                nn.init.zeros_(m.bias)
        elif isinstance(m, nn.Embedding):
            nn.init.normal_(m.weight, 0.0, 0.02)

    def count_parameters(self):
        return sum(p.numel() for p in self.parameters() if p.requires_grad)

    def forward(self, idx, targets=None):
        B, T = idx.size()
        T = min(T, self.block_size)
        idx = idx[:, -T:]
        if self.wpe is not None:       # legacy learned positions
            pos = torch.arange(T, device=idx.device).unsqueeze(0)
            x = self.drop(self.wte(idx) + self.wpe(pos))
        else:
            x = self.drop(self.wte(idx))   # positions handled by RoPE in attention
        x = self.core(x)
        x = self.ln_f(x)
        logits = self.lm_head(x)
        loss = None
        if targets is not None:
            targets = targets[:, -T:]
            loss = F.cross_entropy(logits.view(-1, logits.size(-1)), targets.reshape(-1))
        return logits, loss

    @staticmethod
    def _top_k_filter(logits, top_k):
        if top_k is not None and top_k > 0:
            k = min(top_k, logits.size(-1))
            v, _ = torch.topk(logits, k)
            logits = logits.clone()
            logits[logits < v[:, [-1]]] = float("-inf")
        return logits

    @torch.inference_mode()   # PERF: faster than no_grad in the token loop
    def generate(self, idx, max_new_tokens, temperature=1.0, top_k=50,
                 stop_token_ids: Optional[List[int]] = None,
                 finish_sentence: bool = False, finish_extra_tokens: int = 40,
                 decode_fn=None, token_callback=None):
        """
        Hard-caps `idx_cond` to block_size BEFORE prefill and frees intermediate
        prefill tensors after states are extracted.
        finish_sentence (item 8, redone): generate the requested budget, then
        continue ONLY until the current sentence terminates (. ! ? ...), checked
        on EVERY token, for at most `finish_extra_tokens` overtime tokens.
        Streaming is incremental (per-token decode append), not O(n^2) re-decode.
        """
        if max_new_tokens < 1:
            return idx, 0
        B, dev, vocab = idx.size(0), idx.device, self.vocab_size
        idx = idx.clamp(0, vocab - 1)
        idx_cond = idx[:, -self.block_size:]
        T_p = idx_cond.size(1)
        if T_p == 0:
            idx_cond = torch.full((B, 1), 198 % vocab, dtype=torch.long, device=dev)
            T_p = 1
        if self.wpe is not None:   # legacy learned positions (exact old behavior)
            pos = torch.arange(T_p, device=dev).unsqueeze(0).clamp(0, self.block_size - 1)
            x = self.drop(self.wte(idx_cond) + self.wpe(pos))
        else:
            x = self.drop(self.wte(idx_cond))
        x, states = self.core.forward_with_states(x)
        # FIX (C8): only the LAST position's logits are needed to sample the
        # next token. Computing lm_head over all prefill positions wasted up to
        # ~1.6GB (200k vocab x 2048 positions) of transient VRAM per generation.
        x_last = self.ln_f(x[:, -1, :])
        logits_last = self.lm_head(x_last)
        del x, x_last

        def sample(l2d):
            l = l2d / max(temperature, 1e-8)
            l = self._top_k_filter(l, top_k)
            if torch.isneginf(l).all():
                l = torch.zeros_like(l)
            p = F.softmax(l, dim=-1)
            p = torch.nan_to_num(p, nan=0.0, posinf=0.0, neginf=0.0).clamp(min=0)
            p = p / p.sum(dim=-1, keepdim=True).clamp(min=1e-12)
            return torch.multinomial(p, 1).clamp(0, vocab - 1)

        next_tok = sample(logits_last)
        del logits_last
        generated = [next_tok]
        pos_idx = T_p   # absolute RoPE position of the next token to be fed

        stream_text = ""
        if decode_fn is not None:
            try:
                stream_text = decode_fn([int(next_tok.item())])
            except Exception:
                stream_text = ""
        if token_callback is not None and stream_text:
            try:
                token_callback(stream_text)
            except Exception:
                pass

        total_budget = max_new_tokens + (max(0, finish_extra_tokens) if finish_sentence else 0)
        for step_i in range(total_budget - 1):
            tok = generated[-1]
            if stop_token_ids and int(tok.item()) in stop_token_ids:
                break
            x_tok = self.wte(tok).squeeze(1)
            if self.wpe is not None:   # legacy learned positions saturate at block_size
                x_tok = x_tok + self.wpe.weight[min(pos_idx, self.block_size - 1)].unsqueeze(0)
            x_tok, states = self.core.step(x_tok, states, pos_idx)
            pos_idx += 1   # RoPE positions grow without bound; trims stay valid (relative)
            x_tok = self.ln_f(x_tok)
            logit = self.lm_head(x_tok)
            next_tok = sample(logit)
            generated.append(next_tok)
            del x_tok, logit

            if decode_fn is not None:
                try:
                    stream_text += decode_fn([int(next_tok.item())])
                except Exception:
                    pass
                if token_callback is not None and (step_i % 2 == 0 or step_i >= total_budget - 2):
                    try:
                        token_callback(stream_text)
                    except Exception:
                        pass
                # finish-sentence: past the requested budget, stop at the first
                # sentence terminator; checked EVERY token, on the decoded tail.
                if finish_sentence and len(generated) >= max_new_tokens:
                    tail = stream_text.rstrip(" \t\n\"'`)]}")
                    if tail.endswith((".", "!", "?", "\u2026")):
                        break

        out = torch.cat([idx, torch.cat(generated, dim=1)], dim=1)
        del states
        return out, len(generated)


# =====================================================================
# LOSS FUNCTIONS (item 9 -- all selectable options have REAL gradients)
#   cross_entropy    : per-token weighted CE (name-prefix emphasis, item 7)
#   label_smoothing  : weighted CE + label smoothing 0.1 -> discourages verbatim
#                      certainty, promotes free-form yet coherent phrasing
#   anti_repetition  : weighted CE + unlikelihood term (Welleck et al. 2019)
#                      that actively pushes probability away from tokens already
#                      used in the recent context -> anti-copying, novel sentences
#   focal            : focal CE (gamma=1.5) -> focuses capacity on hard tokens
# The former 'smart_loss_rules' (a detached constant with ZERO gradient) and
# 'smart_loss_heuristics' (used only batch row 0) were removed as defective
# (review C6). Their text-analysis ideas live on in analyze_text_quality(),
# reported as console metrics after each generation.
# =====================================================================
_COMMON_WORDS_SEED = set("""
the a an is are was were be been being have has had do does did will would could should
may might must can shall of to in for on with at by from as into onto upon over under
and or but nor so yet because although though while if unless until since when where
who whom whose which that this these those it its it's he she they we you i him her
them us my your his her its our their not no yes very much more most less least much
many few some any all each every either neither both several such own same other another
than then there here now today tomorrow yesterday however therefore meanwhile moreover
furthermore nevertheless nonetheless consequently thus hence otherwise instead indeed
about above across after again against along among around before behind below beneath
beside between beyond during except inside near off out outside through toward towards
within without good bad big small new old high low long short great little right wrong
first last next early late important different difficult easy possible able likely sure
happy sad true false real free full open close hard soft light dark quiet loud fast slow
world time people way day man woman child year work life hand part place case week company
system program question government number night point home water room mother area money
story fact month lot study book eye job word business issue side kind head house service
friend father power hour game line end member law car city community name president team
minute idea body information back parent face others level office door health person art
war history party result change morning reason research girl guy moment air teacher force
education
""".split())

def _is_word_token(tok: str) -> bool:
    if not tok:
        return False
    if any(ch.isdigit() for ch in tok):
        return False
    if any(_is_emoji_or_symbol(ch) for ch in tok):
        return False
    stripped = tok.strip(string.punctuation + " ")
    return stripped.isalpha() and len(stripped) > 0


def _ce_sum_chunk(flat_logits, flat_targets):
    # fp32 CE on a chunk; recomputed in backward when checkpointed.
    return F.cross_entropy(flat_logits.float(), flat_targets, reduction="sum")


def compute_loss_default(logits, targets, chunk_size: int = 4096):
    """Cross-entropy computed in row chunks with activation checkpointing.
    With very large vocabularies (o200k = 200k tokens) a single flattened CE
    materializes an extra fp32 (B*T, vocab) log-softmax buffer (~1.6GB at
    seq_len=2048). Chunking + checkpointing caps that transient at
    (chunk_size, vocab) with mathematically identical results."""
    flat_logits = logits.reshape(-1, logits.size(-1))
    flat_targets = targets.reshape(-1)
    n = flat_logits.size(0)
    if n <= chunk_size or not flat_logits.requires_grad:
        return F.cross_entropy(flat_logits.float(), flat_targets)
    total = None
    for i in range(0, n, chunk_size):
        part = torch_checkpoint.checkpoint(
            _ce_sum_chunk, flat_logits[i:i + chunk_size], flat_targets[i:i + chunk_size],
            use_reentrant=False)
        total = part if total is None else total + part
    return total / n


def compute_loss_weighted_ce(logits, targets, token_weights=None,
                             chunk_size: int = 4096, label_smoothing: float = 0.0,
                             codec=None, char_word_freqs: dict = None, char_reward_scale: float = 0.0):
    """Per-token weighted cross-entropy over the FULL batch (real gradients),
    computed in checkpointed chunks (same memory bound as compute_loss_default).
    Used for the name-prefix emphasis (item 7) and label smoothing (item 9)."""
    flat_logits = logits.reshape(-1, logits.size(-1))
    flat_t = targets.reshape(-1)
    w = (token_weights.reshape(-1).float() if token_weights is not None
         else torch.ones_like(flat_t, dtype=torch.float32))
    wsum = w.sum().clamp(min=1e-8)

    def _wce(l, t, wt):
        ce = F.cross_entropy(l.float(), t, reduction="none", label_smoothing=label_smoothing)
        return (ce * wt).sum()

    n = flat_logits.size(0)
    if n <= chunk_size or not flat_logits.requires_grad:
        base = _wce(flat_logits, flat_t, w) / wsum
        # optional char-level word reward shaping
        if codec is not None and getattr(codec, "mode", "") == "char" and char_word_freqs and char_reward_scale:
            try:
                B, T = targets.size(0), targets.size(1)
                logp = F.log_softmax(logits.float(), dim=-1)  # (B,T,V)
                max_freq = max(char_word_freqs.values()) if char_word_freqs else 1
                extra = 0.0
                for b in range(B):
                    trow = targets[b]
                    pos = 0
                    while pos < T:
                        # find next alphabetic run
                        ch_id = int(trow[pos].item())
                        ch = codec.id_to_char[ch_id] if 0 <= ch_id < len(codec.id_to_char) else ''
                        if ch.isalpha():
                            start = pos
                            while pos < T:
                                cid = int(trow[pos].item())
                                cch = codec.id_to_char[cid] if 0 <= cid < len(codec.id_to_char) else ''
                                if not cch.isalpha():
                                    break
                                pos += 1
                            end = pos
                            if end > start:
                                ids = trow[start:end]
                                try:
                                    word = ''.join(codec.id_to_char[int(i.item())] for i in ids).lower()
                                except Exception:
                                    word = ''
                                freq = char_word_freqs.get(word, 0)
                                if freq > 0:
                                    # joint log-prob of the exact word span
                                    span_logp = logp[b, start:end, :].gather(1, ids.view(-1, 1)).squeeze().sum()
                                    weight = float(freq) / float(max_freq)
                                    # reward = -alpha * weight * product_prob (torch.exp(span_logp))
                                    extra = extra - float(char_reward_scale) * weight * torch.exp(span_logp)
                        else:
                            pos += 1
                return base + extra
            except Exception:
                # if anything goes wrong, fall back to base loss
                return base
        return base
    total = None
    for i in range(0, n, chunk_size):
        part = torch_checkpoint.checkpoint(
            _wce, flat_logits[i:i + chunk_size], flat_t[i:i + chunk_size], w[i:i + chunk_size],
            use_reentrant=False)
        total = part if total is None else total + part
    return total / wsum


def compute_loss_focal(logits, targets, token_weights=None, gamma: float = 1.5,
                       chunk_size: int = 4096):
    """Focal cross-entropy: down-weights already-confident tokens, focusing
    learning on the hard parts of the corpus. Real gradients, chunked."""
    flat_logits = logits.reshape(-1, logits.size(-1))
    flat_t = targets.reshape(-1)
    w = (token_weights.reshape(-1).float() if token_weights is not None
         else torch.ones_like(flat_t, dtype=torch.float32))
    wsum = w.sum().clamp(min=1e-8)

    def _focal(l, t, wt):
        ce = F.cross_entropy(l.float(), t, reduction="none")
        pt = torch.exp(-ce)
        return (((1.0 - pt) ** gamma) * ce * wt).sum()

    n = flat_logits.size(0)
    if n <= chunk_size or not flat_logits.requires_grad:
        return _focal(flat_logits, flat_t, w) / wsum
    total = None
    for i in range(0, n, chunk_size):
        part = torch_checkpoint.checkpoint(
            _focal, flat_logits[i:i + chunk_size], flat_t[i:i + chunk_size], w[i:i + chunk_size],
            use_reentrant=False)
        total = part if total is None else total + part
    return total / wsum


def compute_unlikelihood_term(logits, targets, n_positions: int = 64, window: int = 64):
    """Unlikelihood term (Welleck et al. 2019): penalizes probability assigned to
    tokens that already occurred in the recent context (unless they ARE the
    target) -> the model keeps CE accuracy while being pushed AWAY from copying
    the training data verbatim, encouraging novel-yet-coherent phrasing.
    Sampled at n_positions random positions per row to bound memory/compute."""
    B, T, V = logits.shape
    if T < 2:
        return logits.sum() * 0.0
    total, count = None, 0
    for b in range(B):
        n_pos = min(n_positions, T - 1)
        t_idx = torch.randint(1, T, (n_pos,), device=logits.device)
        logp = F.log_softmax(logits[b, t_idx].float(), dim=-1)   # (P, V) transient
        for j in range(n_pos):
            t = int(t_idx[j])
            lo = max(0, t - window)
            prev = targets[b, lo:t]
            prev = prev[prev != targets[b, t]]
            if prev.numel() == 0:
                continue
            p = logp[j, prev.unique()].exp().clamp(max=1.0 - 1e-4)
            term = -torch.log1p(-p).mean()
            total = term if total is None else total + term
            count += 1
    if total is None or count == 0:
        return logits.sum() * 0.0
    return total / count


def analyze_text_quality(text: str) -> Dict[str, float]:
    """Heuristic text analytics (item 9), reported as CONSOLE METRICS -- never a
    fake constant loss: repeated-3-gram rate, distinct-2 diversity, sentence
    length variety, and common-word coverage."""
    words = [w.lower() for w in re.findall(r"[A-Za-z']+", text)]
    out = {"words": float(len(words)), "rep3": 0.0, "distinct2": 1.0,
           "len_var": 0.0, "common_frac": 0.0}
    if len(words) >= 3:
        tri = [tuple(words[i:i + 3]) for i in range(len(words) - 2)]
        out["rep3"] = 1.0 - len(set(tri)) / max(1, len(tri))
    if len(words) >= 2:
        bi = [tuple(words[i:i + 2]) for i in range(len(words) - 1)]
        out["distinct2"] = len(set(bi)) / max(1, len(bi))
    sentences = [s for s in re.split(r"(?<=[.!?])\s+", text.strip()) if s]
    lengths = [len(s.split()) for s in sentences]
    if len(lengths) > 1:
        out["len_var"] = (max(lengths) - min(lengths)) / max(1, max(lengths))
    if words:
        out["common_frac"] = sum(1 for w in words if w in _COMMON_WORDS_SEED) / len(words)
    return out


_SENT_END_RE = re.compile(r"[.!?\u2026][\"'\)\]]*")


def trim_to_sentence_end(text: str) -> str:
    """Item 8: drop a trailing partial sentence -- keep text up to the LAST
    sentence terminator (incl. closing quotes/brackets). If no terminator
    exists at all, the text is returned unchanged."""
    if not text:
        return text
    last = None
    for m in _SENT_END_RE.finditer(text):
        last = m
    return text[:last.end()] if last is not None else text


LOSS_FN_OPTIONS = ["cross_entropy", "label_smoothing", "anti_repetition", "focal"]
_LEGACY_LOSS_NAMES = {"cross_entropy_default", "smart_loss_heuristics", "smart_loss_rules"}


# =====================================================================
# CONFIG
# =====================================================================
@dataclass
class Config:
    d_model: int = 384
    n_layers: int = 6
    n_heads: int = 6
    kernel_size: int = 4
    dropout: float = 0.1
    learning_rate: float = 3e-4
    min_lr: float = 3e-5
    warmup_epochs: int = 1
    batch_size: int = 8
    grad_accumulation_steps: int = 1
    epochs: int = 10
    seq_len: int = 256
    encoding: str = "cl100k_base"
    memory_mode: str = "auto"
    training_file: str = "input.txt"
    checkpoint_dir: str = "checkpoints"
    cache_dir: str = ".cache"
    save_every: int = 1
    train_dtype: str = "amp_bf16"
    grad_checkpoint: bool = True
    multi_gpu: bool = False
    ewc_lambda: float = 0.0
    ewc_samples: int = 16
    send_only_recent: bool = True
    parse_markdown: bool = True
    use_transformer_attention: bool = True
    gen_steps: int = 120
    temperature: float = 0.8
    top_k: int = 50
    continue_file: str = ""
    continue_epochs: int = 5
    device: str = "cuda" if torch.cuda.is_available() else "cpu"

    # ---- v11 additions ----
    meta_generate: bool = False
    astralis_max_kb: float = 24.0
    meta_scratchpad_mode: str = "cpu_gpu"          # cpu_gpu | cpu_only | gpu_only
    finish_sentence: bool = False
    gpu_only_guard: bool = False
    stop_loss: float = 0.0                          # 0 = disabled
    loss_fn: str = "cross_entropy"                  # see LOSS_FN_OPTIONS
    # Character-level reward shaping: scale of extra reward for reconstructing
    # frequent words when using the `char` encoding (0.0 = disabled)
    char_reward_scale: float = 0.1

    # ---- v12 additions ----
    user_name: str = "Aria"                         # item 7: chat identity
    assistant_name: str = "Aura"
    system_prompt: str = ""                         # always prepended before the messages
    prefix_loss_weight: float = 2.0                 # extra CE weight on name-prefix tokens
    finish_max_extra: int = 40                      # item 8: overtime token cap
    keep_checkpoints: int = 5                       # E2: rotate epoch checkpoints, keep last N
    pos_encoding: str = "rope"                      # rope (dynamic ctx) | learned (legacy wpe)
    rope_base: float = 10000.0                      # RoPE theta (llama=1e4, gemma global=1e6)
    rope_global_every: int = 0                      # 0=uniform; N=every Nth layer uses rope_global_base
    rope_global_base: float = 1000000.0             # theta for the global layers (gemma3=1e6)
    # ---- exact-transplant architecture (GGUF conversions) ----
    ff_dim: int = 0                                 # 0 = d_model*4 (Aura default)
    attn_head_dim: int = 0                          # 0 = d_model/n_heads
    n_kv_heads: int = 0                             # 0 = n_heads (MHA); <n_heads = GQA
    qk_norm: bool = False                           # gemma per-head RMSNorm on q/k
    gated_mlp: bool = False                         # GLU MLP (llama/gemma) vs up-only FFN
    untie_head: bool = False                        # separate lm_head from wte

    # ---- model mode: "gpt" (pure transformer) or "hyena" (hyena-hierarchy) ----
    model_mode: str = "gpt"

    # ---- OpenAI-compatible API server (item 16) ----
    api_enabled: bool = False
    api_host: str = "127.0.0.1"
    api_port: int = 8000
    api_key: str = ""                               # empty = no auth required

    def validate(self):
        if self.model_mode not in ("gpt", "hyena"):
            self.model_mode = "gpt"
        if self.n_heads < 1:
            self.n_heads = 1
        if self.d_model < self.n_heads:
            self.n_heads = 1
        if self.d_model % self.n_heads != 0:
            for h in range(self.n_heads, 0, -1):
                if self.d_model % h == 0:
                    self.n_heads = h
                    break
        if self.batch_size < 1:
            self.batch_size = 1
        if self.seq_len < self.kernel_size:
            self.seq_len = self.kernel_size
        if self.memory_mode not in ("auto", "vram", "ram"):
            self.memory_mode = "auto"
        if self.grad_accumulation_steps < 1:
            self.grad_accumulation_steps = 1
        if self.train_dtype not in ("amp_bf16", "amp_fp16", "bf16", "fp16", "fp32", "q8", "q4"):
            self.train_dtype = "amp_bf16"
        if not (self.encoding in ("cl100k_base", "gpt2", "o200k_base")
                or str(self.encoding).startswith("gguf")):
            self.encoding = "cl100k_base"
        if self.meta_scratchpad_mode not in MetaScratchpad.MODES:
            self.meta_scratchpad_mode = "cpu_gpu"
        if self.loss_fn in _LEGACY_LOSS_NAMES:
            self.loss_fn = "cross_entropy"          # legacy/placebo names remapped
        if self.loss_fn not in LOSS_FN_OPTIONS:
            self.loss_fn = "cross_entropy"
        if not str(self.user_name).strip():
            self.user_name = "Aria"
        if not str(self.assistant_name).strip():
            self.assistant_name = "Aura"
        if self.prefix_loss_weight < 1.0:
            self.prefix_loss_weight = 1.0
        if self.finish_max_extra < 0:
            self.finish_max_extra = 0
        if self.keep_checkpoints < 1:
            self.keep_checkpoints = 1
        if self.pos_encoding not in ("rope", "learned"):
            self.pos_encoding = "rope"
        try:
            self.rope_base = float(self.rope_base)
        except Exception:
            self.rope_base = 10000.0
        if self.rope_base <= 0:
            self.rope_base = 10000.0
        try:
            self.rope_global_base = float(self.rope_global_base)
        except Exception:
            self.rope_global_base = 1000000.0
        if self.rope_global_base <= 0:
            self.rope_global_base = 1000000.0
        try:
            self.rope_global_every = int(self.rope_global_every)
        except Exception:
            self.rope_global_every = 0
        if self.rope_global_every < 0:
            self.rope_global_every = 0
        for _f in ("ff_dim", "attn_head_dim", "n_kv_heads"):
            try:
                setattr(self, _f, int(getattr(self, _f)))
            except Exception:
                setattr(self, _f, 0)
            if getattr(self, _f) < 0:
                setattr(self, _f, 0)
        try:
            self.api_port = int(self.api_port)
        except Exception:
            self.api_port = 8000
        if not (1 <= self.api_port <= 65535):
            self.api_port = 8000
        if self.astralis_max_kb < 1:
            self.astralis_max_kb = 1
        if self.stop_loss < 0:
            self.stop_loss = 0.0



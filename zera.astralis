def load_or_create_config(mgr: SettingsManager) -> Config:
    cfg = Config()
    data = mgr.load()
    if data:
        for k, v in data.items():
            if hasattr(cfg, k) and k != "device":
                setattr(cfg, k, v)
        cfg.validate()
        # Item 15: persist newly-introduced settings (with sensible defaults)
        # exactly once, so the file always carries the full schema.
        merged = asdict(cfg); merged.pop("device", None)
        if set(merged.keys()) - set(data.keys()):
            mgr.save(merged)
    else:
        d = asdict(cfg); d.pop("device", None)
        mgr.save(d)
    return cfg


def save_config(mgr: SettingsManager, cfg: Config):
    d = asdict(cfg)
    d.pop("device", None)
    mgr.save(d)


def count_model_params(cfg: Config, vocab_size: int) -> Tuple[int, int]:
    """Returns (total_params, linear_params). Mirrors AuraLM construction exactly."""
    d, L, k, h = cfg.d_model, cfg.n_layers, cfg.kernel_size, max(1, cfg.n_heads)
    dff = d * 4
    embed = vocab_size * d                # wte tied with lm_head -> ONE tensor
    pos = cfg.seq_len * d                 # GPT mode always has wpe; hyena uses learned when configured
    if cfg.model_mode != "gpt" and getattr(cfg, "pos_encoding", "rope") != "learned":
        pos = 0
    if cfg.model_mode == "gpt":
        # GPT: no conv, no gate; uses full attention
        per_layer_linear = 3 * d * d + d * d          # c_attn + c_proj (bias=False)
        per_layer_linear += d * dff + dff + dff * d + d  # ffn up+down (bias=True)
        norms = 2 * (2 * d)                            # norm1 + norm2 (w+b each)
        per_layer = per_layer_linear + norms
    else:
        per_layer_linear = 0
        if cfg.use_transformer_attention:
            per_layer_linear += 3 * d * d + d * d      # c_attn + c_proj
        per_layer_linear += d * d + d                  # gate (w+b)
        per_layer_linear += d * dff + dff + dff * d + d  # ffn up+down
        conv = d * (d // h) * k + d                    # grouped conv (w+b)
        norms = 2 * (2 * d)                            # norm1 + norm2 (w+b each)
        per_layer = per_layer_linear + conv + norms
    total = embed + pos + per_layer * L + 2 * d        # + ln_f (w+b)
    return int(total), int(per_layer_linear * L)


def predict_vram_usage(cfg: Config, vocab_size: int) -> Dict[str, float]:
    """Predicted TRAINING VRAM (bytes), derived from the actual implementation:
    weights + grads + AdamW moments (per dtype policy), activations (respecting
    gradient checkpointing), the logits + chunked-CE workspace, and CUDA context
    overhead, with a +15% allocator/fragmentation margin ('low'..'high' band)."""
    total_params, linear_params = count_model_params(cfg, vocab_size)
    other_params = total_params - linear_params
    dt = cfg.train_dtype
    if dt in ("amp_bf16", "amp_fp16", "fp32"):
        w_lin = w_oth = 4                    # fp32 master weights
        train_lin = train_oth = 12           # grads(4) + 2 fp32 AdamW moments(8)
        act_bytes = 4 if dt == "fp32" else 2
    elif dt in ("bf16", "fp16"):
        w_lin = w_oth = 2
        train_lin = train_oth = 6            # grads(2) + moments(4), low-precision
        act_bytes = 2
    elif dt == "q8":
        w_lin, w_oth = 1, 4
        train_lin, train_oth = 0, 12         # frozen quantized linears
        act_bytes = 2
    else:  # q4
        w_lin, w_oth = 0.55, 4               # nf4 + quant-state overhead
        train_lin, train_oth = 0, 12
        act_bytes = 2

    weights = linear_params * w_lin + other_params * w_oth
    optim_grads = linear_params * train_lin + other_params * train_oth

    d, L = cfg.d_model, cfg.n_layers
    B, T = max(1, cfg.batch_size), max(1, cfg.seq_len)
    if cfg.model_mode == "gpt":
        # GPT: per-layer activations are attn_out(d) + mlp_hidden(4d) + residuals(2d) + ln(2d)
        per_layer_act = 9 * d * act_bytes
    else:
        # Hyena: per-layer activations include conv + attn + gate + mlp + norms + residuals
        per_layer_act = 24 * d * act_bytes
    if cfg.grad_checkpoint:
        activations = B * T * (2 * d * act_bytes * L + per_layer_act)  # inputs + 1 live layer
    else:
        activations = B * T * per_layer_act * L
    # logits fwd + logits grad + chunked-CE fp32 workspace (capped at chunk rows)
    logits = B * T * vocab_size * act_bytes * 2 + 4096 * vocab_size * 4
    context = 600 * 1024 * 1024              # CUDA context + cuBLAS/cuDNN workspaces
    subtotal = weights + optim_grads + activations + logits + context
    return {
        "params": float(total_params),
        "weights": float(weights), "optimizer": float(optim_grads),
        "activations": float(activations), "logits": float(logits),
        "context": float(context),
        "total": float(subtotal * 1.15), "low": float(subtotal), "high": float(subtotal * 1.30),
    }


def estimate_model_vram_bytes(cfg: Config, vocab_size: int) -> int:
    # FIX (C3): the old formula computed FFN params as d*d*dff*2 -- a factor-
    # d_model overestimate (~3000x at d=3025) that made the GPU-only guard
    # useless. Now derived from the real layer shapes via predict_vram_usage().
    return int(predict_vram_usage(cfg, vocab_size)["total"])


def predict_inference_vram_usage(cfg: Config, vocab_size: int) -> Dict[str, float]:
    """Estimate INFERENCE VRAM (bytes) for the given settings.
    Includes weight storage, KV cache for autoregressive decoding, a small
    activation working set, logits workspace and CUDA context overhead.
    This is intentionally conservative but far smaller than the training estimate.
    """
    total_params, linear_params = count_model_params(cfg, vocab_size)
    other_params = total_params - linear_params
    dt = cfg.train_dtype
    if dt in ("amp_bf16", "amp_fp16", "fp32"):
        w_lin = w_oth = 4
        act_bytes = 4 if dt == "fp32" else 2
    elif dt in ("bf16", "fp16"):
        w_lin = w_oth = 2
        act_bytes = 2
    elif dt == "q8":
        w_lin, w_oth = 1, 4
        act_bytes = 2
    else:  # q4
        w_lin, w_oth = 0.55, 4
        act_bytes = 2

    weights = linear_params * w_lin + other_params * w_oth

    d, L = cfg.d_model, cfg.n_layers
    B, T = max(1, cfg.batch_size), max(1, cfg.seq_len)

    # KV cache: store keys+values for each layer for autoregressive decoding
    # approx: 2 * T * d * L * act_bytes
    kv_cache = 2 * T * d * L * act_bytes

    # Small live activation working set for a single forward step (conservative)
    per_step_act = 4 * d * act_bytes * L
    activations = B * per_step_act

    # Logits workspace (single forward) - conservative upper bound
    logits = B * T * vocab_size * act_bytes

    context = 600 * 1024 * 1024
    subtotal = weights + kv_cache + activations + logits + context
    return {
        "weights": float(weights),
        "kv_cache": float(kv_cache),
        "activations": float(activations),
        "logits": float(logits),
        "context": float(context),
        "total": float(subtotal),
        "with_margin": float(subtotal * 1.05),
    }


def format_vram_report(cfg: Config, vocab_size: int) -> str:
    """Return a multiline human-readable VRAM report (training + inference)."""
    train = predict_vram_usage(cfg, vocab_size)
    infer = predict_inference_vram_usage(cfg, vocab_size)

    def gb(x):
        return f"{x / (1024**3):.2f} GB"

    lines = []
    lines.append(f"TRAINING estimate: {gb(train['total'])} (low {gb(train['low'])} – high {gb(train['high'])})")
    lines.append(f"  weights: {gb(train['weights'])}, optimizer: {gb(train['optimizer'])}")
    lines.append(f"  activations: {gb(train['activations'])}, logits: {gb(train['logits'])}")
    lines.append(f"INFERENCE estimate (seq_len={cfg.seq_len}): {gb(infer['with_margin'])} (raw {gb(infer['total'])})")
    lines.append(f"  weights: {gb(infer['weights'])}, kv_cache: {gb(infer['kv_cache'])}")
    lines.append(f"  activations: {gb(infer['activations'])}, logits: {gb(infer['logits'])}")
    return "\n".join(lines)


def get_available_gpu_bytes() -> Optional[int]:
    if not torch.cuda.is_available():
        return None
    try:
        free, total = torch.cuda.mem_get_info()
        return free
    except Exception:
        return None


# =====================================================================
# GGUF -> AURA TRANSPLANT (unchanged from v10)
# =====================================================================
def _gguf_to_torch(tensor_data, qtype):
    import numpy as np
    import gguf as _gguf
    qt = _gguf.GGMLQuantizationType
    if qtype in (qt.F32, qt.F16, qt.BF16, qt.F64):
        return torch.from_numpy(tensor_data.astype(np.float32))
    if qtype in (qt.I8, qt.I16, qt.I32, qt.I64):
        return torch.from_numpy(tensor_data.astype(np.int64))
    deq = _gguf.dequantize(tensor_data, qtype).astype(np.float32)
    return torch.from_numpy(deq)


def _adapt(w: torch.Tensor, target_shape) -> torch.Tensor:
    if tuple(w.shape) == tuple(target_shape):
        return w.clone()
    if w.dim() == 2 and len(target_shape) == 2:
        return F.interpolate(w.unsqueeze(0).unsqueeze(0).float(), size=target_shape,
                              mode="bilinear", align_corners=False).squeeze(0).squeeze(0)
    if w.dim() == 1 and len(target_shape) == 1:
        t = target_shape[0]
        if w.size(0) >= t:
            return w[:t].clone()
        out = torch.zeros(t, dtype=w.dtype)
        out[:w.size(0)] = w
        return out
    if w.dim() == 3 and len(target_shape) == 3:
        src_k, tgt_k = w.size(2), target_shape[2]
        w2 = F.interpolate(w.float().permute(2, 0, 1).unsqueeze(0),
                            size=(target_shape[0], target_shape[1]),
                            mode="bilinear", align_corners=False).squeeze(0).permute(1, 2, 0)
        if w2.size(2) == tgt_k:
            return w2
        if w2.size(2) > tgt_k:
            return w2[:, :, :tgt_k]
        out = torch.zeros(target_shape[0], target_shape[1], tgt_k, dtype=w.dtype)
        out[:, :, :w2.size(2)] = w2
        return out
    src_flat = w.reshape(-1).float()
    tgt_numel = 1
    for s in target_shape:
        tgt_numel *= s
    if src_flat.numel() >= tgt_numel:
        return src_flat[:tgt_numel].reshape(target_shape)
    out = torch.zeros(tgt_numel)
    out[:src_flat.numel()] = src_flat
    return out.reshape(target_shape)


def _svd_conv_kernel(wq, wk, wv, d_aura, kernel_size, n_heads, decay=0.5):
    d_src = wq.shape[1]
    stacked = torch.cat([wq.float(), wk.float(), wv.float()], dim=0)
    try:
        U, S, Vt = torch.linalg.svd(stacked, full_matrices=False)
    except Exception:
        Vt = torch.eye(d_src)
        S = torch.ones(d_src)
    s_scale = S / (S.max() + 1e-8)
    Vt_scaled = (Vt * s_scale.unsqueeze(1)).float()
    Vt_aura = _adapt(Vt_scaled, (d_aura, d_aura))
    group_size = d_aura // n_heads
    kernel = torch.zeros(d_aura, group_size, kernel_size)
    for j in range(kernel_size):
        scale = decay ** j
        for h in range(n_heads):
            o = h * group_size
            kernel[o:o + group_size, :, j] = scale * Vt_aura[o:o + group_size, o:o + group_size]
    return kernel


def _find_tensor(tensors, *patterns):
    for pat in patterns:
        for k, v in tensors.items():
            if pat.lower() in k.lower():
                return v
    return None


def _find_layer_tensor(tensors, layer_idx, *patterns):
    prefixes = [f"blk.{layer_idx}.", f"model.layers.{layer_idx}.",
                f"transformer.h.{layer_idx}.", f"layers.{layer_idx}.", f"h.{layer_idx}."]
    for pat in patterns:
        for k, v in tensors.items():
            kl = k.lower()
            for pfx in prefixes:
                if pfx.lower() in kl and pat.lower() in kl:
                    return v
    return None


def _ensure_2d(w):
    if w is None:
        return None
    if w.dim() > 2:
        return w.reshape(w.shape[0], -1)
    return w


def read_gguf_tensors(path, log=print):
    import gguf as _gguf
    log(f"[GGUF] opening {path}")
    reader = _gguf.GGUFReader(path, mode="r")
    tensors = {}
    for t in reader.tensors:
        try:
            tensors[t.name] = _gguf_to_torch(t.data, t.tensor_type)
        except Exception as e:
            log(f"  [WARN] skip {t.name}: {e}")
    log(f"[GGUF] loaded {len(tensors)} tensors")
    return tensors


def convert_gguf_to_aura(gguf_path, output_path, cfg: Config, log=print):
    def _convert_impl(gguf_path, output_path, cfg: Config, log=print):
        log("=" * 70)
        log(f"GGUF -> Aura conversion   src={gguf_path}  dst={output_path}")
        log("=" * 70)
    
        # ---- 1) metadata + tokenizer FIRST: the GGUF itself answers
        # "how large does the model need to be" -- dims are auto-derived, the
        # user's settings values are only a fallback when metadata is missing.
        meta, gguf_codec = read_gguf_metadata(gguf_path, log=log)
        arch = meta.get("arch", "")
        log(f"[GGUF] arch={arch or '?'} name={meta.get('name','?')} "
            f"d_model={meta.get('d_model')} layers={meta.get('n_layers')} "
            f"heads={meta.get('n_heads')} ff={meta.get('ff')} ctx={meta.get('ctx')}")
        for field, key in (("d_model", "d_model"), ("n_layers", "n_layers"), ("n_heads", "n_heads")):
            mv = meta.get(key) or 0
            if mv > 0 and getattr(cfg, field) != mv:
                log(f"[auto-size] {field}: settings={getattr(cfg, field)} -> gguf={mv} (auto-corrected)")
                setattr(cfg, field, mv)
        # RoPE theta: gemma3 alternates 5 local layers (1e4) with every-6th global
        # layer (rope.freq_base, usually 1e6); other archs use a uniform base.
        if arch.startswith("gemma3"):
            cfg.rope_base, cfg.rope_global_every, cfg.rope_global_base = 10000.0, 6, meta["rope_base"]
            log(f"[rope] gemma3 pattern: local theta=10000, global theta={meta['rope_base']:.0f} every 6th layer")
        elif abs(meta.get("rope_base", 10000.0) - 10000.0) > 1e-6:
            cfg.rope_base, cfg.rope_global_every = meta["rope_base"], 0
            log(f"[rope] uniform theta={cfg.rope_base:.0f} (from GGUF metadata)")
    
        # ---- 2) Architecture detection: pure transformer (GPTBlock) vs hyena (HyenaBlock)
        PURE_TRANSFORMER_ARCHS = {"gpt2", "gpt3", "gptj", "gemma", "gemma2", "gemma3",
                                   "llama", "mistral", "phi", "phi3", "stablelm", "falcon"}
        is_pure = (arch in PURE_TRANSFORMER_ARCHS)
        if is_pure:
            cfg.model_mode = "gpt"
            cfg.gated_mlp = True   # gemma/llama both use gated GLU
            cfg.pos_encoding = "rope"
            cfg.qk_norm = arch.startswith("gemma")
            nkv = meta.get("n_kv_heads", 0)
            if nkv and 0 < nkv < cfg.n_heads:
                cfg.n_kv_heads = nkv
            hd = meta.get("head_dim", 0)
            if hd:
                cfg.attn_head_dim = hd
            cfg.ff_dim = meta.get("ff", 0) or (cfg.d_model * 4)
            log(f"[arch] pure transformer detected -> GPT mode "
                f"(gated_mlp={cfg.gated_mlp} qk_norm={cfg.qk_norm} "
                f"n_kv_heads={cfg.n_kv_heads} head_dim={cfg.attn_head_dim})")
        else:
            cfg.model_mode = "hyena"
            log("[arch] hyena/hybrid mode (HyenaBlock + optional attention)")
        cfg.validate()
    
        if gguf_codec is not None:
            codec = gguf_codec
            cfg.encoding = codec.encoding_name          # e.g. "gguf:gemma3"
            log(f"[tokenizer] GGUF-native unigram vocab={codec.vocab_size:,} "
                f"(IDs round-trip 1:1 with the source model)")
        else:
            codec = TiktokenCodec(cfg.encoding)
            log(f"[tokenizer] WARNING: no GGUF vocab found; tiktoken '{cfg.encoding}' "
                f"fallback -- embedding rows will be interpolated (quality loss)")
    
        tensors = read_gguf_tensors(gguf_path, log=log)
        model = AuraLM(codec.vocab_size, cfg.d_model, cfg.n_layers, cfg.kernel_size,
                        cfg.n_heads, cfg.dropout, cfg.seq_len, cfg.use_transformer_attention,
                        grad_checkpoint=cfg.grad_checkpoint,
                        pos_encoding=cfg.pos_encoding,
                        rope_base=cfg.rope_base, rope_global_every=cfg.rope_global_every,
                        rope_global_base=cfg.rope_global_base,
                        gated_mlp=cfg.gated_mlp, attn_head_dim=cfg.attn_head_dim,
                        n_kv_heads=cfg.n_kv_heads, qk_norm=cfg.qk_norm,
                        ff_dim=cfg.ff_dim,
                        model_mode=cfg.model_mode)
        log(f"Aura model: {model.count_parameters():,} params "
            f"(d_model={cfg.d_model}, layers={cfg.n_layers}, heads={cfg.n_heads}, "
            f"vocab={codec.vocab_size:,})")
        dz = cfg.d_model
        dff = cfg.ff_dim or (cfg.d_model * 4)
    
        # Gemma stores RMSNorm weights as OFFSETS from 1.0 (scale = 1 + w);
        # copying them raw zeroes the signal -> garbled output. Llama-style
        # RMSNorm weights are already absolute scales (offset 0).
        norm_offset = 1.0 if arch.startswith("gemma") else 0.0
        if norm_offset:
            log("[norms] gemma RMSNorm detected -> adding +1.0 offset to all norm weights")
    
        emb_w = _find_tensor(tensors, "token_embd.weight", "token_emb.weight",
                              "embed_tokens.weight", "wte.weight")
        if emb_w is not None:
            emb_w = emb_w.float()
            if emb_w.shape[0] == codec.vocab_size:
                adapted = emb_w.clone()      # exact 1:1 copy -- the common case now
            else:
                adapted = _adapt(emb_w, (codec.vocab_size, dz))
                log(f"  [warn] vocab mismatch {emb_w.shape[0]} vs {codec.vocab_size}; interpolated")
            with torch.no_grad():
                model.wte.weight.copy_(adapted)
                model.lm_head.weight = model.wte.weight
            log(f"embedding {tuple(emb_w.shape)} -> ({codec.vocab_size},{dz})")
    
        ln_w = _find_tensor(tensors, "output_norm.weight", "norm.weight", "ln_f.weight")
        if ln_w is not None:
            with torch.no_grad():
                model.ln_f.weight.copy_(_adapt(ln_w.float(), (dz,)) + norm_offset)
    
        detected = set()
        for k in tensors:
            for pfx in ("blk.", "model.layers.", "transformer.h.", "layers.", "h."):
                if pfx in k.lower():
                    try:
                        detected.add(int(k.lower().split(pfx)[1].split(".")[0]))
                    except Exception:
                        pass
        n_src = max(detected) + 1 if detected else cfg.n_layers
        log(f"detected {n_src} source layers -> mapping to {cfg.n_layers} Aura layers")
    
        for zi in range(cfg.n_layers):
            si = int(round(zi * (n_src - 1) / max(cfg.n_layers - 1, 1))) if cfg.n_layers > 1 else 0
            block = model.core.layers[zi]
    
            wq = _ensure_2d(_find_layer_tensor(tensors, si, "attn_q.weight", "self_attn.q_proj.weight", "q_proj.weight"))
            wk = _ensure_2d(_find_layer_tensor(tensors, si, "attn_k.weight", "self_attn.k_proj.weight", "k_proj.weight"))
            wv = _ensure_2d(_find_layer_tensor(tensors, si, "attn_v.weight", "self_attn.v_proj.weight", "v_proj.weight"))
            wo = _ensure_2d(_find_layer_tensor(tensors, si, "attn_output.weight", "self_attn.o_proj.weight", "o_proj.weight"))
            c_attn = _ensure_2d(_find_layer_tensor(tensors, si, "attn.c_attn.weight", "c_attn.weight"))
            if c_attn is not None and wq is None:
                d = c_attn.shape[0] // 3
                wq, wk, wv = c_attn[:d], c_attn[d:2*d], c_attn[2*d:]
    
            if isinstance(block, GPTBlock):
                # ---- GPT MODE: direct-weight transplant (no conv SVD) ----
                # GGUF stores weights as (in, out); PyTorch Linear is (out, in).
                # Transpose before _adapt so bilinear mapping respects dimensions.
                # Each Q/K/V adapted to its own sub-slice, then cat'd ONCE on dim 0.
                if wq is not None:
                    wk = wk if wk is not None else wq.clone()
                    wv = wv if wv is not None else wq.clone()
                    attn = block.attn
                    qs = _adapt(wq.float().t().contiguous(), (attn.inner, dz))
                    ks = _adapt(wk.float().t().contiguous(), (attn.kv_inner, dz))
                    vs = _adapt(wv.float().t().contiguous(), (attn.kv_inner, dz))
                    fused = torch.cat([qs, ks, vs], dim=0)
                    with torch.no_grad():
                        attn.c_attn.weight.copy_(fused)
                if wo is not None:
                    tgt = block.attn.c_proj.weight
                    with torch.no_grad():
                        tgt.copy_(_adapt(wo.float().t().contiguous(), tgt.shape))
    
                # FFN / MLP (GGUF: (in,out); PyTorch Linear: (out,in) -> .t() first)
                ffn_gate = _ensure_2d(_find_layer_tensor(tensors, si, "ffn_gate.weight", "mlp.gate_proj.weight"))
                ffn_up = _ensure_2d(_find_layer_tensor(tensors, si, "ffn_up.weight", "mlp.up_proj.weight"))
                ffn_dn = _ensure_2d(_find_layer_tensor(tensors, si, "ffn_down.weight", "mlp.down_proj.weight", "fc2.weight"))
                mlp = block.mlp
                for src, attr in [(ffn_gate, 'gate_proj'), (ffn_up, 'up_proj')]:
                    if src is not None and hasattr(mlp, attr):
                        tgt_w = getattr(mlp, attr).weight
                        with torch.no_grad():
                            tgt_w.copy_(_adapt(src.float().t().contiguous(), tgt_w.shape))
                    elif src is not None and attr == 'gate_proj':
                        pass  # non-gated MLP ignores gate_proj
                if ffn_dn is not None and hasattr(mlp, 'down_proj'):
                    tgt_w = mlp.down_proj.weight
                    with torch.no_grad():
                        tgt_w.copy_(_adapt(ffn_dn.float().t().contiguous(), tgt_w.shape))
                elif ffn_dn is not None and hasattr(mlp, 'c_proj'):
                    tgt_w = mlp.c_proj.weight
                    with torch.no_grad():
                        tgt_w.copy_(_adapt(ffn_dn.float().t().contiguous(), tgt_w.shape))
    
                ln1_gpt = _find_layer_tensor(tensors, si, "attn_norm.weight", "input_layernorm.weight")
                if ln1_gpt is not None:
                    with torch.no_grad():
                        block.ln_1.weight.copy_(_adapt(ln1_gpt.float(), (dz,)) + norm_offset)
                ln2_gpt = _find_layer_tensor(tensors, si, "ffn_norm.weight", "post_attention_layernorm.weight")
                if ln2_gpt is not None:
                    with torch.no_grad():
                        block.ln_2.weight.copy_(_adapt(ln2_gpt.float(), (dz,)) + norm_offset)
                if zi == 0 or zi == cfg.n_layers - 1:
                    log(f"layer {zi} <- source {si} (c_attn=Q|K|V, c_proj=Wo, "
                        f"mlp=gate|up|down, norms +{norm_offset:.0f})")
            else:
                # ---- HYENA MODE: SVD QKV→conv kernel + direct QKV→c_attn ----
                if wq is not None:
                    wk = wk if wk is not None else wq.clone()
                    wv = wv if wv is not None else wq.clone()
                    kernel = _svd_conv_kernel(wq.float(), wk.float(), wv.float(), dz, cfg.kernel_size, cfg.n_heads)
                    with torch.no_grad():
                        block.conv.weight.copy_(kernel)
                    if block.use_attn and block.attn is not None:
                        fused = torch.cat([_adapt(wq.float(), (dz, dz)),
                                           _adapt(wk.float(), (dz, dz)),
                                           _adapt(wv.float(), (dz, dz))], dim=0)
                        with torch.no_grad():
                            block.attn.c_attn.weight.copy_(fused)
                if wo is not None:
                    with torch.no_grad():
                        block.gate.weight.copy_(_adapt(wo.float(), (dz, dz)))
                    if block.use_attn and block.attn is not None:
                        with torch.no_grad():
                            block.attn.c_proj.weight.copy_(_adapt(wo.float(), (dz, dz)))
    
                ffn_up = _ensure_2d(_find_layer_tensor(tensors, si, "ffn_gate.weight", "mlp.gate_proj.weight",
                                                        "ffn_up.weight", "mlp.up_proj.weight", "fc1.weight"))
                ffn_dn = _ensure_2d(_find_layer_tensor(tensors, si, "ffn_down.weight", "mlp.down_proj.weight", "fc2.weight"))
                if ffn_up is not None:
                    with torch.no_grad():
                        block.ffn[0].weight.copy_(_adapt(ffn_up.float(), (dff, dz)))
                if ffn_dn is not None:
                    with torch.no_grad():
                        block.ffn[2].weight.copy_(_adapt(ffn_dn.float(), (dz, dff)))
    
                ln1 = _find_layer_tensor(tensors, si, "attn_norm.weight", "input_layernorm.weight", "norm1.weight")
                if ln1 is not None:
                    with torch.no_grad():
                        block.norm1.weight.copy_(_adapt(ln1.float(), (dz,)) + norm_offset)
                ln2 = _find_layer_tensor(tensors, si, "ffn_norm.weight", "post_attention_layernorm.weight", "norm2.weight")
                if ln2 is not None:
                    with torch.no_grad():
                        block.norm2.weight.copy_(_adapt(ln2.float(), (dz,)) + norm_offset)
                if zi == 0 or zi == cfg.n_layers - 1:
                    log(f"layer {zi} <- source {si} (conv=SVD(QKV), c_attn=Q|K|V, "
                        f"gate/c_proj=Wo, ffn=gate/down, norms +{norm_offset:.0f})")
    
        del tensors
        gc.collect()
        if torch.cuda.is_available():
            torch.cuda.empty_cache()
    
        state_dict = {k: (v.float().cpu() if v.is_floating_point() else v.cpu())
                      for k, v in model.state_dict().items()}
        cfg_dict = asdict(cfg); cfg_dict.pop("device", None)
        os.makedirs(os.path.dirname(os.path.abspath(output_path)) or ".", exist_ok=True)
        payload = {"epoch": 0, "model_state_dict": state_dict,
                   "encoding_name": codec.encoding_name,
                   "loss": float("nan"), "config": cfg_dict, "version": "aura-v12.1",
                   "source": "gguf_convert", "gguf_path": str(gguf_path),
                   "gguf_arch": arch}
        if gguf_codec is not None:
            payload["gguf_tokenizer"] = gguf_codec.to_blob()   # tokenizer travels with the checkpoint
        torch.save(payload, output_path)
        log(f"conversion complete -> {output_path} "
            f"(encoding={codec.encoding_name}, vocab={codec.vocab_size:,})")
    return _convert_impl(gguf_path, output_path, cfg, log=log)

# =====================================================================
# QUANT HELPERS (unchanged)
# =====================================================================
def apply_dtype_to_model(model, train_dtype, device, log=print):
    """Returns (model, autocast_dtype).

    amp_bf16 / amp_fp16 (RECOMMENDED for training): TRUE mixed precision.
        Weights stay fp32 (master weights, full-quality AdamW updates); forward/
        backward run under torch.amp.autocast in bf16/fp16. amp_fp16 additionally
        uses GradScaler loss scaling in the trainer. This matches fp32 learning
        quality at roughly half the activation/matmul memory & time.
    bf16 / fp16 (legacy): the FULL model is cast -- optimizer moments and weight
        updates also run in 16-bit, which measurably degrades convergence. Kept
        for inference / backwards compatibility only.
    q8 / q4: bitsandbytes-quantized frozen Linear layers (embeddings/norms still
        train). Minimal VRAM; honest note logged that linears do not train.
    fp32: full precision everywhere.
    """
    if train_dtype in ("q8", "q4"):
        try:
            import bitsandbytes as bnb  # noqa
            have_bnb = True
        except ImportError:
            have_bnb = False
        if not have_bnb or device == "cpu":
            log(f"{train_dtype} unavailable (bitsandbytes/cuda) -> falling back to amp_bf16")
            train_dtype = "amp_bf16"
    if train_dtype in ("q4", "q8"):
        try:
            bits = 8 if train_dtype == "q8" else 4
            # Quantize while weights are still on CPU (bnb quantizes on .to(cuda));
            # _replace_linear_bnb copies the real weights BEFORE the device move.
            _replace_linear_bnb(model, bits, device)
            model = model.to(device)
            log(f"[{train_dtype}] linear layers quantized+FROZEN (inference/partial-"
                f"train: only embeddings & norms receive gradient updates)")
        except Exception as e:
            log(f"quantization failed ({e}) -> using fp32")
            model = model.to(device)
        return model, None
    model = model.to(device)
    if train_dtype == "amp_fp16":
        return model, torch.float16
    if train_dtype == "amp_bf16":
        if device != "cpu" and torch.cuda.is_bf16_supported():
            return model, torch.bfloat16
        log("bf16 autocast unsupported on this device -> fp32")
        return model, None
    if train_dtype == "fp16":
        return model.half(), None
    if train_dtype == "bf16":
        if device != "cpu" and torch.cuda.is_bf16_supported():
            return model.to(dtype=torch.bfloat16), None
        log("bf16 unsupported -> fp32")
        return model, None
    return model, None


def _replace_linear_bnb(model, bits, device):
    # FIX (C1): the previous version moved the fresh bnb layer to CUDA first
    # (quantizing its UNINITIALIZED weights), then attempted a shape-guarded
    # copy that always failed for packed 4-bit tensors -- silently DISCARDING
    # the trained weights of every Linear. Correct order: copy the real fp
    # weights into the replacement while it is still on CPU, THEN move to the
    # device so bitsandbytes quantizes the actual weights.
    import bitsandbytes as bnb
    for name, child in list(model.named_children()):
        if isinstance(child, nn.Linear):
            try:
                if bits == 8:
                    new = bnb.nn.Linear8bitLt(child.in_features, child.out_features,
                                               bias=child.bias is not None, has_fp16_weights=False)
                else:
                    new = bnb.nn.Linear4bit(child.in_features, child.out_features,
                                             bias=child.bias is not None, quant_type="nf4",
                                             compute_dtype=torch.float16)
                with torch.no_grad():
                    new.weight.data = child.weight.data.detach().clone().contiguous().cpu()
                    if child.bias is not None and getattr(new, "bias", None) is not None:
                        new.bias.data = child.bias.data.detach().clone().cpu()
                new = new.to(device)   # quantization happens HERE, on real weights
                setattr(model, name, new)
            except Exception as e:
                print(f"[quant] failed to replace layer '{name}': {e}")
        else:
            _replace_linear_bnb(child, bits, device)


def find_latest_checkpoint(checkpoint_dir):
    if not os.path.isdir(checkpoint_dir):
        return None
    candidates = glob.glob(os.path.join(checkpoint_dir, "*.pt")) + glob.glob(os.path.join(checkpoint_dir, "*.pth"))
    # Never treat non-model blobs as "the model": pause snapshots (item 13) and
    # the aurora_astralis verbatim-cache file (it has no model_state_dict).
    candidates = [c for c in candidates
                  if "pause_resume" not in os.path.basename(c)
                  and os.path.basename(c) != ASTRALIS_FILENAME]
    if not candidates:
        return None
    # FIX (M3): newest checkpoint wins; the old finals-first rule loaded an
    # OLDER final over strictly newer epoch checkpoints.
    return max(candidates, key=os.path.getmtime)


# =====================================================================
# N_HEADS SEAMLESS RELOAD (carried forward, as requested, unmodified in logic)
# =====================================================================
def reshape_conv_weight_for_heads(old_weight: torch.Tensor, new_n_heads: int) -> torch.Tensor:
    d_model, old_group_size, kernel = old_weight.shape
    new_group_size = d_model // new_n_heads
    if new_group_size == old_group_size:
        return old_weight.clone()
    new_weight = torch.zeros(d_model, new_group_size, kernel, dtype=old_weight.dtype)
    if new_group_size < old_group_size:
        assert old_group_size % new_group_size == 0, (
            f"old_group_size={old_group_size} not divisible by new_group_size={new_group_size}; "
            f"pick new_n_heads as a multiple of old_n_heads={d_model // old_group_size}")
        for o in range(d_model):
            local_old = o % old_group_size
            start = (local_old // new_group_size) * new_group_size
            new_weight[o] = old_weight[o, start:start + new_group_size, :]
    else:
        assert new_group_size % old_group_size == 0, (
            f"new_group_size={new_group_size} not divisible by old_group_size={old_group_size}; "
            f"pick new_n_heads as a divisor of old_n_heads={d_model // old_group_size}")
        for o in range(d_model):
            g_old = o // old_group_size
            new_group_start_abs = (o // new_group_size) * new_group_size
            old_group_start_abs = g_old * old_group_size
            offset = old_group_start_abs - new_group_start_abs
            if 0 <= offset <= new_group_size - old_group_size:
                new_weight[o, offset:offset + old_group_size, :] = old_weight[o]
    return new_weight


def infer_conv_layer_specs(state_dict: dict, n_layers_hint: int):
    layer_idxs = sorted({
        int(m.group(1)) for k in state_dict
        if (m := re.match(r"core\.layers\.(\d+)\.conv\.weight", k))
    })
    n_layers = (max(layer_idxs) + 1) if layer_idxs else n_layers_hint
    specs = {}
    for i in layer_idxs:
        w = state_dict[f"core.layers.{i}.conv.weight"]
        out_ch, in_per_group, k = w.shape
        specs[i] = {"d_model": out_ch, "kernel_size": k, "old_n_heads": out_ch // in_per_group}
    return n_layers, specs


def adapt_checkpoint_for_new_n_heads(state_dict: dict, n_layers: int,
                                      target_n_heads: int, log=print) -> dict:
    new_sd = dict(state_dict)
    for i in range(n_layers):
        key = f"core.layers.{i}.conv.weight"
        if key not in state_dict:
            continue
        old_w = state_dict[key]
        d_model, old_group_size, kernel = old_w.shape
        old_n_heads = d_model // old_group_size
        if old_n_heads == target_n_heads:
            continue
        if d_model % target_n_heads != 0:
            log(f"[n_heads adapt] layer {i}: d_model={d_model} not divisible by "
                f"target_n_heads={target_n_heads}, leaving this layer unadapted")
            continue
        new_w = reshape_conv_weight_for_heads(old_w, target_n_heads)
        new_sd[key] = new_w
        log(f"[n_heads adapt] layer {i}: conv.weight {tuple(old_w.shape)} "
            f"(n_heads={old_n_heads}) -> {tuple(new_w.shape)} (n_heads={target_n_heads})")
    return new_sd


# =====================================================================
# TRAINER
# =====================================================================
class Trainer:
    def __init__(self, config: Config, log_fn=print, progress_fn=None):
        self.config = config
        self.log = log_fn
        self.progress_fn = progress_fn or (lambda **kw: None)
        # A "gguf:*" encoding only becomes usable once the checkpoint carrying
        # the tokenizer blob is loaded; start on cl100k until then (no warning).
        self.codec = TiktokenCodec("cl100k_base" if str(config.encoding).startswith("gguf")
                                   else config.encoding)
        self.model: Optional[AuraLM] = None
        self.optimizer = None
        self.scheduler = None
        self.loss_history: List[float] = []
        self.epoch = 0
        self.stage = "idle"
        self._stop = threading.Event()
        self._pause = threading.Event()
        self._amp_dtype = None
        self.train_data: Optional[torch.Tensor] = None
        self.ewc = EWCState()
        self.eta = ETATracker()
        self._built_structural = {}
        self._recent_losses: List[float] = []   # item 11: stop-loss running average
        self.gen_lock = threading.Lock()        # E3: one generation in flight (UI+API)

        # v11 additions
        self.astralis = AuroraAstralis(max_bytes=int(config.astralis_max_kb * 1024))
        self.scratchpad = MetaScratchpad(mode=config.meta_scratchpad_mode)
        self._stop_loss_hit = False
        self._last_hparams_used: Dict[str, Any] = {}

    # ---- model lifecycle ----
    def build_model(self):
        self.config.validate()
        # Keep a GGUF-native codec that arrived with a converted checkpoint;
        # rebuilding a tiktoken codec here would re-break the vocab mapping.
        if not (str(self.config.encoding).startswith("gguf")
                and isinstance(self.codec, GGUFUnigramCodec)):
            # support a simple character-level codec
            if str(self.config.encoding) == "char":
                self.codec = CharCodec("char")
            else:
                self.codec = TiktokenCodec(self.config.encoding)

        if self.config.gpu_only_guard:
            ok, reason = self._gpu_fit_check()
            if not ok:
                self.log(f"[GPU only] REFUSING to build: {reason}")
                raise RuntimeError(f"GPU-only guard blocked model build: {reason}")

        model = AuraLM(self.codec.vocab_size, self.config.d_model, self.config.n_layers,
                        self.config.kernel_size, self.config.n_heads, self.config.dropout,
                        self.config.seq_len, self.config.use_transformer_attention,
                        grad_checkpoint=self.config.grad_checkpoint,
                        pos_encoding=getattr(self.config, "pos_encoding", "rope"),
                        rope_base=getattr(self.config, "rope_base", 10000.0),
                        rope_global_every=getattr(self.config, "rope_global_every", 0),
                        rope_global_base=getattr(self.config, "rope_global_base", 1000000.0),
                        gated_mlp=getattr(self.config, "gated_mlp", False),
                        attn_head_dim=getattr(self.config, "attn_head_dim", 0),
                        n_kv_heads=getattr(self.config, "n_kv_heads", 0),
                        qk_norm=getattr(self.config, "qk_norm", False),
                        ff_dim=getattr(self.config, "ff_dim", 0),
                        untie_head=getattr(self.config, "untie_head", False),
                        model_mode=self.config.model_mode)
        model, self._amp_dtype = apply_dtype_to_model(model, self.config.train_dtype, self.config.device, self.log)
        self.model = model
        no_decay = ["bias", "norm", "ln_f", "wte", "wpe"]
        # Only trainable params go to the optimizer (q4/q8 frozen linears excluded).
        groups = [
            {"params": [p for n, p in model.named_parameters()
                        if p.requires_grad and not any(nd in n for nd in no_decay)],
             "weight_decay": 0.1},
            {"params": [p for n, p in model.named_parameters()
                        if p.requires_grad and any(nd in n for nd in no_decay)],
             "weight_decay": 0.0},
        ]
        # Fused AdamW: single-kernel parameter update on CUDA (faster, no extra VRAM).
        try:
            self.optimizer = optim.AdamW(groups, lr=self.config.learning_rate,
                                         betas=(0.9, 0.95),
                                         fused=str(self.config.device).startswith("cuda"))
        except (RuntimeError, TypeError, ValueError):
            self.optimizer = optim.AdamW(groups, lr=self.config.learning_rate, betas=(0.9, 0.95))
        mode_tag = f"mode={self.config.model_mode}"
        attn_tag = " +MHA" if self.config.use_transformer_attention else ""
        self._built_structural = {f: getattr(self.config, f) for f in
                                   ("d_model", "n_layers", "n_heads", "kernel_size",
                                    "use_transformer_attention", "model_mode")}
        self.log(f"Model | {self.config.device} | {self.config.train_dtype}{attn_tag} | {mode_tag} | "
                 f"{model.count_parameters():,} params | vocab={self.codec.vocab_size:,} ({self.config.encoding})")

    def _gpu_fit_check(self) -> Tuple[bool, str]:
        """GPU-only guard (per request): before building/loading, estimate whether the
        configured model fits in currently-free GPU memory. Fails gracefully with an
        informative console message rather than letting CUDA OOM crash the app."""
        if self.config.device != "cuda" or not torch.cuda.is_available():
            return False, "GPU only is enabled but no CUDA device is available"
        codec = TiktokenCodec(self.config.encoding)
        est_bytes = estimate_model_vram_bytes(self.config, codec.vocab_size)
        free_bytes = get_available_gpu_bytes()
        if free_bytes is None:
            return False, "could not query free GPU memory"
        est_gb, free_gb = est_bytes / 1e9, free_bytes / 1e9
        if est_bytes > free_bytes:
            return False, (f"estimated need ~{est_gb:.2f}GB VRAM (weights+grad+optimizer+margin) "
                           f"exceeds free VRAM ~{free_gb:.2f}GB. Reduce d_model/n_layers/batch_size, "
                           f"or use a smaller dtype (bf16/q8/q4).")
        self.log(f"[GPU only] estimated ~{est_gb:.2f}GB needed, ~{free_gb:.2f}GB free -> OK")
        return True, ""

    def _free_model(self):
        self.model = self.optimizer = self.scheduler = None
        self._amp_dtype = None
        gc.collect()
        if torch.cuda.is_available():
            torch.cuda.empty_cache()

    # ---- pause / resume with full resource release (item 13) ----
    def _pause_state_path(self) -> str:
        return os.path.join(self.config.checkpoint_dir, "pause_resume.pt")

    def _save_pause_state(self, path: str):
        os.makedirs(self.config.checkpoint_dir, exist_ok=True)
        sd = {k: v.detach().cpu() for k, v in self.model.state_dict().items()}

        def _cpu(o):
            if torch.is_tensor(o):
                return o.detach().cpu()
            if isinstance(o, dict):
                return {k: _cpu(v) for k, v in o.items()}
            if isinstance(o, list):
                return [_cpu(v) for v in o]
            return o
        torch.save({"model": sd, "optimizer": _cpu(self.optimizer.state_dict())}, path)

    def _release_for_pause(self):
        self.model = None
        self.optimizer = None
        gc.collect()
        if torch.cuda.is_available():
            try:
                torch.cuda.synchronize()
                torch.cuda.empty_cache()
            except Exception:
                pass

    def _restore_from_pause(self, path: str):
        self.build_model()   # rebuild model + fresh optimizer on the device
        blob = torch.load(path, map_location="cpu", weights_only=False)
        self.model.load_state_dict(blob["model"], strict=False)
        try:
            self.optimizer.load_state_dict(blob["optimizer"])
        except Exception as e:
            self.log(f"[pause] optimizer state restore failed ({e}); continuing with fresh optimizer")

    # ---- data ----
    def _load_corpus(self, path):
        if not os.path.exists(path):
            path = ErdosStrausGenerator.generate_dataset(output_path=path if path else "aura_fallback_data.txt")
        self.stage = "tokenizing"
        # If using the character codec, allow it to extend with any new characters
        if getattr(self.codec, 'mode', '') == 'char' and hasattr(self.codec, 'extend_with_text'):
            try:
                with open(path, 'r', encoding='utf-8', errors='replace') as f:
                    raw = f.read()
                added = self.codec.extend_with_text(raw)
                if added:
                    self.log(f"[char codec] added {added} new characters -> vocab={self.codec.vocab_size}")
                    # If a model already exists, expand its embedding table to match new vocab
                    if self.model is not None and hasattr(self.model, 'wte'):
                        with torch.no_grad():
                            old_w = self.model.wte.weight.data
                            d = old_w.size(1)
                            new_vocab = self.codec.vocab_size
                            if new_vocab > old_w.size(0):
                                new_w = old_w.new_empty((new_vocab, d))
                                nn.init.normal_(new_w, 0.0, 0.02)
                                new_w[:old_w.size(0)].copy_(old_w)
                                self.model.wte.weight.data = new_w
                                try:
                                    self.model.lm_head.weight = self.model.wte.weight
                                except Exception:
                                    pass
                                self.log(f"[model] expanded embeddings to vocab={new_vocab}")
            except Exception:
                pass
        self.train_data = load_tokens_with_cache(path, self.codec, self.config.cache_dir, self.log)
        self.log(f"corpus ready: {len(self.train_data):,} tokens")
        # build char-level word frequency map for reward shaping if requested
        if getattr(self.codec, 'mode', '') == 'char':
            try:
                with open(path, 'r', encoding='utf-8', errors='replace') as f:
                    raw = f.read()
                words = [w.lower() for w in re.findall(r"[A-Za-z']+", raw)]
                freq = {}
                for w in words:
                    freq[w] = freq.get(w, 0) + 1
                # keep only reasonably frequent words to avoid noise
                if freq:
                    # convert to plain dict with ints
                    self._char_word_freqs = {w: int(c) for w, c in freq.items()}
                    self.log(f"[char reward] computed {len(self._char_word_freqs):,} unique words; max={max(self._char_word_freqs.values())}")
                else:
                    self._char_word_freqs = {}
            except Exception:
                self._char_word_freqs = {}
        return self.train_data

    def _get_batch(self):
        data = self.train_data
        bs = self.config.batch_size
        sl = self.config.seq_len
        max_start = max(1, len(data) - sl - 1)
        ix = torch.randint(0, max_start, (bs,))
        x = torch.stack([data[i:i + sl] for i in ix])
        y = torch.stack([data[i + 1:i + sl + 1] for i in ix])
        return x.to(self.config.device), y.to(self.config.device)

    # ---- loss dispatch (item 9: every option is a real, differentiable loss) ----
    def _prefix_weight_tensor(self, y: torch.Tensor) -> Optional[torch.Tensor]:
        """Per-token weights emphasizing the 'Aria:' / 'Aura:' name-prefix tokens
        (item 7) so the model strongly learns turn-by-turn dialogue structure.
        Returns None when disabled or no prefix occurs in this batch."""
        wgt = float(getattr(self.config, "prefix_loss_weight", 1.0))
        if wgt <= 1.0:
            return None
        key = (self.codec.encoding_name, self.config.user_name, self.config.assistant_name)
        if getattr(self, "_prefix_key", None) != key:
            seqs, seen = [], set()
            for name in (self.config.user_name, self.config.assistant_name):
                for variant in (f"\n{name}:", f"{name}:"):
                    ids = tuple(self.codec.encode(variant))
                    if ids and ids not in seen:
                        seen.add(ids)
                        seqs.append(torch.tensor(ids, dtype=torch.long))
            self._prefix_seqs = seqs
            self._prefix_key = key
        mask = torch.zeros_like(y, dtype=torch.bool)
        any_hit = False
        for s in self._prefix_seqs:
            L = s.numel()
            if L == 0 or y.size(1) < L:
                continue
            hits = (y.unfold(1, L, 1) == s.to(y.device).view(1, 1, L)).all(dim=2)
            if hits.any():
                any_hit = True
                W = hits.size(1)
                for off in range(L):
                    mask[:, off:off + W] |= hits
        if not any_hit:
            return None
        w = torch.ones_like(y, dtype=torch.float32)
        w[mask] = wgt
        return w

    def _compute_loss(self, logits, targets):
        fn = self.config.loss_fn
        w = self._prefix_weight_tensor(targets)
        if fn == "label_smoothing":
            return compute_loss_weighted_ce(logits, targets, w, label_smoothing=0.1,
                                            codec=getattr(self, 'codec', None),
                                            char_word_freqs=getattr(self, '_char_word_freqs', None),
                                            char_reward_scale=getattr(self.config, 'char_reward_scale', 0.0))
        if fn == "focal":
            return compute_loss_focal(logits, targets, w, gamma=1.5)
        if fn == "anti_repetition":
            base = compute_loss_weighted_ce(logits, targets, w)
            return base + 0.5 * compute_unlikelihood_term(logits, targets)
        return compute_loss_weighted_ce(logits, targets, w,
                                        codec=getattr(self, 'codec', None),
                                        char_word_freqs=getattr(self, '_char_word_freqs', None),
                                        char_reward_scale=getattr(self.config, 'char_reward_scale', 0.0))

    # ---- EWC ----
    def compute_fisher(self, n_batches: Optional[int] = None):
        if self.model is None or self.train_data is None:
            self.log("[EWC] need model + corpus first")
            return
        n_batches = n_batches or self.config.ewc_samples
        self.log(f"[EWC] estimating diagonal Fisher over {n_batches} batches ...")
        self.model.eval()
        fisher = {n: torch.zeros_like(p, device="cpu") for n, p in self.model.named_parameters() if p.requires_grad}
        for _ in range(n_batches):
            if self._stop.is_set():
                break
            x, y = self._get_batch()
            self.optimizer.zero_grad(set_to_none=True)
            _, loss = self.model(x, y)
            loss.backward()
            for n, p in self.model.named_parameters():
                if p.grad is not None and n in fisher:
                    fisher[n] += p.grad.detach().cpu().pow(2)
            self.optimizer.zero_grad(set_to_none=True)
        for n in fisher:
            fisher[n] /= max(1, n_batches)
        self.ewc.fisher = fisher
        self.ewc.anchor = {n: p.data.detach().float().cpu().clone() for n, p in self.model.named_parameters() if p.requires_grad}
        self.ewc.pin()   # pinned CPU memory -> fast async streaming, ~0 VRAM held
        self.log(f"[EWC] Fisher ready (CPU-pinned, streamed per-param). lambda={self.config.ewc_lambda}")

    # ---- astralis: verbatim-cache commit during training (real work, CPU-offloaded
    # via meta_scratchpad since it never touches CUDA tensors) ----
    def _astralis_commit_from_batch(self, x_ids: torch.Tensor, y_ids: torch.Tensor):
        """Called periodically during training. Commits ONLY verified ground-truth
        spans from the training data itself (never model samples or confidence):
          1. Erdos-Straus proof lines that pass the independent Fraction check.
          2. Short exact context->continuation pairs (last 32-64 chars of x as
             trigger, first 48 chars of the aligned y as payload) so ordinary
             factual text also populates the cache when meta_generate is on.
        """
        def work():
            try:
                row_x = x_ids[0].tolist()
                row_y = y_ids[0].tolist()
                text_x = self.codec.decode(row_x)
                text_y = self.codec.decode(row_y)
                # 1) verified Erdos-Straus proofs
                for line in text_x.split("\n"):
                    line = line.strip()
                    if line.startswith("Proof 4/") and ErdosStrausGenerator.verify_proof_line(line):
                        trigger = line.split("=")[0].strip()
                        self.astralis.commit(trigger, line, kind="erdos_straus", verified=True)
                # 2) short verbatim ground-truth spans (trigger = end of context,
                #    payload = start of the true next tokens). Bounded size so the
                #    cache stays dense and useful for streaming shortcuts.
                if len(text_x) >= 24 and len(text_y) >= 8:
                    for tw in (64, 32):
                        trigger = text_x[-tw:] if len(text_x) >= tw else text_x
                        payload = text_y[:48]
                        if payload.strip():
                            self.astralis.commit(trigger, payload, kind="context_span", verified=True)
            except Exception as e:
                self.log(f"[astralis] commit-from-batch failed: {e}")
        self.scratchpad.submit(work)

    # ---- control ----
    def stop(self):
        self._stop.set()
        # Auto-clear memory on stop (requested). Model weights stay loaded so
        # generation remains available; only free transient CUDA allocations.
        gc.collect()
        if torch.cuda.is_available():
            try:
                torch.cuda.synchronize()
                torch.cuda.empty_cache()
            except Exception:
                pass
        self.log("[mem] CUDA cache cleared after stop")

    def pause(self): self._pause.set()
    def resume(self): self._pause.clear()

    def _current_hparams_snapshot(self) -> Dict[str, Any]:
        d = asdict(self.config)
        d.pop("device", None)
        return d

    # ---- training loop ----
    def _train_loop(self, extra_epochs: Optional[int] = None):
        os.makedirs(self.config.checkpoint_dir, exist_ok=True)
        use_amp = self._amp_dtype is not None and torch.cuda.is_available()
        scaler = torch.amp.GradScaler("cuda") if (use_amp and self._amp_dtype == torch.float16) else None

        self.stage = "training"
        self._stop_loss_hit = False
        self._recent_losses = []
        self.eta.start()
        ep_target = extra_epochs if extra_epochs is not None else self.config.epochs
        ep = 0
        global_step = 0

        while ep < ep_target and not self._stop.is_set() and not self._stop_loss_hit:
            ep += 1
            ep_target = extra_epochs if extra_epochs is not None else self.config.epochs
            self.model.train()
            # live-updatable: gradient checkpointing can be toggled mid-training
            if hasattr(self.model, "core"):
                self.model.core.grad_checkpoint = bool(self.config.grad_checkpoint)
            epoch_loss, steps_this_epoch = 0.0, 0

            data_len = len(self.train_data)
            windows = max(1, (data_len - self.config.seq_len) // self.config.seq_len)
            steps_per_epoch = max(1, windows // max(1, self.config.batch_size))

            for step in range(steps_per_epoch):
                if self._pause.is_set() and not self._stop.is_set():
                    # Item 13: pause = persist model+optimizer to disk and RELEASE
                    # VRAM/RAM; resume = reload automatically and continue.
                    self.eta.pause()
                    p_path = self._pause_state_path()
                    try:
                        self._save_pause_state(p_path)
                        self._release_for_pause()
                        self.log(f"[pause] state saved -> {p_path}; model unloaded, VRAM freed")
                        unloaded = True
                    except Exception as e:
                        self.log(f"[pause] save/unload failed ({e}); keeping model resident")
                        unloaded = False
                    while self._pause.is_set() and not self._stop.is_set():
                        time.sleep(0.15)
                    if unloaded:
                        self._restore_from_pause(p_path)
                        self.model.train()
                        self.log("[pause] resumed: model reloaded, training continues")
                    self.eta.resume()
                if self._stop.is_set():
                    break

                # FIX: warmup_epochs / min_lr were previously dead config fields.
                # Linear warmup over the first warmup_epochs * steps_per_epoch steps,
                # then cosine decay down to min_lr for the rest of training.
                total_steps_est = max(1, ep_target * steps_per_epoch)
                warmup_steps = max(1, int(self.config.warmup_epochs * steps_per_epoch))
                if global_step < warmup_steps:
                    lr = self.config.learning_rate * (global_step + 1) / warmup_steps
                else:
                    progress = (global_step - warmup_steps) / max(1, total_steps_est - warmup_steps)
                    cosine = 0.5 * (1.0 + math.cos(math.pi * min(1.0, progress)))
                    lr = self.config.min_lr + (self.config.learning_rate - self.config.min_lr) * cosine
                self.optimizer.param_groups[0]["lr"] = lr
                self.optimizer.param_groups[1]["lr"] = lr

                x, y = self._get_batch()
                if use_amp:
                    with torch.amp.autocast('cuda', dtype=self._amp_dtype):
                        logits, _ = self.model(x, None)
                        loss = self._compute_loss(logits, y)
                else:
                    logits, _ = self.model(x, None)
                    loss = self._compute_loss(logits, y)

                if self.config.ewc_lambda > 0 and self.ewc.fisher is not None:
                    loss = loss + self.ewc.penalty(self.model, self.config.ewc_lambda, self.config.device)

                loss = loss / self.config.grad_accumulation_steps
                (scaler.scale(loss) if scaler else loss).backward()

                if (step + 1) % self.config.grad_accumulation_steps == 0:
                    if scaler:
                        scaler.unscale_(self.optimizer)
                        torch.nn.utils.clip_grad_norm_(self.model.parameters(), 1.0)
                        scaler.step(self.optimizer); scaler.update()
                    else:
                        torch.nn.utils.clip_grad_norm_(self.model.parameters(), 1.0)
                        self.optimizer.step()
                    self.optimizer.zero_grad(set_to_none=True)

                step_loss = loss.item() * self.config.grad_accumulation_steps
                epoch_loss += step_loss
                global_step += 1
                steps_this_epoch += 1

                # meta_generate training-side hook: opportunistically try to grow the
                # astralis cache from ground-truth data in this batch. Dispatched via
                # meta_scratchpad so it runs on CPU concurrently with the next GPU step.
                if self.config.meta_generate and global_step % 8 == 0:
                    self._astralis_commit_from_batch(x, y)

                total_steps_est = ep_target * steps_per_epoch
                eta_sec, sec_per_batch = self.eta.update(global_step, max(global_step, total_steps_est))

                self.progress_fn(epoch=ep, epochs=ep_target, batch=step + 1,
                                  n_batches=steps_per_epoch, loss=step_loss, eta_sec=eta_sec,
                                  sec_per_batch=sec_per_batch, hparams=self._current_hparams_snapshot())

                # stop_loss (item 11): compare the RUNNING AVERAGE of the last
                # >=3 step losses against the target, so a single aberrant low
                # value can no longer halt training.
                self._recent_losses.append(step_loss)
                if len(self._recent_losses) > 8:
                    self._recent_losses.pop(0)
                if self.config.stop_loss > 0 and len(self._recent_losses) >= 3:
                    avg3 = sum(self._recent_losses[-3:]) / 3.0
                    if avg3 <= self.config.stop_loss:
                        self.log(f"[stop_loss] 3-step avg {avg3:.4f} <= target "
                                 f"{self.config.stop_loss:.4f} -> stopping training")
                        self._stop_loss_hit = True
                        break

            avg = epoch_loss / max(steps_this_epoch, 1)
            self.loss_history.append(avg)
            self.epoch += 1
            self.log(f"Epoch {self.epoch} | loss {avg:.4f}")
            if self.epoch % max(1, self.config.save_every) == 0:
                self.save_checkpoint(self.epoch, avg)

        self._last_hparams_used = self._current_hparams_snapshot()
        self.save_checkpoint(self.epoch, self.loss_history[-1] if self.loss_history else float("nan"), final=True)

        # persist astralis cache alongside the checkpoint (CPU-side, via scratchpad)
        astralis_path = os.path.join(self.config.checkpoint_dir, ASTRALIS_FILENAME)
        self.scratchpad.submit(self.astralis.save, astralis_path)

        self.stage = "idle"
        reason = "stop_loss target reached" if self._stop_loss_hit else "epoch target reached"
        self.log(f"Training complete ({reason}).")

    def train(self, corpus_path=None):
        self._stop.clear()
        self._free_model()
        self.log("Building model ...")
        self.build_model()
        self._load_corpus(corpus_path or self.config.training_file)
        try:
            self._train_loop()
        except Exception as e:
            self.log(f"Training error: {e}")
            traceback.print_exc()
            self.save_checkpoint(self.epoch, self.loss_history[-1] if self.loss_history else float("nan"))
            raise

    def continue_training(self, new_path=None, extra_epochs=None):
        new_path = new_path or self.config.continue_file or self.config.training_file
        extra_epochs = extra_epochs or self.config.continue_epochs
        self.log(f"[finetune] corpus: {os.path.abspath(new_path)}")
        if not os.path.exists(new_path):
            raise FileNotFoundError(new_path)
        if self.model is None:
            self.build_model()
        self._stop.clear()
        self._load_corpus(new_path)
        if self.config.ewc_lambda > 0:
            try:
                self.compute_fisher()
            except Exception as e:
                self.log(f"[EWC] fisher skipped: {e}")
        self._train_loop(extra_epochs=extra_epochs)

    # ---- checkpoints (now stamps full hyperparams + astralis path for future reload) ----
    def save_checkpoint(self, epoch, loss, final=False):
        if self.model is None:
            return
        # E2 (fix C5): NEVER clobber model_final.pt with a fresh/aborted model
        # (0 epochs trained or NaN loss). Previously any Train->Stop overwrote it.
        if final and (epoch <= 0 or loss != loss):
            self.log("[ckpt] final save SKIPPED (no completed epochs / NaN loss) "
                     "-- protecting existing model_final.pt")
            return
        os.makedirs(self.config.checkpoint_dir, exist_ok=True)
        name = "model_final.pt" if final else f"model_epoch_{epoch}.pt"
        path = os.path.join(self.config.checkpoint_dir, name)
        sd = {k: (v.float().cpu() if v.is_floating_point() else v.cpu())
              for k, v in self.model.state_dict().items()}
        cfg = asdict(self.config); cfg.pop("device", None)
        torch.save({
            "epoch": epoch, "model_state_dict": sd, "encoding_name": self.codec.encoding_name,
            "loss": loss, "config": cfg, "version": "aura-v12",
            "hyperparams_used": self._current_hparams_snapshot(),   # full stamp, per request
            "astralis_file": ASTRALIS_FILENAME,
        }, path)
        self.log(f"checkpoint -> {path}")
        if not final:
            # E2: rotation -- keep only the newest N epoch checkpoints
            keep = max(1, int(getattr(self.config, "keep_checkpoints", 5)))
            eps = sorted(glob.glob(os.path.join(self.config.checkpoint_dir, "model_epoch_*.pt")),
                         key=os.path.getmtime)
            for old in eps[:-keep]:
                try:
                    os.remove(old)
                    self.log(f"[ckpt] rotated out {os.path.basename(old)}")
                except Exception:
                    pass

    def load_checkpoint(self, path, target_n_heads: Optional[int] = None):
        if self.config.gpu_only_guard:
            ok, reason = self._gpu_fit_check()
            if not ok:
                self.log(f"[GPU only] REFUSING to load: {reason}")
                raise RuntimeError(f"GPU-only guard blocked checkpoint load: {reason}")

        ckpt = torch.load(path, map_location="cpu", weights_only=False)
        if not isinstance(ckpt, dict) or "model_state_dict" not in ckpt:
            raise RuntimeError(f"'{os.path.basename(path)}' is not a model checkpoint "
                               f"(no model_state_dict) -- it may be a cache/aux file")
        cur_dev, cur_dtype, cur_mgpu = self.config.device, self.config.train_dtype, self.config.multi_gpu
        cur_training_file, cur_continue_file = self.config.training_file, self.config.continue_file
        cur_seq = self.config.seq_len
        for k, v in ckpt.get("config", {}).items():
            if hasattr(self.config, k):
                setattr(self.config, k, v)
        self.config.device, self.config.train_dtype, self.config.multi_gpu = cur_dev, cur_dtype, cur_mgpu
        self.config.training_file = cur_training_file
        self.config.continue_file = cur_continue_file
        # Dynamic context (item 6): RoPE has no learned position table, so the
        # user's configured context length wins over the checkpoint's value.
        if self.config.seq_len != cur_seq:
            self.log(f"[load] context length: checkpoint={self.config.seq_len} -> using configured {cur_seq}")
            self.config.seq_len = cur_seq
        enc = ckpt.get("encoding_name", self.config.encoding)
        gguf_blob = ckpt.get("gguf_tokenizer")
        if gguf_blob is not None:
            try:
                self.codec = GGUFUnigramCodec.from_blob(gguf_blob)
                self.log(f"[load] GGUF tokenizer restored ({self.codec.vocab_size:,} tokens, "
                         f"arch={self.codec.arch or '?'})")
            except Exception as e:
                self.log(f"[load] gguf tokenizer blob failed ({e}); tiktoken fallback")
                self.codec = TiktokenCodec(enc)
        elif str(enc).startswith("gguf"):
            self.log(f"[load] checkpoint expects GGUF tokenizer '{enc}' but carries no "
                     f"tokenizer blob -- re-convert the GGUF for coherent output")
            self.codec = TiktokenCodec("cl100k_base")
        else:
            self.codec = TiktokenCodec(enc)
        self.config.encoding = enc

        sd = ckpt["model_state_dict"]
        # Legacy compatibility: pre-v12 checkpoints were trained with a learned
        # absolute-position table (wpe) and NON-rotary attention. Applying RoPE
        # to those weights scrambles attention into gibberish. Detect and build
        # with the matching positional mode so old models generate EXACTLY as
        # they were trained.
        if "pos_encoding" not in ckpt.get("config", {}):
            if "wpe.weight" in sd:
                self.config.pos_encoding = "learned"
                self.config.seq_len = int(sd["wpe.weight"].shape[0])  # wpe rows fix the context
                self.log("[load] legacy checkpoint (learned wpe) -> pos_encoding='learned', "
                         f"RoPE disabled, context={self.config.seq_len} (from wpe table)")
            else:
                self.config.pos_encoding = "rope"
        n_layers, specs = infer_conv_layer_specs(sd, self.config.n_layers)
        if specs:
            first = specs[0]
            for field_name, tensor_val in [("n_layers", n_layers),
                                            ("d_model", first["d_model"]),
                                            ("kernel_size", first["kernel_size"])]:
                if getattr(self.config, field_name) != tensor_val:
                    self.log(f"[load_checkpoint] '{field_name}' config={getattr(self.config, field_name)} "
                            f"vs checkpoint tensors={tensor_val} -> using {tensor_val}")
                    setattr(self.config, field_name, tensor_val)

        desired_n_heads = target_n_heads or self.config.n_heads
        self.config.n_heads = desired_n_heads
        self.config.validate()
        sd = adapt_checkpoint_for_new_n_heads(sd, n_layers, self.config.n_heads, log=self.log)

        # q4/q8 fix: bitsandbytes linears store PACKED weights ([N,1] uint8), so
        # an fp32 checkpoint can never load into a pre-quantized model. Detect
        # whether the state dict itself is quantized; if it is NOT, build the
        # model in a floating dtype, load the real weights, THEN quantize (the
        # C1 fix in _replace_linear_bnb preserves the loaded values).
        want_quant = self.config.train_dtype in ("q4", "q8")
        sd_is_quant = any("quant_state" in k for k in sd) or any(
            k.endswith(".weight") and torch.is_tensor(v) and v.dim() == 2
            and v.shape[1] == 1 and v.dtype == torch.uint8 for k, v in sd.items())
        deferred_dtype = None
        if want_quant and not sd_is_quant:
            deferred_dtype = self.config.train_dtype
            self.config.train_dtype = "amp_bf16"
            self.log(f"[{deferred_dtype}] loading fp32 weights first; quantization "
                     f"is applied AFTER the state dict is in place")

        self.build_model()
        missing, unexpected = self.model.load_state_dict(sd, strict=False)
        self.epoch = ckpt.get("epoch", 0)

        if deferred_dtype is not None:
            self.config.train_dtype = deferred_dtype
            try:
                bits = 8 if deferred_dtype == "q8" else 4
                _replace_linear_bnb(self.model, bits, self.config.device)
                self._amp_dtype = None
                self.log(f"[{deferred_dtype}] linears quantized with the loaded weights "
                         f"(frozen; embeddings/norms stay trainable)")
            except Exception as e:
                self.log(f"[{deferred_dtype}] post-load quantization failed ({e}); "
                         f"continuing in fp32")

        # load astralis cache that travels with this checkpoint, if present
        astralis_path = os.path.join(self.config.checkpoint_dir, ckpt.get("astralis_file", ASTRALIS_FILENAME))
        loaded_astralis = AuroraAstralis.load(astralis_path)
        self.astralis.merge_additive(loaded_astralis)

        self.log(f"loaded [{ckpt.get('version','?')}] epoch={self.epoch} "
                f"loss={ckpt.get('loss', float('nan')):.4f} vocab={self.codec.vocab_size:,} "
                f"n_heads={self.config.n_heads} missing={len(missing)} unexpected={len(unexpected)}")
        if "hyperparams_used" in ckpt:
            self._last_hparams_used = ckpt["hyperparams_used"]

    # ---- generation ----
    @torch.no_grad()
    def generate(self, prompt: str, steps=120, temperature=0.8, top_k=50,
                 token_callback=None):
        # E3: serialize generations -- the UI and the API server share one model.
        with self.gen_lock:
            return self._generate_inner(prompt, steps, temperature, top_k, token_callback)

    @torch.no_grad()
    def _generate_inner(self, prompt: str, steps=120, temperature=0.8, top_k=50,
                        token_callback=None):
        """
        Hard-caps prompt to block_size before prefill. Supports optional
        token_callback(partial_text) for live streaming into the chat UI.
        meta_generate: multi-suffix astralis lookup; on hit returns the verified
        span instantly (no token loop).
        """
        if self.model is None:
            raise RuntimeError("No model loaded")
        self.stage = "generating"
        t0 = time.perf_counter()
        self.model.eval()

        cache_hit_text = None
        if self.config.meta_generate:
            rec = self.astralis.lookup(prompt)
            if rec is not None:
                cache_hit_text = rec.payload
                self.log(f"[astralis] cache HIT ({rec.kind}, {rec.hits} hits) -> verbatim shortcut")

        ids = self.codec.encode(prompt) or [198]
        if len(ids) > self.model.block_size:
            ids = ids[-self.model.block_size:]
        idx = torch.tensor([ids], dtype=torch.long, device=self.config.device)

        if cache_hit_text is not None:
            if token_callback is not None:
                try:
                    token_callback(cache_hit_text)
                except Exception:
                    pass
            gen_ids = self.codec.encode(cache_hit_text)[:steps]
            elapsed = max(time.perf_counter() - t0, 1e-9)
            self.stage = "idle"
            return cache_hit_text, len(gen_ids) / elapsed, elapsed, True

        stop_ids = getattr(self.codec, "eos_ids", None)   # gemma: <eos> + <end_of_turn>
        # AMP inference: with fp32 master weights (amp_* dtypes) run generation
        # under autocast so activations/KV run in bf16/fp16 -> ~half the VRAM.
        amp_ctx = (torch.amp.autocast('cuda', dtype=self._amp_dtype)
                   if (self._amp_dtype is not None and str(self.config.device).startswith("cuda"))
                   else contextlib.nullcontext())
        with amp_ctx:
            out, n_gen = self.model.generate(
                idx, max_new_tokens=steps, temperature=temperature, top_k=top_k,
                stop_token_ids=stop_ids, finish_sentence=self.config.finish_sentence,
                finish_extra_tokens=max(0, int(getattr(self.config, "finish_max_extra", 40))),
                decode_fn=self.codec.decode, token_callback=token_callback)
        gen = out[0, len(ids):].tolist()
        text = self.codec.decode(gen)
        if self.config.finish_sentence:
            text = trim_to_sentence_end(text)   # item 8: never end mid-sentence
        try:
            q = analyze_text_quality(text)
            self.log(f"[quality] words={q['words']:.0f} rep3={q['rep3']:.2f} "
                     f"distinct2={q['distinct2']:.2f} len_var={q['len_var']:.2f} "
                     f"common={q['common_frac']:.2f}")
        except Exception:
            pass
        del out
        # PERF: no empty_cache() here -- keeping the CUDA allocator warm makes
        # the next generation start instantly; Stop/Unload still release memory.
        elapsed = max(time.perf_counter() - t0, 1e-9)
        self.stage = "idle"
        return text, len(gen) / elapsed, elapsed, False


# =====================================================================
# OPENAI-COMPATIBLE API SERVER (item 16)
# Endpoints: GET /v1/models, POST /v1/chat/completions (incl. SSE streaming),
# POST /v1/completions. Chat messages are formatted with the configured
# user/assistant names + system prompt, exactly like the in-app chat. All
# events are logged to the console.
# =====================================================================
class _APIHandler(http.server.BaseHTTPRequestHandler):
    server_version = "AuraAPI/1.0"
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):
        GLOBAL_LOGGER.log("[api] " + (fmt % args))

    def _json(self, code, obj):
        body = json.dumps(obj).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()
        try:
            self.wfile.write(body)
        except Exception:
            pass

    def _auth_ok(self) -> bool:
        key = getattr(self.server, "api_key", "")
        if not key:
            return True
        return self.headers.get("Authorization", "") == f"Bearer {key}"

    def do_OPTIONS(self):
        self.send_response(204)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Headers", "Authorization, Content-Type")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Content-Length", "0")
        self.end_headers()

    def do_GET(self):
        if self.path.rstrip("/") == "/v1/models":
            self._json(200, {"object": "list", "data": [
                {"id": "aura-astralis", "object": "model",
                 "created": int(time.time()), "owned_by": "aura"}]})
        else:
            self._json(404, {"error": {"message": f"unknown path {self.path}"}})

    def do_POST(self):
        if not self._auth_ok():
            self._json(401, {"error": {"message": "invalid api key"}})
            return
        try:
            length = int(self.headers.get("Content-Length", 0) or 0)
            payload = json.loads(self.rfile.read(length) or b"{}")
        except Exception as e:
            self._json(400, {"error": {"message": f"bad json: {e}"}})
            return
        trainer, cfg = self.server.trainer, self.server.cfg
        if trainer.model is None:
            self._json(503, {"error": {"message": "no model loaded"}})
            return
        path = self.path.rstrip("/")
        if path == "/v1/chat/completions":
            msgs = payload.get("messages", [])
            parts = []
            has_system = any(m.get("role") == "system" for m in msgs)
            if (cfg.system_prompt or "").strip() and not has_system:
                parts.append(cfg.system_prompt.strip())
            for m in msgs:
                role, content = m.get("role", "user"), str(m.get("content", ""))
                if role == "system":
                    parts.append(content)
                elif role == "assistant":
                    parts.append(f"{cfg.assistant_name}: {content}")
                else:
                    parts.append(f"{cfg.user_name}: {content}")
            parts.append(f"{cfg.assistant_name}:")
            self._complete(payload, "\n".join(parts), chat_format=True)
        elif path == "/v1/completions":
            self._complete(payload, str(payload.get("prompt", "")), chat_format=False)
        else:
            self._json(404, {"error": {"message": f"unknown path {self.path}"}})

    def _complete(self, payload, prompt, chat_format):
        trainer, cfg = self.server.trainer, self.server.cfg
        steps = int(payload.get("max_tokens") or cfg.gen_steps)
        temp = float(payload.get("temperature") or cfg.temperature)
        stream = bool(payload.get("stream", False))
        rid = f"chatcmpl-{int(time.time() * 1000)}"
        obj = "chat.completion" if chat_format else "text_completion"
        GLOBAL_LOGGER.log(f"[api] {self.path} max_tokens={steps} temp={temp:.2f} stream={stream}")
        try:
            if stream:
                self.send_response(200)
                self.send_header("Content-Type", "text/event-stream")
                self.send_header("Cache-Control", "no-cache")
                self.send_header("Access-Control-Allow-Origin", "*")
                self.end_headers()
                sent = {"n": 0}

                def cb(partial):
                    delta = partial[sent["n"]:]
                    if not delta:
                        return
                    sent["n"] = len(partial)
                    if chat_format:
                        choice = {"index": 0, "delta": {"content": delta}, "finish_reason": None}
                    else:
                        choice = {"index": 0, "text": delta, "finish_reason": None}
                    chunk = {"id": rid, "object": obj + ".chunk", "created": int(time.time()),
                             "model": "aura-astralis", "choices": [choice]}
                    try:
                        self.wfile.write(f"data: {json.dumps(chunk)}\n\n".encode("utf-8"))
                        self.wfile.flush()
                    except Exception:
                        pass
                text, tps, el, _hit = trainer.generate(prompt, steps=steps, temperature=temp,
                                                       top_k=cfg.top_k, token_callback=cb)
                done_choice = ({"index": 0, "delta": {}, "finish_reason": "stop"} if chat_format
                               else {"index": 0, "text": "", "finish_reason": "stop"})
                done = {"id": rid, "object": obj + ".chunk", "created": int(time.time()),
                        "model": "aura-astralis", "choices": [done_choice]}
                try:
                    self.wfile.write(f"data: {json.dumps(done)}\n\ndata: [DONE]\n\n".encode("utf-8"))
                    self.wfile.flush()
                except Exception:
                    pass
                GLOBAL_LOGGER.log(f"[api] stream complete ({len(text)} chars, {tps:.1f} tok/s)")
                return
            text, tps, el, _hit = trainer.generate(prompt, steps=steps, temperature=temp,
                                                   top_k=cfg.top_k)
        except Exception as e:
            GLOBAL_LOGGER.log(f"[api] generation error: {e}")
            self._json(500, {"error": {"message": str(e)}})
            return
        n_prompt = len(trainer.codec.encode(prompt))
        n_out = len(trainer.codec.encode(text))
        usage = {"prompt_tokens": n_prompt, "completion_tokens": n_out,
                 "total_tokens": n_prompt + n_out}
        if chat_format:
            choice = {"index": 0, "message": {"role": "assistant", "content": text},
                      "finish_reason": "stop"}
        else:
            choice = {"index": 0, "text": text, "finish_reason": "stop"}
        self._json(200, {"id": rid, "object": obj, "created": int(time.time()),
                         "model": "aura-astralis", "choices": [choice], "usage": usage})
        GLOBAL_LOGGER.log(f"[api] completion done ({n_out} tok, {tps:.1f} tok/s)")


class OpenAIAPIServer:
    """Lifecycle wrapper: start/stop the threaded HTTP server per settings."""
    def __init__(self, trainer: "Trainer", cfg: Config):
        self.trainer = trainer
        self.cfg = cfg
        self._httpd = None
        self._thread = None
        self._bound = None   # (host, port, key) currently serving

    @property
    def running(self) -> bool:
        return self._httpd is not None

    def start(self, host: str, port: int, api_key: str = ""):
        if self._httpd is not None:
            return
        try:
            httpd = http.server.ThreadingHTTPServer((host, int(port)), _APIHandler)
        except Exception as e:
            GLOBAL_LOGGER.log(f"[api] failed to bind {host}:{port} -> {e}")
            return
        httpd.daemon_threads = True
        httpd.trainer = self.trainer
        httpd.cfg = self.cfg
        httpd.api_key = api_key or ""
        self._httpd = httpd
        self._bound = (host, int(port), api_key or "")
        self._thread = threading.Thread(target=httpd.serve_forever, daemon=True)
        self._thread.start()
        GLOBAL_LOGGER.log(f"[api] OpenAI-compatible server ON -> http://{host}:{port}/v1 "
                          f"(auth {'required' if api_key else 'open'})")

    def stop(self):
        if self._httpd is None:
            return
        try:
            self._httpd.shutdown()
            self._httpd.server_close()
        except Exception:
            pass
        self._httpd = None
        self._thread = None
        self._bound = None
        GLOBAL_LOGGER.log("[api] server OFF")

    def apply_settings(self):
        """Called from the UI loop: reconcile server state with cfg (item 16)."""
        want = (self.cfg.api_host, int(self.cfg.api_port), self.cfg.api_key or "")
        if self.cfg.api_enabled:
            if self.running and self._bound != want:
                self.stop()
            if not self.running:
                self.start(*want)
        elif self.running:
            self.stop()


# =====================================================================
# CLIPBOARD HELPERS
# =====================================================================
def copy_to_clipboard(text: str):
    try:
        pygame.scrap.init()
        pygame.scrap.put(pygame.SCRAP_TEXT, text.encode("utf-8"))
        return True
    except Exception:
        pass
    try:
        import tkinter as tk
        r = tk.Tk(); r.withdraw(); r.clipboard_clear(); r.clipboard_append(text); r.update(); r.destroy()
        return True
    except Exception:
        return False


def get_clipboard() -> Optional[str]:
    try:
        pygame.scrap.init()
        for t in (pygame.SCRAP_TEXT, "UTF8_STRING", "text/plain"):
            raw = pygame.scrap.get(t)
            if raw:
                return raw.decode("utf-8", errors="ignore") if isinstance(raw, bytes) else str(raw)
    except Exception:
        pass
    try:
        import tkinter as tk
        r = tk.Tk(); r.withdraw()
        txt = r.clipboard_get(); r.destroy()
        return txt
    except Exception:
        return None


def native_save_file_dialog(default_name: str, initial_dir: str, filetypes=(("JSON", "*.json"),)) -> Optional[str]:
    """OS-native save picker via tkinter, per request ('use the OS's built-in file
    save picker etc.'). Falls back to a fixed path in checkpoint_dir if tkinter/Tk
    display isn't available (e.g. headless), logging clearly why."""
    if not HAS_TK:
        return None
    try:
        root = tk.Tk()
        root.withdraw()
        root.attributes("-topmost", True)
        path = filedialog.asksaveasfilename(
            title="Export chat", initialdir=initial_dir, initialfile=default_name,
            defaultextension=".json", filetypes=list(filetypes) + [("All files", "*.*")])
        root.destroy()
        return path or None
    except Exception as e:
        GLOBAL_LOGGER.log(f"[export] native file dialog failed ({e}); falling back to default path")
        return None


# =====================================================================
# FULL MARKDOWN PARSER
# Produces a flat list of (style, text) spans plus block-level markers, supporting:
# **bold**, *italic* / _italic_, ***bold italic***, `inline code`, ```code blocks```,
# # / ## / ### headers, > blockquotes, - / * / 1. lists, --- horizontal rules,
# and [label](url)-style links (rendered as underlined accent text; url kept for
# potential click-through but not auto-opened, per no-surprise-network-action policy).
# Returns a list of "blocks", each a dict describing how to lay it out -- richer than
# v10's single-pass inline bold/italic regex, enough to call "full" support for a
# terminal-style chat renderer (not a browser-grade CommonMark implementation, but
# covers every construct commonly produced in chat text).
# =====================================================================
def parse_markdown_full(text: str) -> List[dict]:
    blocks = []
    lines = text.split("\n")
    i = 0
    list_counter = 0
    while i < len(lines):
        line = lines[i]

        if line.strip().startswith("```"):
            lang = line.strip()[3:].strip()
            code_lines = []
            i += 1
            while i < len(lines) and not lines[i].strip().startswith("```"):
                code_lines.append(lines[i])
                i += 1
            i += 1
            blocks.append({"type": "code_block", "lang": lang, "text": "\n".join(code_lines)})
            continue

        if re.match(r"^#{1,3}\s", line):
            level = len(line) - len(line.lstrip("#"))
            content = line.lstrip("#").strip()
            blocks.append({"type": "header", "level": min(level, 3), "spans": _parse_inline_md(content)})
            i += 1
            continue

        if line.strip().startswith(">"):
            content = line.strip().lstrip(">").strip()
            blocks.append({"type": "blockquote", "spans": _parse_inline_md(content)})
            i += 1
            continue

        if re.match(r"^\s*(-{3,}|\*{3,})\s*$", line):
            blocks.append({"type": "hr"})
            i += 1
            continue

        m_ul = re.match(r"^\s*[-*]\s+(.*)", line)
        m_ol = re.match(r"^\s*(\d+)\.\s+(.*)", line)
        if m_ul:
            blocks.append({"type": "list_item", "ordered": False, "index": None,
                           "spans": _parse_inline_md(m_ul.group(1))})
            i += 1
            continue
        if m_ol:
            blocks.append({"type": "list_item", "ordered": True, "index": int(m_ol.group(1)),
                           "spans": _parse_inline_md(m_ol.group(2))})
            i += 1
            continue

        if line.strip() == "":
            blocks.append({"type": "blank"})
            i += 1
            continue

        blocks.append({"type": "para", "spans": _parse_inline_md(line)})
        i += 1

    return blocks


def _parse_inline_md(text: str) -> List[Tuple[str, str]]:
    """Inline-level spans: bold / italic / bold_italic / code / link / normal."""
    spans = []
    pos = 0
    pattern = re.compile(
        r"(\*\*\*[^*]+\*\*\*)"    # ***bold italic***
        r"|(\*\*[^*]+\*\*)"       # **bold**
        r"|(\*[^*]+\*)"           # *italic*
        r"|(_[^_]+_)"             # _italic_
        r"|(`[^`]+`)"             # `code`
        r"|(\[[^\]]+\]\([^)]+\))" # [label](url)
    )
    for m in pattern.finditer(text):
        if m.start() > pos:
            spans.append(("normal", text[pos:m.start()]))
        tok = m.group(0)
        if tok.startswith("***"):
            spans.append(("bold_italic", tok[3:-3]))
        elif tok.startswith("**"):
            spans.append(("bold", tok[2:-2]))
        elif tok.startswith("*"):
            spans.append(("italic", tok[1:-1]))
        elif tok.startswith("_"):
            spans.append(("italic", tok[1:-1]))
        elif tok.startswith("`"):
            spans.append(("code", tok[1:-1]))
        elif tok.startswith("["):
            lm = re.match(r"\[([^\]]+)\]\(([^)]+)\)", tok)
            spans.append(("link", lm.group(1) if lm else tok))
        pos = m.end()
    if pos < len(text):
        spans.append(("normal", text[pos:]))
    return spans or [("normal", text)]


# =====================================================================
# GUI WIDGETS
# =====================================================================
class TextBox:
    """Right-click = copy. Triple-click = clear/delete. Click+drag or Shift+arrows =
    select text (per request: 'allow me to select in between text to do edits')."""
    def __init__(self, rect, value="", numeric=False, label=""):
        self.rect = pygame.Rect(rect)
        self.value = _sanitize(str(value))
        self.numeric = numeric
        self.label = label
        self.active = False
        self.cursor = len(self.value)
        self.sel_anchor: Optional[int] = None   # selection start; None = no selection
        self._click_times: List[float] = []
        self._cursor_blink = time.time()
        self._dragging = False
        self._drag_origin = None
        self._selection_dragged = False

    def _sel_range(self) -> Optional[Tuple[int, int]]:
        if self.sel_anchor is None or self.sel_anchor == self.cursor:
            return None
        return (min(self.sel_anchor, self.cursor), max(self.sel_anchor, self.cursor))

    def _delete_selection(self) -> bool:
        r = self._sel_range()
        if r is None:
            return False
        lo, hi = r
        self.value = self.value[:lo] + self.value[hi:]
        self.cursor = lo
        self.sel_anchor = None
        return True

    def _char_index_at_x(self, font, px_x: int) -> int:
        rel = px_x - (self.rect.x + 6)
        disp = self.value if len(self.value) < 60 else "…" + self.value[-59:]
        best_i, best_d = 0, float("inf")
        for i in range(len(disp) + 1):
            w = font.size(disp[:i])[0]
            d = abs(w - rel)
            if d < best_d:
                best_d, best_i = d, i
        offset = 0 if len(self.value) < 60 else max(0, len(self.value) - 59)
        return min(len(self.value), offset + best_i)

    def handle_event(self, event, font=None):
        if event.type == pygame.MOUSEBUTTONDOWN and self.rect.collidepoint(event.pos):
            self.active = True
            now = time.time()
            if event.button == 1:
                self._click_times = [t for t in self._click_times if now - t < 0.6]
                self._click_times.append(now)
                if len(self._click_times) >= 3:
                    self.value = ""
                    self.cursor = 0
                    self.sel_anchor = None
                    self._click_times.clear()
                else:
                    if font is not None:
                        self.cursor = self._char_index_at_x(font, event.pos[0])
                    else:
                        self.cursor = len(self.value)
                    self.sel_anchor = self.cursor
                    self._dragging = True
                    self._drag_origin = event.pos
                    self._selection_dragged = False
            elif event.button == 3:
                sel = self._sel_range()
                text_to_copy = self.value[sel[0]:sel[1]] if sel else self.value
                if text_to_copy:
                    copy_to_clipboard(text_to_copy)
                    GLOBAL_LOGGER.log(f"[copy] '{self.label or 'field'}' copied")
        elif event.type == pygame.MOUSEBUTTONUP:
            if self._dragging and not self._selection_dragged:
                self.sel_anchor = None
            self._dragging = False
        elif event.type == pygame.MOUSEMOTION and self._dragging and self.active and font is not None:
            if self._drag_origin and abs(event.pos[0] - self._drag_origin[0]) >= 4:
                self._selection_dragged = True
                self.cursor = self._char_index_at_x(font, event.pos[0])
        elif event.type == pygame.MOUSEBUTTONDOWN and not self.rect.collidepoint(event.pos):
            self.active = False
            self._dragging = False
        elif event.type == pygame.KEYDOWN and self.active:
            mods = pygame.key.get_mods()
            shift = bool(mods & pygame.KMOD_SHIFT)
            ctrl = bool(mods & pygame.KMOD_CTRL)
            if ctrl and event.key == pygame.K_a:
                self.sel_anchor, self.cursor = 0, len(self.value)
            elif ctrl and event.key == pygame.K_v:
                txt = get_clipboard()
                if txt:
                    if self.numeric:
                        txt = "".join(c for c in txt if c in "0123456789.-e")
                    self._delete_selection()
                    self.value = _sanitize(self.value[:self.cursor] + txt + self.value[self.cursor:])
                    self.cursor += len(txt)
            elif ctrl and event.key == pygame.K_c:
                sel = self._sel_range()
                copy_to_clipboard(self.value[sel[0]:sel[1]] if sel else self.value)
            elif ctrl and event.key == pygame.K_x:
                sel = self._sel_range()
                if sel:
                    copy_to_clipboard(self.value[sel[0]:sel[1]])
                    self._delete_selection()
            elif event.key == pygame.K_BACKSPACE:
                if not self._delete_selection() and self.cursor > 0:
                    self.value = self.value[:self.cursor - 1] + self.value[self.cursor:]
                    self.cursor -= 1
            elif event.key == pygame.K_DELETE:
                if not self._delete_selection():
                    self.value = self.value[:self.cursor] + self.value[self.cursor + 1:]
            elif event.key == pygame.K_LEFT:
                new_cursor = max(0, self.cursor - 1)
                self.sel_anchor = self.sel_anchor if shift else None
                if shift and self.sel_anchor is None:
                    self.sel_anchor = self.cursor
                self.cursor = new_cursor
            elif event.key == pygame.K_RIGHT:
                new_cursor = min(len(self.value), self.cursor + 1)
                if shift and self.sel_anchor is None:
                    self.sel_anchor = self.cursor
                elif not shift:
                    self.sel_anchor = None
                self.cursor = new_cursor
            elif event.key in (pygame.K_RETURN, pygame.K_TAB):
                self.active = False
                self.sel_anchor = None
            elif event.unicode and (not self.numeric or event.unicode in "0123456789.-e"):
                self._delete_selection()
                self.value = _sanitize(self.value[:self.cursor] + event.unicode + self.value[self.cursor:])
                self.cursor += 1

    def draw(self, surf, font, colors, emoji_font=None):
        if self.label:
            surf.blit(font.render(self.label, True, colors["muted"]), (self.rect.x, self.rect.y - 16))
        draw_vertical_gradient(surf, self.rect, (18, 21, 60, 205), colors["input_bg"], 8)
        if self.active:
            draw_round_rect_glow(surf, colors["accent"], self.rect, 6, glow_alpha=35)
        border_c = colors["accent"] if self.active else colors["border"]
        draw_round_rect(surf, border_c, self.rect, 8, width=1)
        disp = self.value if len(self.value) < 60 else "…" + self.value[-59:]
        offset = 0 if len(self.value) < 60 else max(0, len(self.value) - 59)

        sel = self._sel_range()
        if sel:
            lo = max(0, sel[0] - offset)
            hi = max(0, sel[1] - offset)
            x0 = self.rect.x + 6 + font.size(disp[:lo])[0]
            x1 = self.rect.x + 6 + font.size(disp[:hi])[0]
            sel_rect = pygame.Rect(x0, self.rect.y + 4, max(1, x1 - x0), self.rect.height - 8)
            draw_round_rect(surf, (*colors["accent"], 90) if len(colors["accent"]) == 3 else colors["accent"], sel_rect, 2)

        _render_emoji_text(surf, (self.rect.x + 6, self.rect.centery - font.get_height() // 2), disp,
                           font, colors["text"], emoji_font)
        if self.active and int(time.time() * 2) % 2 == 0:
            cur_disp = max(0, self.cursor - offset)
            cx = self.rect.x + 6 + font.size(disp[:min(cur_disp, len(disp))])[0]
            pygame.draw.line(surf, colors["text"], (cx, self.rect.y + 4), (cx, self.rect.bottom - 4), 1)


class MultilineTextBox:
    """Prompt input. Supports emoji (via _sanitize), click-drag text selection,
    Shift+Enter newline, triple-click clear, right-click copy."""
    def __init__(self, rect, visible_lines=3):
        self.rect = pygame.Rect(rect)
        self.text = ""
        self.placeholder = "Type a message... (Enter=send, Shift+Enter=newline, emoji OK)"
        self.active = False
        self.scroll_line = 0
        self.visible_lines = visible_lines
        self._click_times: List[float] = []
        self.cursor = 0
        self.sel_anchor: Optional[int] = None
        self._dragging = False
        self._drag_origin = None
        self._selection_dragged = False

    def _sel_range(self) -> Optional[Tuple[int, int]]:
        if self.sel_anchor is None or self.sel_anchor == self.cursor:
            return None
        return (min(self.sel_anchor, self.cursor), max(self.sel_anchor, self.cursor))

    def _delete_selection(self) -> bool:
        r = self._sel_range()
        if r is None:
            return False
        lo, hi = r
        self.text = self.text[:lo] + self.text[hi:]
        self.cursor = lo
        self.sel_anchor = None
        return True

    def _wrap_indexed(self, font, max_w):
        """Wrap into (line_text, absolute_start_index) pairs so the caret can be
        mapped between character index and (line, column) -- item 17."""
        lines = []
        idx = 0
        for para in self.text.split("\n"):
            if para == "":
                lines.append(("", idx))
            else:
                cur, cur_start = "", idx
                for w in para.split(" "):
                    trial = (cur + " " + w) if cur else w
                    if font.size(trial)[0] > max_w and cur:
                        lines.append((cur, cur_start))
                        cur_start = cur_start + len(cur) + 1
                        cur = w
                    else:
                        cur = trial
                lines.append((cur, cur_start))
            idx += len(para) + 1
        return lines or [("", 0)]

    def _wrap(self, font, max_w):
        return [t for t, _ in self._wrap_indexed(font, max_w)]

    def _caret_line_col(self, font):
        lines = self._wrap_indexed(font, self.rect.width - 16)
        li = 0
        for i, (t, s) in enumerate(lines):
            if s <= self.cursor <= s + len(t):
                li = i
            elif s > self.cursor:
                break
        t, s = lines[li]
        return li, max(0, min(self.cursor - s, len(t)))

    def _index_at(self, font, pos):
        """Character index under a mouse position (click places the caret)."""
        lines = self._wrap_indexed(font, self.rect.width - 16)
        line_h = font.get_height() + 3
        li = self.scroll_line + max(0, (pos[1] - self.rect.y - 7) // line_h)
        li = max(0, min(li, len(lines) - 1))
        text, start = lines[li]
        rel = pos[0] - (self.rect.x + 8)
        best_i, best_d = 0, float("inf")
        for i in range(len(text) + 1):
            d = abs(font.size(text[:i])[0] - rel)
            if d < best_d:
                best_d, best_i = d, i
        return min(len(self.text), start + best_i)

    def handle_event(self, event, send_on_enter, on_send, font=None):
        if event.type == pygame.MOUSEBUTTONDOWN and self.rect.collidepoint(event.pos):
            self.active = True
            now = time.time()
            if event.button == 1:
                self._click_times = [t for t in self._click_times if now - t < 0.6]
                self._click_times.append(now)
                if len(self._click_times) >= 3:
                    self.text = ""
                    self.cursor = 0
                    self.sel_anchor = None
                    self._click_times.clear()
                else:
                    # item 17: click places the caret at the true position
                    self.cursor = self._index_at(font, event.pos) if font is not None else len(self.text)
                    self.sel_anchor = self.cursor
                    self._dragging = True
                    self._drag_origin = event.pos
                    self._selection_dragged = False
            elif event.button == 3 and self.text:
                sel = self._sel_range()
                copy_to_clipboard(self.text[sel[0]:sel[1]] if sel else self.text)
        elif event.type == pygame.MOUSEBUTTONUP:
            if self._dragging and not self._selection_dragged:
                self.sel_anchor = None
            self._dragging = False
        elif event.type == pygame.MOUSEMOTION and self._dragging and self.active and font is not None:
            if self._drag_origin and (abs(event.pos[0] - self._drag_origin[0]) >= 4 or
                                      abs(event.pos[1] - self._drag_origin[1]) >= 4):
                self._selection_dragged = True
                self.cursor = self._index_at(font, event.pos)   # intentional drag-select
        elif event.type == pygame.MOUSEBUTTONDOWN and not self.rect.collidepoint(event.pos):
            self.active = False
        elif event.type == pygame.MOUSEWHEEL and self.rect.collidepoint(pygame.mouse.get_pos()):
            self.scroll_line = max(0, self.scroll_line - event.y)
        elif event.type == pygame.KEYDOWN and self.active:
            mods = pygame.key.get_mods()
            shift = bool(mods & pygame.KMOD_SHIFT)
            ctrl = bool(mods & pygame.KMOD_CTRL)
            if ctrl and event.key == pygame.K_a:
                self.sel_anchor, self.cursor = 0, len(self.text)
            elif ctrl and event.key == pygame.K_v:
                txt = get_clipboard()
                if txt:
                    self._delete_selection()
                    self.text = _sanitize(self.text[:self.cursor] + txt + self.text[self.cursor:])
                    self.cursor += len(txt)
            elif ctrl and event.key == pygame.K_c:
                sel = self._sel_range()
                copy_to_clipboard(self.text[sel[0]:sel[1]] if sel else self.text)
            elif event.key == pygame.K_RETURN:
                if shift or not send_on_enter:
                    self._delete_selection()
                    self.text = self.text[:self.cursor] + "\n" + self.text[self.cursor:]
                    self.cursor += 1
                else:
                    on_send()
                    self.cursor = 0
                    self.sel_anchor = None
            elif event.key == pygame.K_BACKSPACE:
                if not self._delete_selection() and self.cursor > 0:
                    self.text = self.text[:self.cursor - 1] + self.text[self.cursor:]
                    self.cursor -= 1
            elif event.key == pygame.K_DELETE:
                if not self._delete_selection():
                    self.text = self.text[:self.cursor] + self.text[self.cursor + 1:]
            elif event.key == pygame.K_LEFT:
                if shift and self.sel_anchor is None:
                    self.sel_anchor = self.cursor
                elif not shift:
                    self.sel_anchor = None
                self.cursor = max(0, self.cursor - 1)
            elif event.key == pygame.K_RIGHT:
                if shift and self.sel_anchor is None:
                    self.sel_anchor = self.cursor
                elif not shift:
                    self.sel_anchor = None
                self.cursor = min(len(self.text), self.cursor + 1)
            elif event.key in (pygame.K_UP, pygame.K_DOWN) and font is not None:
                li, col = self._caret_line_col(font)
                lines = self._wrap_indexed(font, self.rect.width - 16)
                li2 = max(0, min(len(lines) - 1, li + (1 if event.key == pygame.K_DOWN else -1)))
                text2, start2 = lines[li2]
                self.cursor = start2 + min(col, len(text2))
                if not shift:
                    self.sel_anchor = None
            elif event.unicode and event.unicode.isprintable():
                self._delete_selection()
                self.text = _sanitize(self.text[:self.cursor] + event.unicode + self.text[self.cursor:])
                self.cursor += 1
            self.cursor = max(0, min(self.cursor, len(self.text)))

    def draw(self, surf, font, colors, emoji_font=None):
        draw_vertical_gradient(surf, self.rect, (18, 21, 64, 212), colors["input_bg"], 11)
        if self.active:
            draw_round_rect_glow(surf, colors["accent"], self.rect, 8, glow_alpha=30)
        draw_round_rect(surf, colors["accent"] if self.active else colors["border"], self.rect, 11, width=1)
        mw = self.rect.width - 16
        lines = self._wrap_indexed(font, mw)
        line_h = font.get_height() + 3
        # item 17: the view FOLLOWS the caret -- typing beyond the visible area
        # auto-scrolls so the caret line is always on screen.
        if self.active:
            li, _col = self._caret_line_col(font)
            if li < self.scroll_line:
                self.scroll_line = li
            elif li >= self.scroll_line + self.visible_lines:
                self.scroll_line = li - self.scroll_line + 1
        self.scroll_line = max(0, min(self.scroll_line, max(0, len(lines) - self.visible_lines)))
        if not self.text and not self.active:
            ph = font.render(self.placeholder, True, colors["muted"])
            surf.blit(ph, (self.rect.x + 8, self.rect.y + 7))
            return
        y = self.rect.y + 7
        clip = surf.get_clip()
        surf.set_clip(self.rect.inflate(-4, -4))
        sel = self._sel_range()
        for text, start in lines[self.scroll_line:self.scroll_line + self.visible_lines + 1]:
            if sel:
                lo = max(sel[0], start) - start
                hi = min(sel[1], start + len(text)) - start
                if hi > lo >= 0:
                    x0 = self.rect.x + 8 + font.size(text[:lo])[0]
                    x1 = self.rect.x + 8 + font.size(text[:hi])[0]
                    draw_round_rect(surf, (139, 91, 225, 150), pygame.Rect(x0, y, max(1, x1 - x0), line_h - 2), 3)
            _render_emoji_text(surf, (self.rect.x + 8, y), text, font, colors["text"], emoji_font)
            y += line_h
        # blinking caret at the true (line, column)
        if self.active and int(time.time() * 2) % 2 == 0:
            li, col = self._caret_line_col(font)
            if self.scroll_line <= li < self.scroll_line + self.visible_lines + 1:
                t_li, _s = lines[li]
                cx = self.rect.x + 8 + font.size(t_li[:col])[0]
                cy = self.rect.y + 7 + (li - self.scroll_line) * line_h
                pygame.draw.line(surf, colors["text"], (cx, cy), (cx, cy + line_h - 4), 1)
        surf.set_clip(clip)
        # slim elegant scroll indicator on the right edge
        if len(lines) > self.visible_lines:
            track_h = self.rect.height - 12
            frac_h = max(14, int(track_h * self.visible_lines / len(lines)))
            frac_y = int((track_h - frac_h) * (self.scroll_line / max(1, len(lines) - self.visible_lines)))
            draw_round_rect(surf, colors["scroll_thumb"],
                            pygame.Rect(self.rect.right - 7, self.rect.y + 6 + frac_y, 4, frac_h), 2)


class Checkbox:
    def __init__(self, x, y, label, value, size=16):
        self.rect = pygame.Rect(x, y, size, size)
        self.label = label
        self.value = value

    def handle_event(self, event):
        if event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
            hit = pygame.Rect(self.rect.x, self.rect.y, self.rect.width + 8 + 7 * len(self.label), self.rect.height)
            if hit.collidepoint(event.pos):
                self.value = not self.value
                return True
        return False

    def draw(self, surf, font, colors):
        draw_round_rect(surf, colors["input_bg"], self.rect, 6)
        draw_round_rect(surf, colors["good"] if self.value else colors["border"], self.rect, 6, width=1)
        if self.value:
            inner = self.rect.inflate(-6, -6)
            draw_round_rect_glow(surf, colors["good"], self.rect, 6, 35)
            draw_round_rect(surf, colors["good"], inner, 4)
        lbl = font.render(self.label, True, colors["text"])
        surf.blit(lbl, (self.rect.right + 8, self.rect.centery - lbl.get_height() // 2))

    def label_width(self, font):
        return self.rect.width + 8 + font.size(self.label)[0]


class Dropdown:
    """Copied structurally from v10, per request ('copy its dropdown logic for all
    relevant dropdown fields'), extended only with AA rounding + hover glow to match
    v11's visual language."""
    def __init__(self, rect, options, value, label=""):
        self.rect = pygame.Rect(rect)
        self.options = options
        self.value = value
        self.label = label
        self.open = False

    def handle_event(self, event):
        if event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
            if self.rect.collidepoint(event.pos):
                self.open = not self.open
                return True
            if self.open:
                for i, opt in enumerate(self.options):
                    r = pygame.Rect(self.rect.x, self.rect.bottom + i * self.rect.height,
                                     self.rect.width, self.rect.height)
                    if r.collidepoint(event.pos):
                        self.value = opt
                        self.open = False
                        return True
                self.open = False
        return False

    def draw_closed(self, surf, font, colors):
        if self.label:
            surf.blit(font.render(self.label, True, colors["muted"]), (self.rect.x, self.rect.y - 16))
        draw_vertical_gradient(surf, self.rect, (38, 39, 91, 210), colors["input_bg"], 8)
        draw_round_rect(surf, colors["accent"] if self.open else colors["border"], self.rect, 8, width=1)
        txt = font.render(str(self.value), True, colors["text"])
        surf.blit(txt, (self.rect.x + 8, self.rect.centery - txt.get_height() // 2))
        ax, ay = self.rect.right - 14, self.rect.centery
        pygame.draw.polygon(surf, colors["text"], [(ax - 5, ay - 3), (ax + 5, ay - 3), (ax, ay + 4)])

    def draw_open_overlay(self, surf, font, colors):
        if not self.open:
            return
        for i, opt in enumerate(self.options):
            r = pygame.Rect(self.rect.x, self.rect.bottom + i * self.rect.height, self.rect.width, self.rect.height)
            hov = r.collidepoint(pygame.mouse.get_pos())
            draw_glass_panel(surf, r, 7, colors["accent"] if hov else colors["border"], aurora=hov)
            t = font.render(str(opt), True, colors["text"])
            surf.blit(t, (r.x + 8, r.centery - t.get_height() // 2))


class Button:
    def __init__(self, rect, text, action, color=None):
        self.rect = pygame.Rect(rect)
        self.text = text
        self.action = action
        self.color = color or COLORS["border"]
        self.enabled = True

    def clicked(self, pos):
        return self.enabled and self.rect.collidepoint(pos)

    def draw(self, surf, font, hover, colors):
        if hover and self.enabled:
            draw_round_rect_glow(surf, self.color, self.rect, 7, glow_alpha=45)
        top = (88, 52, 137, 220) if (hover and self.enabled) else (40, 39, 88, 190)
        draw_vertical_gradient(surf, self.rect, top, colors["button_bg"], 9)
        c = self.color if self.enabled else colors["muted"]
        draw_round_rect(surf, c, self.rect, 9, width=1)
        t = font.render(self.text, True, colors["text"] if self.enabled else colors["muted"])
        surf.blit(t, (self.rect.centerx - t.get_width() // 2, self.rect.centery - t.get_height() // 2))


class SmallIconButton:
    """Small round-ish icon button for the 'continue inference' play button placed
    near Send, per request ('non-ui-blocking'). Draws a simple play triangle."""
    def __init__(self, rect, action, color):
        self.rect = pygame.Rect(rect)
        self.action = action
        self.color = color
        self.enabled = True

    def clicked(self, pos):
        return self.enabled and self.rect.collidepoint(pos)

    def draw(self, surf, hover, colors):
        """Item 19: restyled continue button -- frosted glass pill with aurora
        sheen, glowing ring and a crisp anti-aliased play glyph."""
        r = self.rect
        if self.enabled:
            draw_round_rect_glow(surf, self.color, r, r.width // 2,
                                 glow_alpha=70 if hover else 35)
        draw_glass_panel(surf, r, r.width // 2,
                         border_col=self.color if self.enabled else colors["muted"])
        c = self.color if self.enabled else colors["muted"]
        cx, cy = r.center
        ring_r = max(8, min(r.width, r.height) // 2 - 10)
        pygame.draw.circle(surf, c, (cx, cy), ring_r, 2)
        s = ring_r * 0.55
        pygame.draw.polygon(surf, c, [(cx - s * 0.55, cy - s), (cx - s * 0.55, cy + s),
                                      (cx + s * 0.85, cy)])


class ScrollThumb:
    """Draggable scrollbar thumb for the settings panel, per exact request:
    'cyan blue draggable scroll button about 0.5cm thick and 3cm tall'."""
    def __init__(self, track_rect):
        self.track = pygame.Rect(track_rect)
        self.thickness_px = max(6, int(0.5 * CM_TO_PX))
        self.length_px = max(20, int(3.0 * CM_TO_PX))
        self.dragging = False
        self.drag_offset_y = 0
        self.scroll_frac = 0.0   # 0..1

    def thumb_rect(self) -> pygame.Rect:
        track_h = self.track.height
        travel = max(1, track_h - self.length_px)
        y = self.track.y + int(self.scroll_frac * travel)
        x = self.track.centerx - self.thickness_px // 2
        return pygame.Rect(x, y, self.thickness_px, self.length_px)

    def handle_event(self, event, content_h: int, viewport_h: int) -> Optional[int]:
        """Returns new scroll_offset_px if changed, else None."""
        max_scroll = max(0, content_h - viewport_h)
        thumb = self.thumb_rect()
        if event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
            if thumb.collidepoint(event.pos):
                self.dragging = True
                self.drag_offset_y = event.pos[1] - thumb.y
                return None
            elif self.track.collidepoint(event.pos):
                travel = max(1, self.track.height - self.length_px)
                frac = (event.pos[1] - self.track.y - self.length_px / 2) / travel
                self.scroll_frac = max(0.0, min(1.0, frac))
                return int(self.scroll_frac * max_scroll)
        elif event.type == pygame.MOUSEBUTTONUP:
            self.dragging = False
        elif event.type == pygame.MOUSEMOTION and self.dragging:
            travel = max(1, self.track.height - self.length_px)
            new_y = event.pos[1] - self.drag_offset_y - self.track.y
            self.scroll_frac = max(0.0, min(1.0, new_y / travel))
            return int(self.scroll_frac * max_scroll)
        return None

    def set_from_scroll(self, scroll_offset_px: int, content_h: int, viewport_h: int):
        max_scroll = max(1, content_h - viewport_h)
        self.scroll_frac = max(0.0, min(1.0, scroll_offset_px / max_scroll))

    def draw(self, surf, colors):
        draw_round_rect(surf, colors["scroll_track"], self.track, self.thickness_px // 2)
        thumb = self.thumb_rect()
        hov = thumb.collidepoint(pygame.mouse.get_pos())
        color = colors["scroll_thumb_hov"] if (hov or self.dragging) else colors["scroll_thumb"]
        draw_round_rect(surf, color, thumb, self.thickness_px // 2)


# =====================================================================
# CONSOLE PANEL (item 18)
# =====================================================================
class ConsolePanel:
    """Stylish console below the chat + send row: green terminal text in the
    app's mono font, smoothly scrollable with an elegant slim scrollbar, and it
    renders GLOBAL_LOGGER (application / training / API events). Auto-sticks to
    the newest line unless the user scrolls up."""
    def __init__(self, rect):
        self.rect = pygame.Rect(rect)
        self.scroll = 0.0
        self.autoscroll = True

    def set_rect(self, rect):
        self.rect = pygame.Rect(rect)

    def handle_scroll(self, pos, dy) -> bool:
        if self.rect.collidepoint(pos):
            self.scroll -= dy * 24
            self.autoscroll = False
            return True
        return False

    def draw(self, surf, font, colors):
        draw_glass_panel(surf, self.rect, 12, border_col=(66, 210, 160, 110), aurora=False)
        draw_round_rect(surf, colors["console_bg"], self.rect.inflate(-2, -2), 10)
        lines = GLOBAL_LOGGER.get_lines()
        line_h = font.get_height() + 2
        content_h = len(lines) * line_h + 12
        max_scroll = max(0, content_h - self.rect.height)
        if self.autoscroll:
            self.scroll = max_scroll
        self.scroll = max(0.0, min(self.scroll, float(max_scroll)))
        if self.scroll >= max_scroll - 2:
            self.autoscroll = True
        prev = surf.get_clip()
        surf.set_clip(self.rect.inflate(-6, -6))
        y = self.rect.y + 6 - self.scroll
        max_w = self.rect.width - 26
        for ln in lines:
            if y + line_h >= self.rect.y and y <= self.rect.bottom:
                txt = ln
                while txt and font.size(txt)[0] > max_w:
                    txt = txt[:-4] + "..." if len(txt) > 4 else txt[:-1]
                surf.blit(font.render(txt, True, colors["console_green"]),
                          (self.rect.x + 10, y))
            y += line_h
        surf.set_clip(prev)
        if content_h > self.rect.height:
            track_h = self.rect.height - 12
            th = max(18, int(track_h * self.rect.height / content_h))
            ty = int((track_h - th) * (self.scroll / max(1, max_scroll)))
            draw_round_rect(surf, colors["scroll_thumb"],
                            pygame.Rect(self.rect.right - 8, self.rect.y + 6 + ty, 4, th), 2)


# =====================================================================
# CHAT PANEL
# Bugfix vs v9 (per request: 'ensure chat messages dont render out of bounds or to
# the sides/unreadable in weird ways'): v9 wrapped against a fixed `max_w` computed
# once from panel width but never re-clamped per-word against the ACTUAL bubble
# width after padding was applied, so long unbroken tokens (URLs, long numbers, code)
# could push bubbles past the panel edge. Fix: every word is clamped to fit within
# `max_bw` (panel width minus padding minus bubble margin) BEFORE bubble width is
# computed, and any single word still wider than that gets hard-broken character by
# character so it can never exceed the panel -- no token, however long, can escape
# the visible area.
# =====================================================================
class ChatPanel:
    def __init__(self, rect):
        self.rect = pygame.Rect(rect)
        self.turns: List[dict] = []
        self.scroll = 10 ** 9
        # FIX (primary perf): per-turn layout cache. Previously every frame re-ran
        # full markdown parse + word-wrap + height/width measurement for *every*
        # historical turn at 60 fps. With dozens of messages this alone made the
        # UI (and therefore perceived generation) crawl even when the model only
        # saw the latest message. Cache is keyed by (text, meta, max_bw, parse_md)
        # so a turn is laid out exactly once unless the panel is resized or the
        # content itself changes.
        self._layout_cache: Dict[tuple, Tuple[list, int, int]] = {}
        self._cache_max_bw: int = -1
        # Chat scrollbar (cyan thumb, same language as settings) -- track sits
        # inside the right edge of the panel so it never overlaps bubbles.
        self._scroll_thumb: Optional[ScrollThumb] = None
        self._content_h = 0
        self._rebuild_scrollbar()

    def _rebuild_scrollbar(self):
        # Track is 14 px wide, inset 4 px from the panel's right edge.
        track = pygame.Rect(self.rect.right - 18, self.rect.y + 4,
                            14, max(20, self.rect.height - 8))
        if self._scroll_thumb is None:
            self._scroll_thumb = ScrollThumb(track)
        else:
            self._scroll_thumb.track = track

    def set_rect(self, rect):
        self.rect = pygame.Rect(rect)
        self._rebuild_scrollbar()
        self._layout_cache.clear()  # force re-layout on resize

    def add(self, role, text, meta="", timestamp: Optional[float] = None):
        self.turns.append({
            "role": role, "text": _sanitize(text), "meta": meta,
            "ts": timestamp if timestamp is not None else time.time(),
        })
        self.scroll = 10 ** 9

    def update_last(self, text: str, meta: str = ""):
        """Live-update the most recent turn (used by streaming)."""
        if not self.turns:
            self.add("model", text, meta)
            return
        t = self.turns[-1]
        t["text"] = _sanitize(text)
        if meta:
            t["meta"] = meta
        # PERF (snappy generation): do NOT clear the whole layout cache here.
        # The cache is keyed by turn text, so the updated turn naturally gets a
        # fresh entry while all historical turns stay cached. The old clear()
        # forced a full markdown re-parse + re-wrap of EVERY turn at 60 fps
        # during streaming, starving the generation thread of the GIL -- the
        # classic 'UI makes generation crawl' bug.
        self.scroll = 10 ** 9

    def clear(self):
        self.turns.clear()
        self.scroll = 0
        self._layout_cache.clear()

    def handle_scroll(self, pos, dy):
        if self.rect.collidepoint(pos):
            self.scroll = max(0, self.scroll - dy * 30)
            if self._scroll_thumb is not None:
                self._scroll_thumb.set_from_scroll(self.scroll, self._content_h, self.rect.height)

    def handle_scrollbar_event(self, event) -> bool:
        """Returns True if the event was consumed by the chat scrollbar."""
        if self._scroll_thumb is None:
            return False
        new_off = self._scroll_thumb.handle_event(event, self._content_h, self.rect.height)
        if new_off is not None:
            self.scroll = new_off
            return True
        # also consume if click was on the track even if no movement yet
        if event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
            if self._scroll_thumb.track.collidepoint(event.pos) or self._scroll_thumb.thumb_rect().collidepoint(event.pos):
                return True
        return False

    def _hard_break_word(self, font, word, max_w):
        """A single token too wide for the panel gets split char-by-char so it can
        never overflow, regardless of content (long URLs, hashes, no-space pastes)."""
        pieces, cur = [], ""
        for ch in word:
            trial = cur + ch
            if font.size(trial)[0] > max_w and cur:
                pieces.append(cur)
                cur = ch
            else:
                cur = trial
        if cur:
            pieces.append(cur)
        return pieces

    def _wrap_plain(self, font, text, max_w):
        words = text.split(" ")
        lines, cur = [], ""
        for w in words:
            if font.size(w)[0] > max_w:
                if cur:
                    lines.append(cur); cur = ""
                for piece in self._hard_break_word(font, w, max_w):
                    lines.append(piece)
                continue
            trial = (cur + " " + w).strip() if cur else w
            if font.size(trial)[0] > max_w and cur:
                lines.append(cur); cur = w
            else:
                cur = trial
        if cur or not lines:
            lines.append(cur)
        return lines

    def _layout_blocks(self, font, font_bold, font_italic, font_code, font_small,
                        text, max_bw, parse_md):
        """Returns (render_lines, plain_lines_for_width_calc). render_lines is a list
        of dicts: {type, spans:[(style,text)], ...} ready to draw, ALL already
        wrapped so nothing can exceed max_bw."""
        if not parse_md:
            plain_lines = self._wrap_plain(font, text, max_bw - 16)
            return [{"type": "para", "lines": [[("normal", l)] for l in plain_lines]}], plain_lines

        blocks = parse_markdown_full(text)
        out = []
        all_plain_lines = []
        for b in blocks:
            if b["type"] == "code_block":
                code_lines = b["text"].split("\n") or [""]
                wrapped_code = []
                for cl in code_lines:
                    wrapped_code.extend(self._wrap_plain(font_code, cl, max_bw - 20) or [""])
                out.append({"type": "code_block", "lines": wrapped_code, "lang": b.get("lang", "")})
                all_plain_lines.extend(wrapped_code)
                continue
            if b["type"] == "hr":
                out.append({"type": "hr"})
                continue
            if b["type"] == "blank":
                out.append({"type": "blank"})
                continue

            spans = b.get("spans", [])
            flat_text = "".join(s[1] for s in spans)
            wrapped = self._wrap_plain(font, flat_text, max_bw - 16 -
                                        (18 if b["type"] == "list_item" else 0) -
                                        (10 if b["type"] == "blockquote" else 0))
            # re-attach style info per wrapped line by walking spans in order
            styled_lines = []
            span_idx, span_pos = 0, 0
            for line in wrapped:
                remaining = line
                line_spans = []
                consumed = 0
                while consumed < len(line) and span_idx < len(spans):
                    style, s_text = spans[span_idx]
                    avail = s_text[span_pos:]
                    take = min(len(avail), len(line) - consumed)
                    if take > 0:
                        line_spans.append((style, avail[:take]))
                        consumed += take
                        span_pos += take
                    if span_pos >= len(s_text):
                        span_idx += 1
                        span_pos = 0
                    if take == 0:
                        break
                styled_lines.append(line_spans or [("normal", line)])
            out.append({"type": b["type"], "lines": styled_lines,
                       "level": b.get("level"), "ordered": b.get("ordered"), "index": b.get("index")})
            all_plain_lines.extend(wrapped)
        return out, all_plain_lines

    def draw(self, surf, font, font_small, font_bold, font_italic, font_code, colors, parse_md=True, emoji_font=None):
        draw_glass_panel(surf, self.rect, 16)
        pad = 10
        sb_w = 20  # reserved for the cyan scrollbar on the right (never overlaps bubbles)
        bubble_margin = 12
        max_bw = self.rect.width - 2 * pad - bubble_margin - sb_w
        line_h = font.get_height() + 4

        # Invalidate cache on panel resize (max_bw change)
        if max_bw != self._cache_max_bw:
            self._layout_cache.clear()
            self._cache_max_bw = max_bw

        prepared = []
        for turn in self.turns:
            cache_key = (turn["text"], turn.get("meta", ""), max_bw, parse_md)
            cached = self._layout_cache.get(cache_key)
            if cached is not None:
                blocks, bh, bw = cached
            else:
                blocks, plain_lines = self._layout_blocks(
                    font, font_bold, font_italic, font_code, font_small,
                    turn["text"], max_bw, parse_md)
                widest = 0
                n_lines = 0
                for blk in blocks:
                    if blk["type"] in ("hr", "blank"):
                        n_lines += 1
                        continue
                    for line in blk.get("lines", []):
                        n_lines += 1
                        if isinstance(line, list):
                            w = sum(font.size(t)[0] for _, t in line) + (
                                30 if blk["type"] == "code_block" else 0)
                        else:
                            w = font.size(line)[0]
                        widest = max(widest, w)
                bw = min(max(widest + 20, 40), max_bw)
                bh = n_lines * line_h + 16 + (
                    font_small.get_height() + 6 if turn["meta"] else 0)
                self._layout_cache[cache_key] = (blocks, bh, bw)
                # hard cap so a very long session can't grow the dict forever
                if len(self._layout_cache) > 400:
                    # drop oldest half (dict insertion order is preserved in 3.7+)
                    keys = list(self._layout_cache.keys())
                    for k in keys[:len(keys) // 2]:
                        del self._layout_cache[k]
            prepared.append((turn, blocks, bh, bw))

        content_h = sum(p[2] + 8 for p in prepared)
        max_scroll = max(0, content_h - self.rect.height + 2 * pad)
        self.scroll = max(0, min(self.scroll, max_scroll))

        prev_clip = surf.get_clip()
        surf.set_clip(self.rect.inflate(-2, -2))
        y = self.rect.y + pad - self.scroll
        for turn, blocks, bh, bw in prepared:
            if y + bh < self.rect.y or y > self.rect.bottom:
                y += bh + 8
                continue
            is_user, is_warn = turn["role"] == "user", turn["role"] == "warning"
            if is_warn:
                bx, bc, ec = self.rect.x + pad, colors["warn_bubble"], colors["warn"]
            elif is_user:
                bx = self.rect.right - pad - bw - (bubble_margin - 10)
                bc, ec = colors["user_bubble"], colors["user_border"]
            else:
                bx, bc, ec = self.rect.x + pad, colors["model_bubble"], colors["model_border"]
            # final hard clamp: bubble can never start before panel-left or extend past panel-right
            bx = max(self.rect.x + pad, min(bx, self.rect.right - pad - bw))
            br = pygame.Rect(bx, y, bw, bh)
            draw_round_rect_glow(surf, ec, br, 13, 16)
            draw_vertical_gradient(surf, br, bc, colors["panel_deep"], 13)
            draw_round_rect(surf, ec, br, 13, width=1)
            tc = colors["warn"] if is_warn else colors["text"]
            ty, tx = y + 8, bx + 8
            list_counters: Dict[int, int] = {}

            for blk in blocks:
                if blk["type"] == "blank":
                    ty += line_h * 0.6
                    continue
                if blk["type"] == "hr":
                    pygame.draw.line(surf, colors["border"], (bx + 8, ty + line_h // 2),
                                     (bx + bw - 8, ty + line_h // 2), 1)
                    ty += line_h
                    continue
                if blk["type"] == "code_block":
                    code_bg = pygame.Rect(bx + 4, ty, bw - 8, len(blk["lines"]) * (font_code.get_height() + 3) + 8)
                    draw_round_rect(surf, (10, 12, 15), code_bg, 5)
                    draw_round_rect(surf, colors["border"], code_bg, 5, width=1)
                    cy = ty + 4
                    for cl in blk["lines"]:
                        surf.blit(font_code.render(cl, True, colors["cyan"]), (bx + 10, cy))
                        cy += font_code.get_height() + 3
                    ty = cy + 4
                    continue

                prefix = ""
                indent = 0
                if blk["type"] == "header":
                    prefix = "#" * (blk.get("level") or 1) + " "
                elif blk["type"] == "blockquote":
                    pygame.draw.line(surf, colors["cyan"], (bx + 6, ty), (bx + 6, ty + line_h - 2), 3)
                    indent = 10
                elif blk["type"] == "list_item":
                    if blk.get("ordered"):
                        prefix = f"{blk.get('index', 1)}. "
                    else:
                        prefix = "• "
                    indent = 6

                for line_spans in blk["lines"]:
                    tx = bx + 8 + indent
                    if prefix:
                        pre_surf = font.render(prefix, True, colors["muted"])
                        surf.blit(pre_surf, (tx, ty))
                        tx += pre_surf.get_width()
                        prefix = ""  # only first line of a list item gets the bullet/number
                    for style, chunk in line_spans:
                        if style == "bold":
                            fnt, col = font_bold, tc
                        elif style == "italic":
                            fnt, col = font_italic, tc
                        elif style == "bold_italic":
                            fnt, col = font_bold, tc
                        elif style == "code":
                            fnt, col = font_code, colors["cyan"]
                        elif style == "link":
                            fnt, col = font, colors["accent"]
                        else:
                            fnt, col = font, tc
                        w = _render_emoji_text(surf, (tx, ty), chunk, fnt, col, emoji_font)
                        if style == "link":
                            rendered = fnt.render(chunk, True, col)
                            pygame.draw.line(surf, colors["accent"], (tx, ty + rendered.get_height()),
                                            (tx + rendered.get_width(), ty + rendered.get_height()), 1)
                        tx += w
                    if blk["type"] == "header":
                        pygame.draw.line(surf, colors["border"], (bx + 8, ty + line_h - 2),
                                        (bx + bw - 8, ty + line_h - 2), 1)
                    ty += line_h

            if turn["meta"]:
                ts_str = time.strftime("%H:%M:%S", time.localtime(turn["ts"]))
                meta_line = f"{turn['meta']}  ·  {ts_str}"
                surf.blit(font_small.render(meta_line, True, colors["muted"]), (bx + 8, ty + 2))
            y += bh + 8
        surf.set_clip(prev_clip)

        # Draw chat scrollbar (outside the clip so it is always visible)
        self._content_h = content_h
        if self._scroll_thumb is not None:
            self._rebuild_scrollbar()
            self._scroll_thumb.set_from_scroll(self.scroll, self._content_h, self.rect.height)
            self._scroll_thumb.draw(surf, colors)


# =====================================================================
# CHAT EXPORT (JSON, per request: who/when + model details + hyperparams)
# =====================================================================
def export_chat_json(chat: "ChatPanel", trainer: "Trainer", cfg: Config, model_path: str) -> dict:
    return {
        "exported_at": time.strftime("%Y-%m-%d %H:%M:%S"),
        "assistant_name": ASSISTANT_NAME,
        "model_details": {
            "checkpoint_path": model_path or "(none loaded)",
            "hyperparams": trainer._last_hparams_used or asdict(cfg),
            "vocab_size": trainer.codec.vocab_size,
            "encoding": trainer.codec.encoding_name,
            "epoch": trainer.epoch,
        },
        "messages": [
            {
                "role": t["role"],
                "text": t["text"],
                "timestamp": time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(t["ts"])),
                "timestamp_unix": t["ts"],
                "meta": t.get("meta", ""),
            }
            for t in chat.turns
        ],
    }


# =====================================================================
# MAIN GUI APPLICATION
# Layout is planned on a fixed coordinate grid (computed once, before drawing code
# was written) specifically so the request 'ensure no overlap-oopsies is even
# possible' can be verified by construction rather than by trial and error:
#
#   0-40            top HUD bar (title left, resource stats right)
#   44-166          two rows of top buttons: [Train][Stop][Pause/Resume]
#                                              [Load ckpt][Save ckpt][Reset mem]
#   174-252         progress/status panel (hyperparam line in yellow)
#   258-...         SCROLLABLE settings region (clipped viewport + draggable thumb)
#   ...-bottom      STATIC footer: checkboxes (recent/parse-md/finish-sentence/
#                   gpu-only), then [Start fine-tune] full width, then
#                   [Convert GGUF -> Aura] full width (bottom-most, per request)
#
# Right panel: generation param row, chat panel, prompt box + Send + small Play
# button + Export/Copy chat buttons, all on fixed y-offsets from the window edges
# so resizing doesn't need per-frame overlap math -- everything is anchored either
# to the top or to the bottom, never both interpolated.
# =====================================================================
def gui_main():
    pygame.init()
    try:
        pygame.scrap.init()
    except Exception:
        pass

    W, H = 1680, 1020
    LEFT_W = 500
    DISPLAY_FLAGS = pygame.RESIZABLE | pygame.NOFRAME
    screen = pygame.display.set_mode((W, H), DISPLAY_FLAGS)
    pygame.display.set_caption("AURA :: ASTRALIS v12 — stateful LM engine + aurora_astralis")
    clock = pygame.time.Clock()
    chrome = WindowChrome()
    orb_field = OrbField()

    # ---- dynamic fonts (scale with window width to avoid overlap) ----
    def _match_font_name(mono=False, emoji=False):
        if emoji:
            for name in ("segoe ui emoji", "seguiemj", "noto color emoji", "apple color emoji"):
                try:
                    if pygame.font.match_font(name):
                        return name
                except Exception:
                    pass
            return None
        prefs = (["cascadia mono", "consolas", "couriernew"] if mono
                 else ["segoe ui", "cascadia code", "verdana", "consolas"])
        for name in prefs:
            try:
                if pygame.font.match_font(name):
                    return name
            except Exception:
                pass
        return None

    def create_fonts(scale=1.0):
        # scale is relative to a baseline width of 1680
        def size(base):
            return max(10, int(round(base * scale)))
        emoji_name = _match_font_name(emoji=True)
        fonts = {}
        def make(base, bold=False, italic=False, mono=False, emoji=False):
            name = _match_font_name(mono=mono, emoji=emoji)
            if emoji and emoji_name:
                return pygame.font.SysFont(emoji_name, size(base))
            if name:
                return pygame.font.SysFont(name, size(base), bold=bold, italic=italic)
            return pygame.font.SysFont(None, size(base), bold=bold, italic=italic)
        fonts['font'] = make(15)
        fonts['font_big'] = make(19, bold=True)
        fonts['font_small'] = make(13)
        fonts['font_label'] = make(12)
        fonts['font_bold'] = make(15, bold=True)
        fonts['font_italic'] = make(15, italic=True)
        fonts['font_code'] = make(14, mono=True)
        fonts['font_yellow_hparam'] = make(12, mono=True)
        fonts['font_console'] = make(13, mono=True)
        fonts['font_emoji'] = make(15, emoji=True)
        return fonts

    # initialize fonts with baseline scale 1.0
    fonts = create_fonts(scale=1.0)
    font = fonts['font']
    font_big = fonts['font_big']
    font_small = fonts['font_small']
    font_label = fonts['font_label']
    font_bold = fonts['font_bold']
    font_italic = fonts['font_italic']
    font_code = fonts['font_code']
    font_yellow_hparam = fonts['font_yellow_hparam']
    font_console = fonts['font_console']
    font_emoji = fonts['font_emoji']

    # Generated sprites are loaded by OrbField from ui/ with a procedural fallback.

    settings_mgr = SettingsManager(CONFIG_PATH)
    cfg = load_or_create_config(settings_mgr)
    cfg.validate()

    monitor = ResourceMonitor()
    monitor.start()
    # Zero-state capture happens once, right here, after boot but before any model
    # work -- exactly the moment requested ("after the program has finished booting
    # up and is live").
    monitor.capture_zero_state()

    state = {
        "status": "idle", "epoch": 0, "epochs": cfg.epochs, "batch": 0, "n_batches": 0,
        "loss": None, "eta_sec": None, "sec_per_batch": None, "error": None,
        "convert_open": False, "settings_scroll_px": 0, "hparams": {}, "loaded_ckpt_path": "",
    }

    def log_fn(msg):
        GLOBAL_LOGGER.log(msg)

    loss_hist: List[float] = []   # item 20: per-step loss series for the chart

    def progress_fn(epoch, epochs, batch, n_batches, loss, eta_sec=None, sec_per_batch=None, hparams=None):
        state.update(epoch=epoch, epochs=epochs, batch=batch, n_batches=n_batches, loss=loss,
                     eta_sec=eta_sec, sec_per_batch=sec_per_batch, hparams=hparams or {})
        if loss is not None and loss == loss:
            loss_hist.append(float(loss))
            if len(loss_hist) > 600:
                del loss_hist[:300]

    trainer = Trainer(cfg, log_fn=log_fn, progress_fn=progress_fn)

    # ---- predicted VRAM readout (item 3): recomputed only when relevant config
    # fields change; derived from the real implementation via predict_vram_usage().
    vram_pred_cache = {"key": None, "train_text": "", "infer_text": ""}

    def predicted_vram_text() -> str:
        key = (cfg.d_model, cfg.n_layers, cfg.n_heads, cfg.kernel_size, cfg.seq_len,
               cfg.batch_size, cfg.train_dtype, cfg.grad_checkpoint,
               cfg.use_transformer_attention, trainer.codec.vocab_size)
        if key != vram_pred_cache["key"]:
            try:
                p = predict_vram_usage(cfg, trainer.codec.vocab_size)
                gb = 1024 ** 3
                vram_pred_cache["train_text"] = (
                    f"predicted train VRAM ~{p['total']/gb:.2f}GB "
                    f"({p['low']/gb:.2f}-{p['high']/gb:.2f})  params {p['params']/1e6:.0f}M")
            except Exception as e:
                vram_pred_cache["train_text"] = f"predicted VRAM: n/a ({e})"
            try:
                ip = predict_inference_vram_usage(cfg, trainer.codec.vocab_size)
                gb = 1024 ** 3
                vram_pred_cache["infer_text"] = (
                    f"predicted infer VRAM ~{ip['with_margin']/gb:.2f}GB "
                    f"({ip['total']/gb:.2f} raw)  kv_cache {ip['kv_cache']/gb:.2f}GB  seq_len={cfg.seq_len}")
            except Exception as e:
                vram_pred_cache["infer_text"] = f"inference VRAM: n/a ({e})"
            vram_pred_cache["key"] = key
        return vram_pred_cache["train_text"]

    # ---- API server lifecycle + debounced settings persistence (items 15/16) ----
    api_server = OpenAIAPIServer(trainer, cfg)
    settings_dirty = {"at": None}

    def mark_settings_dirty():
        settings_dirty["at"] = time.time()

    ck = find_latest_checkpoint(cfg.checkpoint_dir)
    if ck:
        try:
            monitor.begin_reporting()
            trainer.load_checkpoint(ck)
            state["loaded_ckpt_path"] = ck
            log_fn(f"auto-loaded {ck}")
        except Exception as e:
            log_fn(f"checkpoint load failed: {e}")

    train_thread = [None]

    def is_busy():
        # FIX: also treat "stopping" and any live background thread as busy so
        # Load-ckpt / GGUF-convert / fine-tune can't race with an in-flight train.
        return (state["status"] in ("training", "paused", "stopping", "loading")
                or (train_thread[0] is not None and train_thread[0].is_alive()))

    def start_training():
        if is_busy():
            log_fn("already training")
            return
        state["error"] = None
        monitor.begin_reporting()

        def run():
            try:
                state["status"] = "training"
                trainer.train(cfg.training_file)
                state["status"] = "done"
            except Exception as e:
                state["error"] = str(e)
                state["status"] = "error"
        train_thread[0] = threading.Thread(target=run, daemon=True)
        train_thread[0].start()

    def stop_training():
        trainer.stop()          # also clears CUDA cache (see Trainer.stop)
        state["status"] = "stopping"
        # If the train thread has already exited, flip to idle quickly
        if train_thread[0] is None or not train_thread[0].is_alive():
            state["status"] = "idle"

    def pause_resume():
        if not is_busy():
            return
        if trainer._pause.is_set():
            trainer.resume(); state["status"] = "training"
        else:
            trainer.pause(); state["status"] = "paused"

    def start_finetune():
        if is_busy():
            log_fn("stop current run first")
            return
        monitor.begin_reporting()

        def run():
            try:
                state["status"] = "training"
                trainer.continue_training(cfg.continue_file, cfg.continue_epochs)
                state["status"] = "done"
            except Exception as e:
                state["error"] = str(e)
                state["status"] = "error"
        train_thread[0] = threading.Thread(target=run, daemon=True)
        train_thread[0].start()

    def load_ckpt():
        # Allowed at any point: if a train is running, request clean stop first,
        # wait briefly for the thread to exit, clear memory, then load.
        ck2 = find_latest_checkpoint(cfg.checkpoint_dir)
        if not ck2:
            log_fn("no checkpoint found")
            return

        def _do():
            if is_busy():
                log_fn("[load] stopping current run before load ...")
                trainer.stop()
                # wait up to ~4 s for the train thread to finish
                t0 = time.time()
                while train_thread[0] is not None and train_thread[0].is_alive() and time.time() - t0 < 4.0:
                    time.sleep(0.05)
                state["status"] = "idle"
            state["status"] = "loading"
            monitor.begin_reporting()
            try:
                trainer.load_checkpoint(ck2)
                state["loaded_ckpt_path"] = ck2
                # Push restored hyperparams into the live settings widgets so the
                # panel tells the truth about what is actually loaded.
                for k, w in settings_fields.items():
                    if not hasattr(cfg, k):
                        continue
                    v = getattr(cfg, k)
                    if isinstance(w, (Checkbox, Dropdown)):
                        w.value = v
                    elif isinstance(w, MultilineTextBox):
                        w.text = _sanitize(str(v))
                    else:
                        try:
                            w.value = str(v)
                        except Exception:
                            pass
                log_fn(f"loaded {ck2}  (n_heads={cfg.n_heads}, dtype={cfg.train_dtype}, "
                       f"d_model={cfg.d_model}, L={cfg.n_layers}, kernel={cfg.kernel_size})")
                state["status"] = "idle"
            except Exception as e:
                log_fn(f"load failed: {e}")
                state["status"] = "error"
                state["error"] = str(e)
        train_thread[0] = threading.Thread(target=_do, daemon=True)
        train_thread[0].start()

    def save_ckpt():
        trainer.save_checkpoint(trainer.epoch, trainer.loss_history[-1] if trainer.loss_history else float("nan"))

    def reset_baseline():
        monitor.capture_zero_state()
        monitor.begin_reporting()

    def toggle_convert():
        state["convert_open"] = not state["convert_open"]

    def do_convert():
        if is_busy():
            log_fn("busy — stop current run first")
            return
        gpath = conv_gguf_box.value.strip()
        opath = conv_out_box.value.strip() or "aura_from_gguf.pth"
        if not gpath or not os.path.exists(gpath):
            log_fn(f"GGUF file not found: {gpath}")
            return
        try:
            conv_cfg = Config(d_model=int(float(conv_dm_box.value)), n_layers=int(float(conv_nl_box.value)),
                               n_heads=int(float(conv_nh_box.value)), kernel_size=int(float(conv_ks_box.value)),
                               seq_len=cfg.seq_len, encoding=cfg.encoding, dropout=cfg.dropout)
            conv_cfg.validate()
        except Exception as e:
            log_fn(f"config error: {e}")
            return

        def run():
            state["status"] = "loading"
            try:
                convert_gguf_to_aura(gpath, opath, conv_cfg, log=log_fn)
                monitor.begin_reporting()
                trainer.load_checkpoint(opath)
                state["loaded_ckpt_path"] = opath
                # Sync the UI config with trainer's updated config (encoding, model_mode, etc.)
                for k, v in asdict(trainer.config).items():
                    if hasattr(cfg, k):
                        setattr(cfg, k, v)
                cfg.validate()
                mark_settings_dirty()
                log_fn("converted model loaded")
                state["status"] = "idle"
            except Exception as e:
                log_fn(f"GGUF ERROR: {e}")
                state["status"] = "error"
                state["error"] = str(e)
        train_thread[0] = threading.Thread(target=run, daemon=True)
        train_thread[0].start()
        state["convert_open"] = False

    def export_chat():
        default_name = f"aura_chat_{time.strftime('%Y%m%d_%H%M%S')}.json"
        chosen_path = native_save_file_dialog(default_name, os.path.abspath(cfg.checkpoint_dir))
        if chosen_path is None:
            os.makedirs(cfg.checkpoint_dir, exist_ok=True)
            chosen_path = os.path.join(cfg.checkpoint_dir, default_name)
            log_fn(f"[export] no native dialog available -> writing to {chosen_path}")
        try:
            data = export_chat_json(chat, trainer, cfg, state["loaded_ckpt_path"])
            with open(chosen_path, "w", encoding="utf-8") as f:
                json.dump(data, f, indent=2, ensure_ascii=False)
            log_fn(f"[export] chat exported -> {chosen_path}")
        except Exception as e:
            log_fn(f"[export] failed: {e}")

    def copy_chat():
        lines = []
        for t in chat.turns:
            ts = time.strftime("%H:%M:%S", time.localtime(t["ts"]))
            lines.append(f"[{ts}] {t['role']}: {t['text']}")
        copy_to_clipboard("\n".join(lines))
        log_fn("[copy] chat copied to clipboard")

    # ---- settings fields: every v10 field present, condensed labels, grouped ----
    settings_fields: Dict[str, object] = {}
    field_y = {}
    SETTINGS_X = 22
    FIELD_LABEL_HEIGHT = 18
    FIELD_SPACING = 14
    ITEM_H = 48
    y_cursor = 0
    for group_name, keys in FIELD_GROUPS:
        y_cursor += 28
        for k in keys:
            cur = getattr(cfg, k)
            field_y[k] = y_cursor
            if k == "model_mode":
                settings_fields[k] = Dropdown((SETTINGS_X, y_cursor + FIELD_LABEL_HEIGHT + 6, 120, 26), MODEL_MODE_OPTIONS, cur)
            elif k == "train_dtype":
                settings_fields[k] = Dropdown((SETTINGS_X, y_cursor + FIELD_LABEL_HEIGHT + 6, 130, 26), TRAIN_DTYPE_OPTIONS, cur)
            elif k == "encoding":
                settings_fields[k] = Dropdown((SETTINGS_X, y_cursor + FIELD_LABEL_HEIGHT + 6, 150, 26), ENCODING_OPTIONS, cur)
            elif k == "loss_fn":
                settings_fields[k] = Dropdown((SETTINGS_X, y_cursor + FIELD_LABEL_HEIGHT + 6, 190, 26), LOSS_FN_OPTIONS, cur)
            elif k == "meta_scratchpad_mode":
                settings_fields[k] = Dropdown((SETTINGS_X, y_cursor + FIELD_LABEL_HEIGHT + 6, 130, 26), SCRATCHPAD_OPTIONS, cur)
            elif k == "system_prompt":
                # item 7: wide, scrollable multiline system-prompt box
                sp_box = MultilineTextBox((SETTINGS_X, y_cursor + FIELD_LABEL_HEIGHT + 6, 400, 84), visible_lines=4)
                sp_box.text = _sanitize(str(cur))
                sp_box.placeholder = "System prompt (always prepended before the messages)"
                settings_fields[k] = sp_box
                y_cursor += FIELD_LABEL_HEIGHT + 84 + FIELD_SPACING
                continue
            elif isinstance(cur, bool):
                settings_fields[k] = Checkbox(SETTINGS_X, y_cursor + FIELD_LABEL_HEIGHT + 6, "", cur, 18)
            else:
                numeric = isinstance(cur, (int, float))
                width = 230 if isinstance(cur, str) and not numeric else 130
                settings_fields[k] = TextBox((SETTINGS_X, y_cursor + FIELD_LABEL_HEIGHT + 6, width, 28),
                                            value=str(cur), numeric=numeric)
            y_cursor += FIELD_LABEL_HEIGHT + 28 + FIELD_SPACING

    STRUCTURAL_KEYS = {"d_model", "n_layers", "n_heads", "kernel_size",
                       "use_transformer_attention", "train_dtype", "encoding",
                       "seq_len", "batch_size", "multi_gpu", "pos_encoding",
                       "model_mode"}

    SETTINGS_CONTENT_H = y_cursor + 10

    def apply_field_values():
        changed = False
        # Item 10: lr, system prompt, epochs, save_every, keep_checkpoints and
        # loss_fn apply LIVE mid-training; STRUCTURAL fields are locked while a
        # run is active (tensor shapes fixed at build) and widgets revert.
        training_now = state["status"] in ("training", "paused", "stopping")
        for k, widget in settings_fields.items():
            cur = getattr(cfg, k)
            if training_now and k in STRUCTURAL_KEYS:
                if isinstance(widget, (Checkbox, Dropdown)):
                    widget.value = cur
                elif isinstance(widget, TextBox) and not widget.active:
                    widget.value = str(cur)
                continue
            if isinstance(widget, TextBox) and widget.active:
                continue   # item 15: commit-on-blur -- never ingest half-typed values
            try:
                if isinstance(widget, MultilineTextBox):
                    if widget.text != cur:
                        changed = True
                    setattr(cfg, k, widget.text)
                elif isinstance(widget, Checkbox):
                    if widget.value != cur:
                        changed = True
                    setattr(cfg, k, widget.value)
                elif isinstance(widget, Dropdown):
                    if widget.value != cur:
                        changed = True
                    setattr(cfg, k, widget.value)
                elif isinstance(cur, bool):
                    pass
                elif isinstance(cur, int):
                    newv = int(float(widget.value or 0))
                    if newv != cur:
                        changed = True
                    setattr(cfg, k, newv)
                elif isinstance(cur, float):
                    newv = float(widget.value or 0.0)
                    if newv != cur:
                        changed = True
                    setattr(cfg, k, newv)
                else:
                    if widget.value != cur:
                        changed = True
                    setattr(cfg, k, widget.value)
            except Exception:
                pass
        cfg.validate()
        if changed:
            mark_settings_dirty()   # item 15: debounced write instead of instant I/O
        state["epochs"] = cfg.epochs
        if (cfg.encoding != trainer.codec.encoding_name
                and not str(cfg.encoding).startswith("gguf")):
            trainer.codec = TiktokenCodec(cfg.encoding)
        if cfg.meta_scratchpad_mode != trainer.scratchpad.mode:
            trainer.scratchpad.set_mode(cfg.meta_scratchpad_mode)
        target_bytes = int(cfg.astralis_max_kb * 1024)
        if target_bytes != trainer.astralis.max_bytes:
            trainer.astralis.max_bytes = target_bytes

    _ext_poll = {"t": 0.0}

    def sync_from_external_file():
        """Race-condition fix (see SettingsManager docstring): only re-ingests when
        content actually differs, not on every mtime touch, and never while a field
        is actively focused (so a second app instance can't yank a value out from
        under an in-progress edit). Item 15: disk is polled at most once/second
        instead of at 60 fps."""
        now = time.time()
        if now - _ext_poll["t"] < 1.0:
            return
        _ext_poll["t"] = now
        any_focused = any(isinstance(w, (TextBox, MultilineTextBox)) and w.active
                          for w in settings_fields.values())
        if any_focused:
            return
        if settings_mgr.check_for_external_update():
            data = settings_mgr.load()
            if not data:
                return
            for k, v in data.items():
                if not hasattr(cfg, k) or k == "device":
                    continue
                setattr(cfg, k, v)
                if k in settings_fields:
                    w = settings_fields[k]
                    if isinstance(w, (Checkbox, Dropdown)):
                        w.value = v
                    elif isinstance(w, MultilineTextBox):
                        w.text = _sanitize(str(v))
                    else:
                        w.value = str(v)
            # keep the top-bar generation controls in two-way sync (item 15)
            for key, box in (("gen_steps", gen_steps_box), ("temperature", gen_temp_box),
                             ("top_k", gen_topk_box)):
                if not box.active:
                    box.value = str(getattr(cfg, key))
            meta_gen_cb.value = cfg.meta_generate
            log_fn("[settings] external change detected and merged in")

    # ---- top button rows (fixed coordinates, planned to avoid overlap) ----
    top_row1 = [
        Button((22, 52, 106, 32), "Train", start_training, COLORS["good"]),
        Button((134, 52, 82, 32), "Stop", stop_training, COLORS["danger"]),
        Button((222, 52, 124, 32), "Pause/Resume", pause_resume, COLORS["warn"]),
        Button((352, 52, 124, 32), "Reset memory", reset_baseline, COLORS["muted"]),
    ]
    top_row2 = [
        Button((22, 90, 106, 32), "Load ckpt", load_ckpt, COLORS["accent"]),
        Button((134, 90, 106, 32), "Save ckpt", save_ckpt, COLORS["accent"]),
        Button((246, 90, 106, 32), "Sync now", lambda: save_config(settings_mgr, cfg), COLORS["cyan"]),
        Button((358, 90, 118, 32), "Clear chat", lambda: chat.clear(), COLORS["purple"]),
    ]

    PROG_Y, PROG_H = 132, 100
    CHARTS_H = 104
    SETTINGS_TOP = PROG_Y + PROG_H + CHARTS_H + 22
    FOOTER_H = 168                             # checkboxes + finetune btn + gguf btn, static
    SETTINGS_BOTTOM = H - FOOTER_H             # scroll viewport bottom
    SETTINGS_VIEWPORT_H = SETTINGS_BOTTOM - SETTINGS_TOP

    scroll_track_rect = pygame.Rect(LEFT_W - 25, SETTINGS_TOP, 16, SETTINGS_VIEWPORT_H)
    scroll_thumb = ScrollThumb(scroll_track_rect)

    # static footer widgets -- ANCHORED below the scroll viewport, never scroll
    FOOTER_TOP = SETTINGS_BOTTOM + 8
    recent_cb = Checkbox(SETTINGS_X, FOOTER_TOP, "recent msg only", cfg.send_only_recent)
    parse_md_cb = Checkbox(SETTINGS_X + 150, FOOTER_TOP, "parse markdown", cfg.parse_markdown)
    finish_sentence_cb = Checkbox(SETTINGS_X, FOOTER_TOP + 26, "finish sentence", cfg.finish_sentence)
    gpu_only_cb = Checkbox(SETTINGS_X + 150, FOOTER_TOP + 26, "GPU only", cfg.gpu_only_guard)
    finetune_btn = Button((SETTINGS_X, FOOTER_TOP + 58, LEFT_W - 32 - 4, 32),
                          "Start fine-tune (uses fields above)", start_finetune, COLORS["warn"])
    gguf_btn = Button((SETTINGS_X, FOOTER_TOP + 96, LEFT_W - 32 - 4, 32),
                      "GGUF -> Aura converter", toggle_convert, COLORS["purple"])

    conv_gguf_box = TextBox((0, 0, 520, 26), value="model.gguf", label="GGUF path")
    conv_out_box = TextBox((0, 0, 520, 26), value=os.path.join(cfg.checkpoint_dir, "model_final.pt"), label="Output .pt")
    conv_dm_box = TextBox((0, 0, 90, 26), value=str(cfg.d_model), numeric=True, label="d_model")
    conv_nl_box = TextBox((0, 0, 90, 26), value=str(cfg.n_layers), numeric=True, label="n_layers")
    conv_nh_box = TextBox((0, 0, 90, 26), value=str(cfg.n_heads), numeric=True, label="n_heads")
    conv_ks_box = TextBox((0, 0, 90, 26), value=str(cfg.kernel_size), numeric=True, label="kernel")
    conv_start_btn = Button((0, 0, 140, 32), "Convert", do_convert, COLORS["purple"])
    conv_close_btn = Button((0, 0, 120, 32), "Cancel", toggle_convert, COLORS["danger"])

    # ---- right side: generation controls + chat + prompt ----
    RIGHT_X = LEFT_W + 18
    RIGHT_W = W - RIGHT_X - 14
    GEN_ROW_Y = 66
    gen_steps_box = TextBox((RIGHT_X, GEN_ROW_Y, 80, 26), value=str(cfg.gen_steps), numeric=True, label="steps")
    gen_temp_box = TextBox((RIGHT_X + 92, GEN_ROW_Y, 80, 26), value=str(cfg.temperature), numeric=True, label="temp")
    gen_topk_box = TextBox((RIGHT_X + 184, GEN_ROW_Y, 80, 26), value=str(cfg.top_k), numeric=True, label="top_k")
    meta_gen_cb = Checkbox(RIGHT_X + 276, GEN_ROW_Y + 4, "meta_generate", cfg.meta_generate)

    def unload_model():
        """Item 14: unload the model from memory, freeing VRAM/RAM immediately."""
        if is_busy():
            log_fn("[unload] training in progress -- stop it first")
            return
        if trainer.model is None:
            log_fn("[unload] no model loaded")
            return
        trainer._free_model()
        state["loaded_ckpt_path"] = ""
        log_fn("[unload] model unloaded from memory; VRAM/RAM released")

    unload_btn = Button((RIGHT_X + 430, GEN_ROW_Y, 150, 28), "Unload model", unload_model, COLORS["danger"])

    def sync_gen_boxes_to_cfg():
        """Item 15: the top-bar generation controls are the single source of
        truth; they commit to cfg on blur and persist via the debounced writer."""
        for key, box, typ in (("gen_steps", gen_steps_box, int),
                              ("temperature", gen_temp_box, float),
                              ("top_k", gen_topk_box, int)):
            if box.active:
                continue
            try:
                v = typ(float(box.value))
            except Exception:
                box.value = str(getattr(cfg, key))
                continue
            if v != getattr(cfg, key):
                setattr(cfg, key, v)
                mark_settings_dirty()

    CHAT_TOP = GEN_ROW_Y + 48
    PROMPT_H = 82
    SEND_H = 42
    CONSOLE_H = 136
    CHAT_BOTTOM_MARGIN = PROMPT_H + SEND_H + CONSOLE_H + 30
    chat = ChatPanel((RIGHT_X, CHAT_TOP, RIGHT_W, H - CHAT_TOP - CHAT_BOTTOM_MARGIN - 6))

    prompt_box = MultilineTextBox((RIGHT_X, H - CONSOLE_H - PROMPT_H - SEND_H - 22, RIGHT_W - 94, PROMPT_H), visible_lines=3)
    play_btn = SmallIconButton((RIGHT_X + RIGHT_W - 82, H - CONSOLE_H - PROMPT_H - SEND_H - 22, 72, PROMPT_H), None, COLORS["accent"])
    send_btn = Button((RIGHT_X, H - CONSOLE_H - SEND_H - 16, RIGHT_W - 170, SEND_H), "SEND", None, COLORS["cyan"])
    export_btn = Button((RIGHT_X + RIGHT_W - 164, H - CONSOLE_H - SEND_H - 16, 78, SEND_H), "Export", export_chat, COLORS["accent"])
    copy_chat_btn = Button((RIGHT_X + RIGHT_W - 80, H - CONSOLE_H - SEND_H - 16, 80, SEND_H), "Copy", copy_chat, COLORS["muted"])
    console = ConsolePanel((RIGHT_X, H - CONSOLE_H - 8, RIGHT_W, CONSOLE_H))

    def build_context(prompt):
        """Item 7 (fix C7): system prompt always first, every turn prefixed with
        the configured names, and a trailing '<assistant>:' cue so the model
        knows it is Aura's turn to answer."""
        parts = []
        sys_p = (cfg.system_prompt or "").strip()
        if sys_p:
            parts.append(sys_p)
        if not recent_cb.value:
            for t in chat.turns:
                if t["role"] == "user":
                    parts.append(f"{cfg.user_name}: {t['text']}")
                elif t["role"] == "model":
                    parts.append(f"{cfg.assistant_name}: {t['text']}")
        parts.append(f"{cfg.user_name}: {prompt}")
        parts.append(f"{cfg.assistant_name}:")
        return "\n".join(parts)

    def _run_generation(full_prompt, is_continue=False):
        try:
            steps = max(1, int(float(gen_steps_box.value or 120)))
            temp = max(0.01, float(gen_temp_box.value or 0.8))
            top_k = int(float(gen_topk_box.value or 50)) or None
        except Exception:
            steps, temp, top_k = 120, 0.8, 50

        # Placeholder turn so the user sees something immediately; streaming
        # will overwrite its text live.
        chat.add("model", "…", "generating…")

        def on_token(partial: str):
            chat.update_last(partial or "…")

        def run():
            try:
                text, tps, el, was_cache_hit = trainer.generate(
                    full_prompt, steps=steps, temperature=temp, top_k=top_k,
                    token_callback=on_token)
                tag = " [astralis cache]" if was_cache_hit else ""
                meta = f"{len(trainer.codec.encode(text))} tok in {el:.2f}s — {tps:.1f} tok/s{tag}"
                chat.update_last(text or "(empty)", meta)
            except Exception as e:
                chat.update_last(f"(error: {e})", "error")
        threading.Thread(target=run, daemon=True).start()

    def do_send():
        prompt = prompt_box.text.strip()
        if not prompt:
            return
        if trainer.model is None:
            chat.add("warning", "No model loaded yet. Train or load a checkpoint first.")
            return
        full_prompt = build_context(prompt)
        chat.add("user", prompt)
        prompt_box.text = ""
        prompt_box.cursor = 0
        _run_generation(full_prompt)

    def do_continue_inference():
        """Continue button: resume generating from the assistant's LAST reply.
        Fix C7: previously the model's own words were re-wrapped as a USER
        message, corrupting the turn structure the model was being asked to
        continue."""
        if trainer.model is None:
            chat.add("warning", "No model loaded yet.")
            return
        sys_p = (cfg.system_prompt or "").strip()
        parts = [sys_p] if sys_p else []
        for t in chat.turns:
            if t["role"] == "user":
                parts.append(f"{cfg.user_name}: {t['text']}")
            elif t["role"] == "model":
                parts.append(f"{cfg.assistant_name}: {t['text']}")
        seed = "\n".join(parts) if parts else f"{cfg.assistant_name}:"
        _run_generation(seed, is_continue=True)

    send_btn.action = do_send
    play_btn.action = do_continue_inference

    running = True
    frame_i = [0]
    while running:
        mouse_pos = pygame.mouse.get_pos()
        sync_from_external_file()

        settings_content_rect = pygame.Rect(8, SETTINGS_TOP, LEFT_W - 16, SETTINGS_VIEWPORT_H)

        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False
            elif chrome.handle_event(event, (W, H)):
                continue
            elif event.type == pygame.VIDEORESIZE:
                W, H = max(1200, event.w), max(800, event.h)
                screen = pygame.display.set_mode((W, H), DISPLAY_FLAGS)
                chrome.refresh_handle()
                # Recreate scaled fonts to avoid UI text overlap (scale relative to 1680px baseline)
                try:
                    scale = max(0.6, min(1.6, float(W) / 1680.0))
                    fonts = create_fonts(scale=scale)
                    font = fonts['font']
                    font_big = fonts['font_big']
                    font_small = fonts['font_small']
                    font_label = fonts['font_label']
                    font_bold = fonts['font_bold']
                    font_italic = fonts['font_italic']
                    font_code = fonts['font_code']
                    font_yellow_hparam = fonts['font_yellow_hparam']
                    font_console = fonts['font_console']
                    font_emoji = fonts['font_emoji']
                except Exception:
                    pass
                if hasattr(gui_main, "_panel_bg_key"):
                    gui_main._panel_bg_key = None  # invalidate panel cache
                # Recompute right-panel geometry
                RIGHT_X = LEFT_W + 18
                RIGHT_W = W - RIGHT_X - 14
                CHAT_TOP = GEN_ROW_Y + 48
                CHAT_BOTTOM_MARGIN = PROMPT_H + SEND_H + CONSOLE_H + 30
                chat.set_rect((RIGHT_X, CHAT_TOP, RIGHT_W, H - CHAT_TOP - CHAT_BOTTOM_MARGIN - 6))
                # Reposition prompt / send row / console (item 18)
                prompt_box.rect = pygame.Rect(RIGHT_X, H - CONSOLE_H - PROMPT_H - SEND_H - 22, RIGHT_W - 94, PROMPT_H)
                play_btn.rect = pygame.Rect(RIGHT_X + RIGHT_W - 82, H - CONSOLE_H - PROMPT_H - SEND_H - 22, 72, PROMPT_H)
                send_btn.rect = pygame.Rect(RIGHT_X, H - CONSOLE_H - SEND_H - 16, RIGHT_W - 170, SEND_H)
                export_btn.rect = pygame.Rect(RIGHT_X + RIGHT_W - 164, H - CONSOLE_H - SEND_H - 16, 78, SEND_H)
                copy_chat_btn.rect = pygame.Rect(RIGHT_X + RIGHT_W - 80, H - CONSOLE_H - SEND_H - 16, 80, SEND_H)
                console.set_rect((RIGHT_X, H - CONSOLE_H - 8, RIGHT_W, CONSOLE_H))
                # Settings viewport + footer
                SETTINGS_BOTTOM = H - FOOTER_H
                SETTINGS_VIEWPORT_H = SETTINGS_BOTTOM - SETTINGS_TOP
                scroll_track_rect = pygame.Rect(LEFT_W - 25, SETTINGS_TOP, 16, SETTINGS_VIEWPORT_H)
                scroll_thumb.track = scroll_track_rect
                FOOTER_TOP = SETTINGS_BOTTOM + 8
                recent_cb.rect.y = FOOTER_TOP
                parse_md_cb.rect.y = FOOTER_TOP
                finish_sentence_cb.rect.y = FOOTER_TOP + 26
                gpu_only_cb.rect.y = FOOTER_TOP + 26
                finetune_btn.rect.y = FOOTER_TOP + 58
                gguf_btn.rect.y = FOOTER_TOP + 96
                # Gen boxes stay at fixed top offsets; only x may need update
                gen_steps_box.rect.x = RIGHT_X
                gen_temp_box.rect.x = RIGHT_X + 92
                gen_topk_box.rect.x = RIGHT_X + 184
                meta_gen_cb.rect.x = RIGHT_X + 276
                unload_btn.rect.x = RIGHT_X + 430
            elif event.type == pygame.MOUSEWHEEL:
                if not state["convert_open"]:
                    if not console.handle_scroll(mouse_pos, event.y):
                        chat.handle_scroll(mouse_pos, event.y)
                    prompt_box.handle_event(event, True, do_send, font=font)
                    sp_w = settings_fields.get("system_prompt")
                    if isinstance(sp_w, MultilineTextBox):
                        sp_w.handle_event(event, False, lambda: None, font=font_small)
                    if settings_content_rect.collidepoint(mouse_pos):
                        state["settings_scroll_px"] = max(0, min(
                            state["settings_scroll_px"] - event.y * 24,
                            max(0, SETTINGS_CONTENT_H - SETTINGS_VIEWPORT_H)))
                        scroll_thumb.set_from_scroll(state["settings_scroll_px"], SETTINGS_CONTENT_H, SETTINGS_VIEWPORT_H)
            elif event.type == pygame.MOUSEBUTTONDOWN:
                if state["convert_open"]:
                    for w in (conv_gguf_box, conv_out_box, conv_dm_box, conv_nl_box, conv_nh_box, conv_ks_box):
                        w.handle_event(event, font=font_small)
                    if conv_start_btn.clicked(event.pos):
                        conv_start_btn.action()
                    if conv_close_btn.clicked(event.pos):
                        conv_close_btn.action()
                else:
                    # Chat scrollbar first (consumes the event if hit)
                    if chat.handle_scrollbar_event(event):
                        pass  # consumed
                    new_scroll = scroll_thumb.handle_event(event, SETTINGS_CONTENT_H, SETTINGS_VIEWPORT_H)
                    if new_scroll is not None:
                        state["settings_scroll_px"] = new_scroll
                    if settings_content_rect.collidepoint(mouse_pos) or scroll_track_rect.collidepoint(mouse_pos):
                        for k, w in settings_fields.items():
                            if isinstance(w, Dropdown):
                                if w.handle_event(event):
                                    apply_field_values()
                            elif isinstance(w, Checkbox):
                                if w.handle_event(event):
                                    apply_field_values()
                            elif isinstance(w, MultilineTextBox):
                                w.handle_event(event, False, lambda: None, font=font_small)
                            else:
                                w.handle_event(event, font=font_small)
                    for b in top_row1 + top_row2 + [finetune_btn, gguf_btn, export_btn, copy_chat_btn, unload_btn]:
                        if b.clicked(event.pos):
                            b.action()
                    if play_btn.clicked(event.pos):
                        play_btn.action()
                    prompt_box.handle_event(event, True, do_send, font=font)
                    for box in (gen_steps_box, gen_temp_box, gen_topk_box):
                        box.handle_event(event, font=font_label)
                    if recent_cb.handle_event(event):
                        cfg.send_only_recent = recent_cb.value; mark_settings_dirty()
                    if parse_md_cb.handle_event(event):
                        cfg.parse_markdown = parse_md_cb.value; mark_settings_dirty()
                    if finish_sentence_cb.handle_event(event):
                        cfg.finish_sentence = finish_sentence_cb.value; mark_settings_dirty()
                    if gpu_only_cb.handle_event(event):
                        cfg.gpu_only_guard = gpu_only_cb.value; mark_settings_dirty()
                    if meta_gen_cb.handle_event(event):
                        cfg.meta_generate = meta_gen_cb.value; mark_settings_dirty()
                    if send_btn.clicked(event.pos):
                        send_btn.action()
            elif event.type == pygame.MOUSEBUTTONUP:
                for w in list(settings_fields.values()) + [conv_gguf_box, conv_out_box, conv_dm_box,
                                                              conv_nl_box, conv_nh_box, conv_ks_box,
                                                              gen_steps_box, gen_temp_box, gen_topk_box]:
                    if isinstance(w, TextBox):
                        w.handle_event(event, font=font_small)
                prompt_box.handle_event(event, True, do_send, font=font)
                chat.handle_scrollbar_event(event)
                nc = scroll_thumb.handle_event(event, SETTINGS_CONTENT_H, SETTINGS_VIEWPORT_H)
                if nc is not None:
                    state["settings_scroll_px"] = nc
            elif event.type == pygame.MOUSEMOTION:
                # PERF: only forward to TextBox widgets that are dragging (active + mouse down)
                for w in settings_fields.values():
                    if isinstance(w, TextBox) and (w.active or getattr(w, '_dragging', False)):
                        w.handle_event(event, font=font_small)
                prompt_box.handle_event(event, True, do_send, font=font)
                chat.handle_scrollbar_event(event)
                nc = scroll_thumb.handle_event(event, SETTINGS_CONTENT_H, SETTINGS_VIEWPORT_H)
                if nc is not None:
                    state["settings_scroll_px"] = nc
            elif event.type == pygame.KEYDOWN:
                if state["convert_open"]:
                    for w in (conv_gguf_box, conv_out_box, conv_dm_box, conv_nl_box, conv_nh_box, conv_ks_box):
                        w.handle_event(event, font=font_small)
                else:
                    for w in settings_fields.values():
                        if isinstance(w, TextBox) and w.active:
                            w.handle_event(event, font=font_small)
                            apply_field_values()
                        elif isinstance(w, MultilineTextBox) and w.active:
                            w.handle_event(event, False, lambda: None, font=font_small)
                            apply_field_values()
                    prompt_box.handle_event(event, True, do_send, font=font)
                    for box in (gen_steps_box, gen_temp_box, gen_topk_box):
                        box.handle_event(event, font=font_label)

        frame_i[0] += 1
        if frame_i[0] % 6 == 0:       # PERF: widget sweep at 10 Hz is plenty;
            apply_field_values()      # event handlers still apply instantly.
            sync_gen_boxes_to_cfg()
        # item 15: debounced settings persistence -- write only after edits settle
        if settings_dirty["at"] is not None and time.time() - settings_dirty["at"] > 0.75:
            save_config(settings_mgr, cfg)
            settings_dirty["at"] = None
        if frame_i[0] % 30 == 0:
            api_server.apply_settings()   # item 16: reconcile API server with settings
        top_row1[2].enabled = is_busy()   # Pause/Resume only meaningful while busy

        # ---- PERF: cache static background + panel overlays; only re-render on resize ----
        panel_key = (W, H, LEFT_W, RIGHT_X, RIGHT_W)
        if getattr(gui_main, "_panel_bg_key", None) != panel_key:
            gui_main._panel_bg_key = panel_key
            # static background (gradient, no moving balls)
            bg_static = pygame.Surface((W, H), pygame.SRCALPHA)
            try:
                orb_field._draw_background(bg_static, W, H)
            except Exception:
                draw_vertical_gradient(bg_static, (0, 0, W, H), (5, 7, 29), (24, 9, 42))
            # overlay panels (glass) drawn separately so moving balls animate behind them
            overlay = pygame.Surface((W, H), pygame.SRCALPHA)
            draw_glass_panel(overlay, pygame.Rect(8, 46, LEFT_W - 10, H - 54), 20)
            draw_glass_panel(overlay, pygame.Rect(RIGHT_X - 8, 48, RIGHT_W + 8, H - 56), 20)
            gui_main._background = bg_static
            gui_main._panel_bg = overlay
        # draw background, then moving balls, then panel overlays
        screen.blit(gui_main._background, (0, 0))
        # compute frame dt in seconds for smooth physics
        dt = max(1/120.0, clock.get_time() / 1000.0)
        orb_field.draw(screen, (W, H), time.time(), dt=dt)
        screen.blit(gui_main._panel_bg, (0, 0))
        # Smooth outer border around whole UI
        try:
            draw_round_rect(screen, COLORS.get("border_hi", (226, 230, 255, 180)),
                            pygame.Rect(4, 4, W - 8, H - 8), radius=14, width=2)
        except Exception:
            pass

        for b in top_row1 + top_row2:
            b.draw(screen, font_small, b.rect.collidepoint(mouse_pos), COLORS)

        # ---- progress panel: hyperparams in yellow, EWC line during fine-tune,
        # human-readable per-batch ETA ----
        prog_rect = pygame.Rect(22, PROG_Y, LEFT_W - 46, PROG_H)
        draw_glass_panel(screen, prog_rect, 13)
        sc = {"idle": COLORS["muted"], "training": COLORS["good"], "paused": COLORS["warn"],
              "stopping": COLORS["warn"], "done": COLORS["good"], "error": COLORS["danger"]}.get(state["status"], COLORS["muted"])
        ls = f"{state['loss']:.4f}" if state["loss"] is not None else "--"
        eta_str = format_eta_human(state["eta_sec"]) if state["status"] in ("training", "paused") else "--"
        spb_str = f"{state['sec_per_batch']:.2f}s/batch" if state.get("sec_per_batch") else ""
        line1 = font_small.render(f"status: {state['status']}   dtype:{cfg.train_dtype}   loss_fn:{cfg.loss_fn}", True, sc)
        line2 = font_small.render(
            f"epoch {state['epoch']}/{state['epochs']}  batch {state['batch']}/{state['n_batches']}  "
            f"loss {ls}  ETA {eta_str}  {spb_str}", True, COLORS["text"])
        hp = state.get("hparams") or {}
        if hp:
            hp_bits = [f"mode={hp.get('model_mode','?')}", f"d={hp.get('d_model','?')}", f"L={hp.get('n_layers','?')}",
                      f"H={hp.get('n_heads','?')}", f"bs={hp.get('batch_size','?')}", f"lr={hp.get('learning_rate','?')}",
                      f"seq={hp.get('seq_len','?')}"]
            if hp.get("ewc_lambda", 0) and hp.get("ewc_lambda", 0) > 0:
                hp_bits.append(f"EWC λ={hp.get('ewc_lambda')} n={hp.get('ewc_samples','?')}")
            line3 = font_yellow_hparam.render("  ".join(hp_bits), True, COLORS["yellow"])
        else:
            line3 = font_yellow_hparam.render("(hyperparams appear once training starts)", True, COLORS["muted"])
        old_clip = screen.get_clip()
        screen.set_clip(prog_rect.inflate(-12, -8))
        screen.blit(line1, (prog_rect.x + 12, prog_rect.y + 8))
        screen.blit(line2, (prog_rect.x + 12, prog_rect.y + 27))
        screen.blit(line3, (prog_rect.x + 12, prog_rect.y + 47))
        line4 = font_yellow_hparam.render(predicted_vram_text(), True, COLORS["cyan"])
        screen.blit(line4, (prog_rect.x + 12, prog_rect.y + 65))
        line5 = font_yellow_hparam.render(vram_pred_cache["infer_text"], True, COLORS["purple"])
        screen.blit(line5, (prog_rect.x + 12, prog_rect.y + 83))
        screen.set_clip(old_clip)
        bar_rect = pygame.Rect(prog_rect.x + 10, prog_rect.bottom - 14, prog_rect.width - 20, 8)
        draw_round_rect(screen, COLORS["scroll_track"], bar_rect, 4)
        frac = 0.0
        if state["n_batches"]:
            frac = max(0.0, min(1.0, state["batch"] / max(1, state["n_batches"])))
        if frac > 0:
            fill_rect = pygame.Rect(bar_rect.x, bar_rect.y, max(6, int(bar_rect.width * frac)), bar_rect.height)
            draw_round_rect(screen, COLORS["cyan"], fill_rect, 4)

        # ---- item 20: smoothed training-loss chart with dotted projected-future
        # loss, plus a dedicated green VRAM chart with RAM overlay ----
        charts_rect = pygame.Rect(22, PROG_Y + PROG_H + 10, LEFT_W - 46, CHARTS_H)
        draw_glass_panel(screen, charts_rect, 13)
        half_w = (charts_rect.width - 30) // 2
        loss_rect = pygame.Rect(charts_rect.x + 10, charts_rect.y + 24, half_w, charts_rect.height - 34)
        vram_rect = pygame.Rect(charts_rect.x + 20 + half_w, charts_rect.y + 24, half_w, charts_rect.height - 34)
        screen.blit(font_label.render("LOSS  •  projected", True, COLORS["cyan"]),
                    (loss_rect.x, charts_rect.y + 4))
        screen.blit(font_label.render("VRAM  •  RAM", True, COLORS["good"]),
                    (vram_rect.x, charts_rect.y + 4))
        if len(loss_hist) >= 2:
            sm = _smooth_series(loss_hist[-240:])
            proj = project_series(sm, n_future=max(8, len(sm) // 4))
            lo_v = min(min(sm), min(proj) if proj else min(sm))
            hi_v = max(max(sm), max(proj) if proj else max(sm))
            past_w = int(loss_rect.width * 0.75)
            draw_line_chart(screen, pygame.Rect(loss_rect.x, loss_rect.y, past_w, loss_rect.height),
                            sm, COLORS["cyan"], min_v=lo_v, max_v=hi_v, width=2)
            if proj:
                draw_line_chart(screen, pygame.Rect(loss_rect.x + past_w, loss_rect.y,
                                                    loss_rect.width - past_w, loss_rect.height),
                                [sm[-1]] + proj, COLORS["cyan"], min_v=lo_v, max_v=hi_v,
                                dotted=True, width=1)
        else:
            screen.blit(font_label.render("Awaiting telemetry", True, COLORS["muted"]),
                        (loss_rect.x, loss_rect.y + 8))
        vh_c, rh_c = monitor.history_snapshot()
        if len(vh_c) >= 2:
            draw_line_chart(screen, vram_rect, vh_c[-240:], COLORS["good"], width=2)
        if len(rh_c) >= 2:
            draw_line_chart(screen, vram_rect, rh_c[-240:], COLORS["muted"], width=1)

        # ---- fields hidden in GPT mode (hyena-specific) ----
        _GPT_HIDDEN = {"kernel_size", "use_transformer_attention", "gated_mlp",
                       "attn_head_dim", "n_kv_heads", "qk_norm", "pos_encoding",
                       "rope_base", "rope_global_every", "rope_global_base",
                       "ff_dim", "untie_head"}
        # ---- scrollable settings viewport ----
        prev_clip = screen.get_clip()
        screen.set_clip(settings_content_rect)
        y_off = SETTINGS_TOP - state["settings_scroll_px"]
        is_gpt_mode = cfg.model_mode == "gpt"
        for group_name, keys in FIELD_GROUPS:
            visible = [k for k in keys if not (is_gpt_mode and k in _GPT_HIDDEN)]
            if not visible:
                continue
            gy = field_y[visible[0]] - 22 + y_off
            heading = font_small.render(str(group_name).upper(), True, COLORS["pink"])
            screen.blit(heading, (SETTINGS_X, gy + 16))
            pygame.draw.aaline(screen, (190, 105, 255, 95),
                               (SETTINGS_X + heading.get_width() + 10, gy + 24),
                               (LEFT_W - 42, gy + 24))
            for k in visible:
                w = settings_fields[k]
                base_y = field_y[k] + y_off
                label = FIELD_LABELS.get(k, k)
                screen.blit(font_small.render(label, True, COLORS["muted"]), (SETTINGS_X, base_y))
                if isinstance(w, Checkbox):
                    w.rect.y = base_y + FIELD_LABEL_HEIGHT + 6
                    w.rect.x = SETTINGS_X
                    w.draw(screen, font_small, COLORS)
                elif isinstance(w, Dropdown):
                    w.rect.y = base_y + FIELD_LABEL_HEIGHT + 6
                    w.rect.x = SETTINGS_X
                    w.draw_closed(screen, font_small, COLORS)
                elif isinstance(w, MultilineTextBox):
                    w.rect.x = SETTINGS_X
                    w.rect.y = base_y + FIELD_LABEL_HEIGHT + 6
                    w.rect.width = 400
                    w.draw(screen, font_small, COLORS, emoji_font=font_emoji)
                else:
                    w.rect.y = base_y + FIELD_LABEL_HEIGHT + 6
                    w.rect.x = SETTINGS_X
                    w.draw(screen, font_small, COLORS, emoji_font=font_emoji)
        screen.set_clip(prev_clip)
        # dropdown popups drawn after clip is lifted so they aren't cut off mid-list
        for w in settings_fields.values():
            if isinstance(w, Dropdown) and w.open:
                if settings_content_rect.collidepoint(w.rect.topleft):
                    w.draw_open_overlay(screen, font_small, COLORS)

        scroll_thumb.track = scroll_track_rect
        scroll_thumb.draw(screen, COLORS)

        # ---- static footer (never scrolls) ----
        recent_cb.draw(screen, font_small, COLORS)
        parse_md_cb.draw(screen, font_small, COLORS)
        finish_sentence_cb.draw(screen, font_small, COLORS)
        gpu_only_cb.draw(screen, font_small, COLORS)
        finetune_btn.draw(screen, font_small, finetune_btn.rect.collidepoint(mouse_pos), COLORS)
        gguf_btn.draw(screen, font_small, gguf_btn.rect.collidepoint(mouse_pos), COLORS)

        # ---- right side: generation + chat ----
        screen.blit(font_bold.render("GENERATION", True, COLORS["pink"]), (RIGHT_X, GEN_ROW_Y - 20))
        for box in (gen_steps_box, gen_temp_box, gen_topk_box):
            box.draw(screen, font_label, COLORS)
        meta_gen_cb.draw(screen, font_small, COLORS)
        chat.draw(screen, font, font_small, font_bold, font_italic, font_code, COLORS, parse_md=cfg.parse_markdown, emoji_font=font_emoji)
        prompt_box.draw(screen, font, COLORS, emoji_font=font_emoji)
        play_btn.draw(screen, play_btn.rect.collidepoint(mouse_pos), COLORS)
        send_btn.draw(screen, font, send_btn.rect.collidepoint(mouse_pos), COLORS)
        export_btn.draw(screen, font_small, export_btn.rect.collidepoint(mouse_pos), COLORS)
        copy_chat_btn.draw(screen, font_small, copy_chat_btn.rect.collidepoint(mouse_pos), COLORS)
        unload_btn.draw(screen, font_small, unload_btn.rect.collidepoint(mouse_pos), COLORS)
        console.draw(screen, font_console, COLORS)   # item 18

        if state["error"]:
            err_surf = font_small.render(f"ERROR: {state['error']}", True, COLORS["danger"])
            screen.blit(err_surf, (16, H - 18))

        if state["convert_open"]:
            ov = pygame.Rect(W // 2 - 380, 140, 760, 320)
            veil = pygame.Surface((W, H), pygame.SRCALPHA)
            veil.fill((3, 4, 18, 142))
            screen.blit(veil, (0, 0))
            draw_glass_panel(screen, ov, 20, COLORS["purple"])
            screen.blit(font_big.render("GGUF -> Aura Conversion", True, COLORS["text"]), (ov.x + 20, ov.y + 14))
            screen.blit(font_small.render(
                "Q/K/V -> SVD -> conv kernel | Wo -> gate+attn.c_proj | MLP -> ffn | LN copied",
                True, COLORS["muted"]), (ov.x + 20, ov.y + 44))
            conv_gguf_box.rect.topleft = (ov.x + 20, ov.y + 90)
            conv_out_box.rect.topleft = (ov.x + 20, ov.y + 150)
            conv_dm_box.rect.topleft = (ov.x + 20, ov.y + 210)
            conv_nl_box.rect.topleft = (ov.x + 130, ov.y + 210)
            conv_nh_box.rect.topleft = (ov.x + 240, ov.y + 210)
            conv_ks_box.rect.topleft = (ov.x + 350, ov.y + 210)
            conv_start_btn.rect.topleft = (ov.x + 20, ov.y + 260)
            conv_close_btn.rect.topleft = (ov.x + 180, ov.y + 260)
            for w in (conv_gguf_box, conv_out_box, conv_dm_box, conv_nl_box, conv_nh_box, conv_ks_box):
                w.draw(screen, font_small, COLORS)
            conv_start_btn.draw(screen, font, conv_start_btn.rect.collidepoint(mouse_pos), COLORS)
            conv_close_btn.draw(screen, font, conv_close_btn.rect.collidepoint(mouse_pos), COLORS)

        # Render last: content can never cover window controls or the drag affordance.
        # Pass monitor stats and predicted VRAM as a multiline stats block
        chrome.draw(screen, font_big, font_small,
                monitor.stats_string() + "\n" + predicted_vram_text()
                + "\n" + vram_pred_cache["infer_text"])

        pygame.display.flip()
        # PERF: maintain a minimum 60 FPS UI refresh rate as requested.
        clock.tick(60)

    api_server.stop()
    monitor._stop = True
    pygame.quit()


# =====================================================================
# CONSOLE GUI + HEADLESS CLI (v12.1)
# Default launch (no options) still opens the pygame GUI. `--console` opens an
# interactive menu-driven console covering every application feature; action
# flags (--train / --generate / ...) run headless; --help lists everything with
# examples whose defaults are read live from settings.json.
# =====================================================================
def _make_stream_printer():
    """token_callback adapter: the engine passes the CUMULATIVE partial text on
    every token; print only the new delta so generation streams live to stdout."""
    st = {"n": 0}

    def cb(partial):
        if not partial:
            return
        if len(partial) < st["n"]:      # defensive: stream restarted
            st["n"] = 0
        delta = partial[st["n"]:]
        if delta:
            sys.stdout.write(delta)
            sys.stdout.flush()
            st["n"] = len(partial)
    return cb


def _build_chat_context(cfg: Config, history: List[dict], prompt: str) -> str:
    """Same turn structure as the GUI's build_context(): system prompt first,
    name-prefixed history (unless send_only_recent), then '<user>: msg' plus the
    '<assistant>:' cue."""
    parts = []
    sys_p = (cfg.system_prompt or "").strip()
    if sys_p:
        parts.append(sys_p)
    if not cfg.send_only_recent:
        for t in history:
            if t["role"] == "user":
                parts.append(f"{cfg.user_name}: {t['text']}")
            elif t["role"] == "model":
                parts.append(f"{cfg.assistant_name}: {t['text']}")
    parts.append(f"{cfg.user_name}: {prompt}")
    parts.append(f"{cfg.assistant_name}:")
    return "\n".join(parts)


def _continue_seed(cfg: Config, history: List[dict]) -> str:
    """Seed for 'continue reply' (mirrors the GUI play button): replay history
    verbatim WITHOUT re-wrapping the model's own words as a user turn."""
    sys_p = (cfg.system_prompt or "").strip()
    parts = [sys_p] if sys_p else []
    for t in history:
        if t["role"] == "user":
            parts.append(f"{cfg.user_name}: {t['text']}")
        elif t["role"] == "model":
            parts.append(f"{cfg.assistant_name}: {t['text']}")
    return "\n".join(parts) if parts else f"{cfg.assistant_name}:"


def _run_generation_console(trainer: Trainer, cfg: Config, full_prompt: str) -> Optional[str]:
    """Blocking generation with live streaming + a stats footer. Returns the
    final text (None on error/interrupt)."""
    try:
        text, tps, el, hit = trainer.generate(
            full_prompt, steps=max(1, int(cfg.gen_steps)),
            temperature=max(0.01, float(cfg.temperature)),
            top_k=int(cfg.top_k) or None,
            token_callback=_make_stream_printer())
    except KeyboardInterrupt:
        print("\n[gen] interrupted")
        return None
    except Exception as e:
        print(f"\n[gen] error: {e}")
        return None
    tag = " [astralis cache]" if hit else ""
    print(f"\n({len(trainer.codec.encode(text))} tok, {el:.2f}s, {tps:.1f} tok/s{tag})")
    return text


def console_chat_loop(trainer: Trainer, cfg: Config, history: List[dict]):
    """Interactive terminal chat -- shared by --chat and the console GUI."""
    if trainer.model is None:
        print("[chat] no model loaded -- train or load a checkpoint first.")
        return
    print(f"--- chat with {cfg.assistant_name} "
          f"(type /exit to leave, /clear to reset history) ---")
    while True:
        try:
            prompt = input(f"{cfg.user_name}> ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            break
        if not prompt:
            continue
        if prompt in ("/exit", "/quit"):
            break
        if prompt == "/clear":
            history.clear()
            print("[chat] history cleared")
            continue
        full = _build_chat_context(cfg, history, prompt)
        history.append({"role": "user", "text": prompt, "ts": time.time()})
        print(f"{cfg.assistant_name}> ", end="", flush=True)
        text = _run_generation_console(trainer, cfg, full)
        if text is not None:
            history.append({"role": "model", "text": text, "ts": time.time()})


CONSOLE_MENU = """
+====================================================================+
|                 AURA :: ASTRALIS  CONSOLE GUI                      |
+====================================================================+
  TRAINING                      MODEL                      CHAT
   1 train (from scratch)        6 load checkpoint          11 chat
   2 fine-tune / continue        7 save checkpoint          12 generate once
   3 pause / resume              8 unload model             13 continue reply
   4 stop training               9 reset memory baseline    14 clear chat
   5 status                     10 memory / VRAM stats      15 export chat (.json)
  SYSTEM
   16 settings (view/edit/save)   17 API server on/off      18 GGUF -> Aura convert
   19 help                        0 quit
  Type a number or a command name (train, stop, chat, settings, ...).
"""


class ConsoleApp:
    """Interactive console GUI: every feature of the pygame application,
    menu-driven, no display required."""

    def __init__(self, cfg: Config, mgr: SettingsManager):
        self.cfg = cfg
        self.mgr = mgr
        self.monitor = ResourceMonitor()
        self.monitor.start()
        self.monitor.capture_zero_state()
        self.state = {"status": "idle", "loaded_ckpt_path": ""}
        self._prog = {"t": 0.0}
        self.trainer = Trainer(cfg, log_fn=self._log, progress_fn=self._progress)
        self.api_server = OpenAIAPIServer(self.trainer, cfg)
        self.train_thread: Optional[threading.Thread] = None
        self.history: List[dict] = []
        self.running = True

    # ---- plumbing ----
    def _log(self, msg):
        GLOBAL_LOGGER.log(msg)

    def _progress(self, epoch, epochs, batch, n_batches, loss,
                  eta_sec=None, sec_per_batch=None, hparams=None):
        now = time.time()
        if batch >= n_batches or now - self._prog["t"] >= 1.5:
            self._prog["t"] = now
            nl = "\n" if batch >= n_batches else ""
            print(f"\r[train] epoch {epoch}/{epochs} batch {batch}/{n_batches} "
                  f"loss {loss:.4f} ETA {format_eta_human(eta_sec)}     {nl}",
                  end="", flush=True)

    def is_busy(self) -> bool:
        return (self.state["status"] in ("training", "paused", "stopping", "loading")
                or (self.train_thread is not None and self.train_thread.is_alive()))

    def _run_bg(self, work, busy_status="training") -> bool:
        if self.is_busy():
            self._log("busy -- stop the current run first")
            return False
        self.monitor.begin_reporting()

        def run():
            try:
                self.state["status"] = busy_status
                work()
                if self.state["status"] == busy_status:
                    self.state["status"] = "done" if busy_status == "training" else "idle"
            except Exception as e:
                self.state["status"] = "error"
                self._log(f"error: {e}")
        self.train_thread = threading.Thread(target=run, daemon=True)
        self.train_thread.start()
        return True

    # ---- commands ----
    def cmd_quit(self):
        self.running = False

    def cmd_help(self):
        print(CONSOLE_MENU)
        print("headless use: python zera.astralis --help lists every CLI flag "
              "with examples (defaults from settings.json).")

    def cmd_train(self):
        self._run_bg(lambda: self.trainer.train(self.cfg.training_file))

    def cmd_finetune(self):
        self._run_bg(lambda: self.trainer.continue_training(
            self.cfg.continue_file, self.cfg.continue_epochs))

    def cmd_pause(self):
        if not self.is_busy():
            print("[pause] nothing is running")
            return
        if self.trainer._pause.is_set():
            self.trainer.resume()
            self.state["status"] = "training"
            print("[pause] resumed")
        else:
            self.trainer.pause()
            self.state["status"] = "paused"
            print("[pause] pausing (state will be saved, VRAM released)")

    def cmd_stop(self):
        self.trainer.stop()
        self.state["status"] = "stopping"
        if self.train_thread is None or not self.train_thread.is_alive():
            self.state["status"] = "idle"
        print("[stop] stop requested")

    def cmd_status(self):
        t = self.trainer
        print("-" * 62)
        print(f"  status        : {self.state['status']} (engine stage: {t.stage})")
        if t.model is not None:
            print(f"  model         : loaded ({t.model.count_parameters():,} params)")
        else:
            print("  model         : not loaded")
        print(f"  checkpoint    : {self.state['loaded_ckpt_path'] or '(none this session)'}")
        hist = f"  epoch         : {t.epoch}"
        if t.loss_history:
            hist += f"   last loss {t.loss_history[-1]:.4f} ({len(t.loss_history)} epochs logged)"
        print(hist)
        print(f"  astralis cache: {len(t.astralis.records)} records "
              f"(~{t.astralis.estimate_bytes()/1024:.1f}KB / {t.astralis.max_bytes/1024:.0f}KB cap)")
        print(f"  chat turns    : {len(self.history)}")
        api = (f"ON http://{self.cfg.api_host}:{self.cfg.api_port}/v1"
               if self.api_server.running else "off")
        print(f"  api server    : {api}")
        print(f"  device/dtype  : {self.cfg.device} / {self.cfg.train_dtype} / {self.cfg.encoding}")
        print("-" * 62)

    def cmd_load(self):
        try:
            path = input(f"checkpoint path [newest in '{self.cfg.checkpoint_dir}']> ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return
        ck = path or find_latest_checkpoint(self.cfg.checkpoint_dir)
        if not ck:
            print("[load] no checkpoint found")
            return
        if self.is_busy():
            print("[load] stopping current run first ...")
            self.trainer.stop()
            if self.train_thread is not None:
                self.train_thread.join(timeout=4.0)
            self.state["status"] = "idle"

        def work():
            self.trainer.load_checkpoint(ck)
            self.state["loaded_ckpt_path"] = ck
        self._run_bg(work, busy_status="loading")

    def cmd_save(self):
        if self.trainer.model is None:
            print("[save] no model loaded")
            return
        self.trainer.save_checkpoint(
            self.trainer.epoch,
            self.trainer.loss_history[-1] if self.trainer.loss_history else float("nan"))

    def cmd_unload(self):
        if self.is_busy():
            print("[unload] training in progress -- stop it first")
            return
        if self.trainer.model is None:
            print("[unload] no model loaded")
            return
        self.trainer._free_model()
        self.state["loaded_ckpt_path"] = ""
        print("[unload] model unloaded; VRAM/RAM released")

    def cmd_membase(self):
        self.monitor.capture_zero_state()
        self.monitor.begin_reporting()
        print("[mem] baseline reset")

    def cmd_mem(self):
        print(self.monitor.stats_string())
        try:
            report = format_vram_report(self.cfg, self.trainer.codec.vocab_size)
            print(report)
        except Exception as e:
            print(f"predicted VRAM: n/a ({e})")

    def cmd_chat(self):
        console_chat_loop(self.trainer, self.cfg, self.history)

    def cmd_generate(self):
        if self.trainer.model is None:
            print("[gen] no model loaded -- train or load a checkpoint first.")
            return
        try:
            prompt = input("prompt> ")
        except (EOFError, KeyboardInterrupt):
            print()
            return
        if not prompt.strip():
            return
        print(f"{self.cfg.assistant_name}> ", end="", flush=True)
        text = _run_generation_console(self.trainer, self.cfg, prompt)
        if text is not None:
            self.history.append({"role": "user", "text": prompt, "ts": time.time()})
            self.history.append({"role": "model", "text": text, "ts": time.time()})

    def cmd_continue(self):
        if self.trainer.model is None:
            print("[cont] no model loaded -- train or load a checkpoint first.")
            return
        if not self.history:
            print("[cont] no chat history yet -- use 'chat' or 'generate' first")
            return
        seed = _continue_seed(self.cfg, self.history)
        print(f"{self.cfg.assistant_name}> ", end="", flush=True)
        text = _run_generation_console(self.trainer, self.cfg, seed)
        if text is not None:
            self.history.append({"role": "model", "text": text, "ts": time.time()})

    def cmd_clear(self):
        self.history.clear()
        print("[chat] history cleared")

    def cmd_export(self):
        os.makedirs(self.cfg.checkpoint_dir, exist_ok=True)
        path = os.path.join(self.cfg.checkpoint_dir,
                            f"aura_chat_{time.strftime('%Y%m%d_%H%M%S')}.json")
        data = {
            "exported_at": time.strftime("%Y-%m-%d %H:%M:%S"),
            "assistant_name": ASSISTANT_NAME,
            "model_details": {
                "checkpoint_path": self.state["loaded_ckpt_path"] or "(none loaded)",
                "hyperparams": self.trainer._last_hparams_used or asdict(self.cfg),
                "vocab_size": self.trainer.codec.vocab_size,
                "encoding": self.trainer.codec.encoding_name,
                "epoch": self.trainer.epoch,
            },
            "messages": [
                {"role": t["role"], "text": t["text"],
                 "timestamp": time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(t["ts"])),
                 "timestamp_unix": t["ts"], "meta": ""}
                for t in self.history
            ],
        }
        try:
            with open(path, "w", encoding="utf-8") as f:
                json.dump(data, f, indent=2, ensure_ascii=False)
            print(f"[export] chat exported -> {path}")
        except Exception as e:
            print(f"[export] failed: {e}")

    def cmd_settings(self):
        while True:
            print(f"\n--- settings (live; file: {CONFIG_PATH}) ---")
            for group_name, keys in FIELD_GROUPS:
                print(f"  -- {group_name} --")
                for k in keys:
                    print(f"    {k:<26} = {str(getattr(self.cfg, k))!r:<22} "
                          f"{FIELD_LABELS.get(k, k)}")
            print("commands: set <key> <value>  |  save  |  back")
            try:
                line = input("settings> ").strip()
            except (EOFError, KeyboardInterrupt):
                print()
                return
            if not line or line == "back":
                return
            if line == "save":
                save_config(self.mgr, self.cfg)
                print(f"[settings] saved -> {CONFIG_PATH}")
                continue
            parts = line.split(None, 2)
            if len(parts) == 3 and parts[0] == "set":
                key, raw = parts[1], parts[2]
                if key == "device" or not hasattr(self.cfg, key):
                    print(f"[settings] unknown key '{key}'")
                    continue
                cur = getattr(self.cfg, key)
                try:
                    if isinstance(cur, bool):
                        v = raw.strip().lower() in ("1", "true", "yes", "on", "y")
                    elif isinstance(cur, int):
                        v = int(float(raw))
                    elif isinstance(cur, float):
                        v = float(raw)
                    else:
                        v = raw
                except ValueError:
                    print(f"[settings] cannot parse '{raw}' as {type(cur).__name__}")
                    continue
                setattr(self.cfg, key, v)
                self.cfg.validate()
                # live re-sync, same as the GUI's apply_field_values()
                if (self.cfg.encoding != self.trainer.codec.encoding_name
                        and not str(self.cfg.encoding).startswith("gguf")):
                    self.trainer.codec = TiktokenCodec(self.cfg.encoding)
                if self.cfg.meta_scratchpad_mode != self.trainer.scratchpad.mode:
                    self.trainer.scratchpad.set_mode(self.cfg.meta_scratchpad_mode)
                self.trainer.astralis.max_bytes = int(self.cfg.astralis_max_kb * 1024)
                print(f"[settings] {key} = {getattr(self.cfg, key)!r} (use 'save' to persist)")
            else:
                print("[settings] unknown command")

    def cmd_api(self):
        self.cfg.api_enabled = not self.cfg.api_enabled
        self.api_server.apply_settings()
        state = (f"ON http://{self.cfg.api_host}:{self.cfg.api_port}/v1"
                 if self.api_server.running else "OFF")
        print(f"[api] server {state}")

    def cmd_convert(self):
        if self.is_busy():
            print("[convert] busy -- stop the current run first")
            return
        try:
            gpath = input("GGUF path [model.gguf]> ").strip() or "model.gguf"
            opath = input("output .pt [aura_from_gguf.pth]> ").strip() or "aura_from_gguf.pth"
            dm = input(f"d_model [{self.cfg.d_model}]> ").strip()
            nl = input(f"n_layers [{self.cfg.n_layers}]> ").strip()
            nh = input(f"n_heads [{self.cfg.n_heads}]> ").strip()
            ks = input(f"kernel_size [{self.cfg.kernel_size}]> ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return
        if not os.path.exists(gpath):
            print(f"[convert] GGUF file not found: {gpath}")
            return
        try:
            conv_cfg = Config(
                d_model=int(float(dm)) if dm else self.cfg.d_model,
                n_layers=int(float(nl)) if nl else self.cfg.n_layers,
                n_heads=int(float(nh)) if nh else self.cfg.n_heads,
                kernel_size=int(float(ks)) if ks else self.cfg.kernel_size,
                seq_len=self.cfg.seq_len, encoding=self.cfg.encoding,
                dropout=self.cfg.dropout)
            conv_cfg.validate()
        except Exception as e:
            print(f"[convert] config error: {e}")
            return

        def work():
            convert_gguf_to_aura(gpath, opath, conv_cfg, log=self._log)
            self.trainer.load_checkpoint(opath)
            self.state["loaded_ckpt_path"] = opath
            self._log("[convert] converted model loaded")
        self._run_bg(work, busy_status="loading")

    # ---- main loop ----
    def dispatch(self, line: str):
        cmd = line.split()[0].lower()
        table = {
            "0": self.cmd_quit, "q": self.cmd_quit, "quit": self.cmd_quit, "exit": self.cmd_quit,
            "1": self.cmd_train, "train": self.cmd_train,
            "2": self.cmd_finetune, "finetune": self.cmd_finetune, "fine-tune": self.cmd_finetune,
            "3": self.cmd_pause, "pause": self.cmd_pause, "resume": self.cmd_pause,
            "4": self.cmd_stop, "stop": self.cmd_stop,
            "5": self.cmd_status, "status": self.cmd_status,
            "6": self.cmd_load, "load": self.cmd_load,
            "7": self.cmd_save, "save": self.cmd_save,
            "8": self.cmd_unload, "unload": self.cmd_unload,
            "9": self.cmd_membase, "membase": self.cmd_membase,
            "10": self.cmd_mem, "mem": self.cmd_mem,
            "11": self.cmd_chat, "chat": self.cmd_chat,
            "12": self.cmd_generate, "gen": self.cmd_generate, "generate": self.cmd_generate,
            "13": self.cmd_continue, "cont": self.cmd_continue,
            "14": self.cmd_clear, "clear": self.cmd_clear,
            "15": self.cmd_export, "export": self.cmd_export,
            "16": self.cmd_settings, "settings": self.cmd_settings,
            "17": self.cmd_api, "api": self.cmd_api,
            "18": self.cmd_convert, "convert": self.cmd_convert,
            "19": self.cmd_help, "help": self.cmd_help, "h": self.cmd_help, "?": self.cmd_help,
        }
        fn = table.get(cmd)
        if fn is None:
            print(f"unknown command '{cmd}' -- type 'help' for the menu")
            return
        fn()

    def run(self) -> int:
        print(CONSOLE_MENU)
        while self.running:
            try:
                line = input("aura> ").strip()
            except (EOFError, KeyboardInterrupt):
                print()
                break
            if not line:
                continue
            try:
                self.dispatch(line)
            except (EOFError, KeyboardInterrupt):
                print()
                continue
        self._shutdown()
        return 0

    def _shutdown(self):
        if self.is_busy():
            self._log("[quit] stopping training ...")
            self.trainer.stop()
            if self.train_thread is not None:
                self.train_thread.join(timeout=3.0)
        self.api_server.stop()
        self.trainer.scratchpad.shutdown(wait=False)
        self.monitor._stop = True
        try:
            save_config(self.mgr, self.cfg)
        except Exception:
            pass
        print("bye.")


def console_menu_main(cfg: Config, mgr: SettingsManager, args=None) -> int:
    app = ConsoleApp(cfg, mgr)
    # mirror the pygame GUI: auto-load the newest checkpoint at boot
    ck = find_latest_checkpoint(cfg.checkpoint_dir)
    if ck:
        try:
            app.monitor.begin_reporting()
            app.trainer.load_checkpoint(ck)
            app.state["loaded_ckpt_path"] = ck
            GLOBAL_LOGGER.log(f"auto-loaded {ck}")
            if args is not None:
                # explicit CLI flags win over the checkpoint's stamped config
                apply_cli_overrides(args, cfg)
        except Exception as e:
            GLOBAL_LOGGER.log(f"checkpoint load failed: {e}")
    return app.run()


def _help_examples(cfg: Config) -> str:
    return f"""\
examples (defaults read live from {CONFIG_PATH}):
  python zera.astralis
      Launch the pygame GUI (default when no options are given).
  python zera.astralis --console
      Launch the interactive console GUI -- a menu covering training,
      fine-tuning, checkpoints, chat, generation, GGUF conversion,
      settings, memory stats and the API server.
  python zera.astralis --train --epochs {cfg.epochs} --batch-size {cfg.batch_size} --seq-len {cfg.seq_len} --learning-rate {cfg.learning_rate} --train-dtype {cfg.train_dtype} --training-file {cfg.training_file}
      Train from scratch; checkpoints go to '{cfg.checkpoint_dir}'.
  python zera.astralis --finetune --continue-file {cfg.continue_file} --continue-epochs {cfg.continue_epochs}
      Fine-tune the newest checkpoint in '{cfg.checkpoint_dir}' on more data.
  python zera.astralis --generate "Proof 4/17 =" --gen-steps {cfg.gen_steps} --temperature {cfg.temperature} --top-k {cfg.top_k}
      Generate once (auto-loads the newest checkpoint).
  python zera.astralis --chat
      Chat in the terminal as '{cfg.assistant_name}' (auto-loads the newest checkpoint).
  python zera.astralis --load-checkpoint {cfg.checkpoint_dir}/model_final.pt --generate "Hello"
      Load a specific checkpoint, then generate.
  python zera.astralis --convert-gguf model.gguf --convert-out aura_from_gguf.pth --d-model {cfg.d_model} --n-layers {cfg.n_layers} --n-heads {cfg.n_heads} --kernel-size {cfg.kernel_size}
      Transplant a GGUF model into an Aura checkpoint and load it.
  python zera.astralis --api --api-host {cfg.api_host} --api-port {cfg.api_port}
      Serve the OpenAI-compatible API (Ctrl+C to stop).
  python zera.astralis --console --learning-rate 0.001 --epochs 5
      Every settings.json field has a matching --kebab-case override;
      overrides apply to GUI, console and headless modes alike.
"""


def build_arg_parser(cfg: Config) -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="python zera.astralis",
        description="AURA :: ASTRALIS v12 -- Hyena stateful LM engine. Launches the "
                    "pygame GUI by default; use --console for the interactive console "
                    "GUI, or action flags for headless operation.",
        epilog=_help_examples(cfg),
        formatter_class=argparse.RawDescriptionHelpFormatter)
    mode = p.add_argument_group("mode (default: pygame GUI)")
    mode.add_argument("--console", action="store_true",
                      help="start the interactive console GUI (menu with every feature); "
                           "combined with action flags, the actions run first, then the menu opens")
    mode.add_argument("--gui", action="store_true",
                      help="force the pygame GUI (default when no options are given)")
    act = p.add_argument_group(
        "actions (headless; executed in this order: convert -> load -> train -> "
        "finetune -> api -> generate -> chat)")
    act.add_argument("--train", action="store_true",
                     help=f"train from scratch on '{cfg.training_file}'")
    act.add_argument("--finetune", action="store_true",
                     help=f"continue training the loaded checkpoint on '{cfg.continue_file}' "
                          f"for {cfg.continue_epochs} epochs")
    act.add_argument("--load-checkpoint", nargs="?", const="latest", default=None,
                     metavar="PATH",
                     help=f"load a checkpoint (.pt); omit PATH for the newest in "
                          f"'{cfg.checkpoint_dir}'")
    act.add_argument("--no-autoload", action="store_true",
                     help="do not auto-load the newest checkpoint")
    act.add_argument("--generate", metavar="PROMPT",
                     help="generate text once from PROMPT and print it")
    act.add_argument("--chat", action="store_true",
                     help="interactive terminal chat (auto-loads the newest checkpoint)")
    act.add_argument("--convert-gguf", metavar="GGUF_PATH",
                     help="transplant a GGUF model into an Aura checkpoint, then load it")
    act.add_argument("--convert-out", metavar="PATH", default="aura_from_gguf.pth",
                     help="output path for --convert-gguf (default: aura_from_gguf.pth)")
    act.add_argument("--api", action="store_true",
                     help=f"serve the OpenAI-compatible API on {cfg.api_host}:{cfg.api_port} "
                          f"(Ctrl+C to stop)")
    st = p.add_argument_group(f"settings overrides (defaults from {CONFIG_PATH})")
    for name in Config.__dataclass_fields__:
        if name == "device":
            continue
        cur = getattr(cfg, name)
        opt = "--" + name.replace("_", "-")
        label = FIELD_LABELS.get(name, name)
        if isinstance(cur, bool):
            st.add_argument(opt, dest=name, action=argparse.BooleanOptionalAction,
                            default=None, help=f"{label} (default: {cur})")
        elif isinstance(cur, int):
            st.add_argument(opt, dest=name, type=int, default=None, metavar="N",
                            help=f"{label} (default: {cur})")
        elif isinstance(cur, float):
            st.add_argument(opt, dest=name, type=float, default=None, metavar="F",
                            help=f"{label} (default: {cur})")
        else:
            st.add_argument(opt, dest=name, type=str, default=None, metavar="S",
                            help=f"{label} (default: {cur!r})")
    return p


def apply_cli_overrides(args, cfg: Config):
    for name in Config.__dataclass_fields__:
        if name == "device":
            continue
        v = getattr(args, name, None)
        if v is not None:
            setattr(cfg, name, v)
    cfg.validate()


def console_headless_main(args, cfg: Config, mgr: SettingsManager) -> int:
    """Run the requested action flags without any UI, in the documented order."""
    monitor = ResourceMonitor()
    monitor.start()
    monitor.capture_zero_state()
    prog = {"t": 0.0}

    def log_fn(msg):
        GLOBAL_LOGGER.log(msg)

    def progress_fn(epoch, epochs, batch, n_batches, loss,
                    eta_sec=None, sec_per_batch=None, hparams=None):
        now = time.time()
        if batch >= n_batches or now - prog["t"] >= 1.0:
            prog["t"] = now
            print(f"[train] epoch {epoch}/{epochs} batch {batch}/{n_batches} "
                  f"loss {loss:.4f} ETA {format_eta_human(eta_sec)}", flush=True)

    trainer = Trainer(cfg, log_fn=log_fn, progress_fn=progress_fn)
    api_server = OpenAIAPIServer(trainer, cfg)
    history: List[dict] = []
    rc = 0
    try:
        if args.convert_gguf:
            if not os.path.exists(args.convert_gguf):
                log_fn(f"[convert] GGUF file not found: {args.convert_gguf}")
                return 2
            conv_cfg = Config(d_model=cfg.d_model, n_layers=cfg.n_layers,
                              n_heads=cfg.n_heads, kernel_size=cfg.kernel_size,
                              seq_len=cfg.seq_len, encoding=cfg.encoding,
                              dropout=cfg.dropout)
            conv_cfg.validate()
            convert_gguf_to_aura(args.convert_gguf, args.convert_out, conv_cfg, log=log_fn)
            monitor.begin_reporting()
            trainer.load_checkpoint(args.convert_out)

        ck = None
        if args.load_checkpoint:
            ck = (find_latest_checkpoint(cfg.checkpoint_dir)
                  if args.load_checkpoint == "latest" else args.load_checkpoint)
            if ck is None:
                log_fn(f"[load] no checkpoint found in '{cfg.checkpoint_dir}'")
        elif not args.train and not args.no_autoload and not args.convert_gguf:
            ck = find_latest_checkpoint(cfg.checkpoint_dir)   # same auto-load as the GUI
        if ck:
            monitor.begin_reporting()
            trainer.load_checkpoint(ck)
            # the checkpoint's stamped config must not clobber explicit CLI flags
            apply_cli_overrides(args, cfg)

        if args.train:
            monitor.begin_reporting()
            trainer.train(cfg.training_file)

        if args.finetune:
            monitor.begin_reporting()
            trainer.continue_training(cfg.continue_file, cfg.continue_epochs)

        if args.api:
            cfg.api_enabled = True
            api_server.apply_settings()

        if args.generate is not None:
            if trainer.model is None:
                log_fn("[generate] no model loaded -- train or load a checkpoint first")
                return 3
            print(f"--- generation (steps={cfg.gen_steps}, temp={cfg.temperature}, "
                  f"top_k={cfg.top_k}) ---")
            text = _run_generation_console(trainer, cfg, args.generate)
            if text is None:
                return 1

        if args.chat:
            console_chat_loop(trainer, cfg, history)

        if args.api and not args.chat:
            log_fn("[api] serving -- Ctrl+C to stop")
            while True:
                time.sleep(0.5)
    except KeyboardInterrupt:
        trainer.stop()
        try:
            trainer.save_checkpoint(
                trainer.epoch,
                trainer.loss_history[-1] if trainer.loss_history else float("nan"))
        except Exception:
            pass
        log_fn("[cli] interrupted by user (checkpoint save attempted)")
        rc = 130
    except Exception as e:
        log_fn(f"[cli] error: {e}")
        traceback.print_exc()
        rc = 1
    finally:
        api_server.stop()
        trainer.scratchpad.shutdown(wait=False)
        monitor._stop = True
    return rc


def main(argv=None) -> int:
    mgr = SettingsManager(CONFIG_PATH)
    cfg = load_or_create_config(mgr)
    cfg.validate()
    parser = build_arg_parser(cfg)
    args = parser.parse_args(argv)
    apply_cli_overrides(args, cfg)
    has_actions = any((
        args.train, args.finetune, args.generate is not None, args.chat,
        bool(args.convert_gguf), args.api, bool(args.load_checkpoint),
    ))
    if args.gui or (not args.console and not has_actions):
        gui_main()          # default: GUI when no --console / action options are given
        return 0
    rc = 0
    if has_actions:
        rc = console_headless_main(args, cfg, mgr)
    if args.console:        # after any requested actions, open the interactive menu
        rc = console_menu_main(cfg, mgr, args) or rc
    return rc


if __name__ == "__main__":
    try:
        sys.exit(main())
    except ImportError as e:
        print(f"[FATAL] missing dependency: {e}")
        sys.exit(1)
